---
import Base from '../layouts/Base.astro';
import LegendKey from '../components/LegendKey.astro';
import { PARAM_SEED, fieldState } from '../lib/master';
import { url } from '../lib/config';

// Server-renders the TOOL_SPECS §0 defaults so the page is meaningful without
// JS or before the DB exists; the client island below upgrades each row to the
// live Supabase value (and shows frozen / confidence). The editable write-back
// UI is step 2 — this step proves the read side of the shared-state loop.
const stateClass = {
  input: 'field-input',
  linked: 'field-linked',
  computed: 'field-computed',
} as const;
---
<Base title="Vehicle Spec">
  <p class="annot annot-tick">Cross-cutting · the Master store</p>
  <h1 style="margin-top:0.4rem;">Vehicle Spec</h1>
  <p style="color:var(--ink-2);margin-top:0.5rem;max-width:70ch;">
    The one live set of car parameters. Enter a number once here and every tool
    reads it — the golden rule: no private copies of a shared number. Mass, mass
    fraction, CoG and axle loads flow from the MassBudget.
  </p>

  <div class="notice" style="margin:1.25rem 0;" data-source-note>
    Showing <strong>workbook defaults</strong> (TOOL_SPECS §0). Sign in and run
    the schema to see the live shared values. Editing is added in the next step.
  </div>

  <LegendKey />

  <div style="overflow-x:auto;margin-top:1.25rem;">
    <table style="width:100%;border-collapse:collapse;font-size:var(--fs-300);min-width:640px;">
      <thead>
        <tr style="text-align:left;border-bottom:1px solid var(--rule-strong);">
          <th style="padding:0.6rem 0.75rem;" class="annot">Parameter</th>
          <th style="padding:0.6rem 0.75rem;" class="annot">Sym</th>
          <th style="padding:0.6rem 0.75rem;text-align:right;" class="annot">Value</th>
          <th style="padding:0.6rem 0.75rem;" class="annot">Unit</th>
          <th style="padding:0.6rem 0.75rem;" class="annot">Source</th>
          <th style="padding:0.6rem 0.75rem;" class="annot">State</th>
        </tr>
      </thead>
      <tbody>
        {PARAM_SEED.map((p) => {
          const state = fieldState(p.source);
          return (
            <tr data-key={p.key} style="border-bottom:1px solid var(--rule);">
              <td style="padding:0.55rem 0.75rem;">{p.label}</td>
              <td style="padding:0.55rem 0.75rem;" class="mono">{p.symbol}</td>
              <td style="padding:0.55rem 0.75rem;text-align:right;" class="mono">
                <span class={`field ${stateClass[state]}`} data-value>{p.value}</span>
              </td>
              <td style="padding:0.55rem 0.75rem;" class="mono">{p.unit}</td>
              <td style="padding:0.55rem 0.75rem;color:var(--ink-3);" class="mono">{p.source}</td>
              <td style="padding:0.55rem 0.75rem;">
                <span data-badges><span class="badge badge-est">Est</span></span>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <p class="mono" style="margin-top:1.5rem;font-size:var(--fs-200);color:var(--ink-3);">
    The original Excel Master stays the authoritative archive (BRIEF §C) —
    <a href={url('')}>home</a> ·
    <a href="https://github.com/auhin-hub/blitz-technical-house" target="_blank" rel="noopener">repo</a>.
  </p>
</Base>

<script>
  import { supabase } from '../lib/supabase';

  const note = document.querySelector('[data-source-note]') as HTMLElement | null;

  function fmt(v: number | null): string {
    if (v === null || v === undefined) return '—';
    // Trim trailing zeros but keep the workbook's precision where it matters.
    return Number.isInteger(v) ? String(v) : String(parseFloat(v.toFixed(4)));
  }

  (async () => {
    const { data, error } = await supabase
      .from('vehicle_spec')
      .select('key,value,confidence,frozen,frozen_gate')
      .order('display_order', { ascending: true });

    if (error || !data || data.length === 0) return; // keep the seed view + note

    for (const row of data) {
      const tr = document.querySelector(`tr[data-key="${row.key}"]`);
      if (!tr) continue;
      const valEl = tr.querySelector('[data-value]');
      if (valEl) valEl.textContent = fmt(row.value);

      const badges = tr.querySelector('[data-badges]');
      if (badges) {
        const conf = row.confidence === 'Live'
          ? '<span class="badge badge-live">Live</span>'
          : '<span class="badge badge-est">Est</span>';
        const frozen = row.frozen
          ? ` <span class="badge badge-frozen">Frozen${row.frozen_gate ? ' · ' + row.frozen_gate : ''}</span>`
          : '';
        badges.innerHTML = conf + frozen;
      }
    }

    if (note) {
      note.innerHTML = 'Showing <strong>live shared values</strong> from the Master store.';
    }
  })();
</script>
