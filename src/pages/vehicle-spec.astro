---
import Base from '../layouts/Base.astro';
import LegendKey from '../components/LegendKey.astro';
import WorkbookDownload from '../components/WorkbookDownload.astro';
import { PARAM_SEED, fieldState } from '../lib/master';
import { url } from '../lib/config';

const stateClass = { input: 'field-input', linked: 'field-linked', computed: 'field-computed' } as const;
const rows = PARAM_SEED.map((p) => ({ ...p, state: fieldState(p) }));
const GATES = ['G0', 'G1', 'G2', 'G3', 'G4', 'G5', 'G6', 'G7', 'G8', 'G9'];
const td = 'padding:0.45rem 0.7rem;';

// First-pass sourcing hints (handoff P1.3): where the number comes from, not a value.
const SOURCING: Record<string, string> = {
  wheelbase: 'Packaging + rules (wheelbase ≥ 1525 mm; smaller track ≥ 75% of the larger) + last year\'s car.',
  track_front: 'Packaging + the load-transfer/turning trade; keep smaller track ≥ 75% of the larger (rule).',
  track_rear: 'Packaging + the load-transfer/turning trade; keep smaller track ≥ 75% of the larger (rule).',
  ride_height: 'Suspension travel + ground clearance + aero; start from last car.',
  unsprung_corner: 'Sum the corner\'s parts (upright, hub, wheel, tyre, brake, arms share) from CAD / last car.',
  tlltd_front: 'A target you pick (~0.5); the achieved value comes from springs + ARBs later (Balance / Load transfer).',
  motion_ratio: 'From the linkage geometry: damper travel ÷ wheel travel (or the rocker ratio).',
  mu_lat_peak: 'From the Tyre tool (TTC fit). Belt rig ≠ track — derate for real grip.',
  corner_stiffness: 'From the Tyre tool (TTC fit) — cornering stiffness Cα per tyre.',
  slip_peak: 'From the Tyre tool (TTC fit) — slip angle at peak lateral force.',
  rolling_radius: 'From the Tyre tool / tyre data — loaded rolling radius.',
  tyre_vert_stiffness: 'From the Tyre tool / tyre data — vertical stiffness (verify, pressure-dependent).',
  mass_total: 'Computed by MassBudget (sum of components).',
  mass_frac_front: 'Computed by MassBudget (weight distribution).',
  cog_height: 'Computed by MassBudget; verify on the car with the CoG tilt test.',
  yaw_inertia: 'Computed by MassBudget (point-mass + local Izz); verify with the trifilar pendulum.',
  accel_lat_target: 'A performance target you set (from last year + ambition); defend it in the design event.',
  accel_brake_target: 'A performance target you set; drives brake sizing.',
  roll_grad_target: 'A target you set (handbook 1.0–1.5 deg/g); springs + ARBs deliver it.',
  ride_freq_front: 'A target you set (handbook 2.3–2.9 Hz); springs deliver it with the tyre in series.',
  ride_freq_rear: 'A target you set, usually a touch above the front for flat ride.',
};
---
<Base title="Vehicle Spec">
  <p class="annot annot-tick">Cross-cutting · the Master store</p>
  <h1 style="margin-top:0.4rem;">Vehicle Spec</h1>
  <p style="color:var(--ink-2);margin-top:0.5rem;max-width:72ch;">
    The one live set of car parameters. It <strong>ships blank</strong> — fill in
    the new car and every tool reads it. Edits save for the whole team. Weight,
    average track and axle loads are computed from the others; mass, front
    fraction, CoG and yaw inertia come from MassBudget. Freeze a parameter at a
    gate to lock it — a later change needs a reason and is recorded in the
    <a href={url('change-log')}>Change Log</a>. The <em>typical</em> column is a
    rough FS reference, not a target.
  </p>

  <div class="notice" style="margin:1.25rem 0;" data-source-note>
    Showing the <strong>blank parameter set</strong>. Sign in to load and edit the
    live shared values.
  </div>

  <div style="display:flex;gap:0.75rem;flex-wrap:wrap;align-items:center;justify-content:space-between;">
    <LegendKey />
    <WorkbookDownload file="MIST_Blitz_FS_Master_Workbook.xlsx" label="Download master workbook (.xlsx)" />
  </div>
  <p class="mono" style="margin-top:0.6rem;font-size:var(--fs-200);color:var(--ink-3);display:flex;gap:1rem;flex-wrap:wrap;align-items:center;">
    <label style="display:inline-flex;gap:0.4rem;align-items:center;">Freeze at
      <select id="freeze-gate" style="font-family:var(--font-mono);background:var(--surface-2);border:1px solid var(--rule-strong);border-radius:var(--radius);color:var(--ink);padding:0.2rem 0.4rem;">
        {GATES.map((g) => <option value={g} selected={g === 'G3'}>{g}</option>)}
      </select>
    </label>
    <span data-save-status></span>
  </p>

  <!-- Baseline presets (handoff P1.3): save/load a full-Master set so a new
       designer starts from last year, not blank. Team-shared. -->
  <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;margin-top:0.25rem;font-size:var(--fs-300);" data-baseline hidden>
    <span class="annot">Baseline</span>
    <select id="vs-preset" aria-label="Baseline preset" style="font-family:var(--font-mono);font-size:var(--fs-200);background:var(--surface-2);border:1px solid var(--rule-strong);border-radius:var(--radius);color:var(--ink);padding:0.2rem 0.35rem;">
      <option value="">— preset —</option>
    </select>
    <button class="btn btn-ghost" type="button" id="vs-preset-load" style="font-size:var(--fs-200);">Load into Master</button>
    <button class="btn btn-ghost" type="button" id="vs-preset-save" style="font-size:var(--fs-200);">Save current as…</button>
    <button class="btn btn-ghost" type="button" id="vs-preset-del" style="font-size:var(--fs-200);">Delete</button>
    <span class="mono" id="vs-preset-status" style="font-size:var(--fs-200);color:var(--ink-3);"></span>
  </div>

  <div style="overflow-x:auto;margin-top:1rem;">
    <table style="width:100%;border-collapse:collapse;font-size:var(--fs-300);min-width:760px;">
      <thead>
        <tr style="text-align:left;border-bottom:1px solid var(--rule-strong);">
          <th style={td} class="annot">Parameter</th>
          <th style={td} class="annot">Sym</th>
          <th style={td + 'text-align:right;min-width:110px;'} class="annot">Value</th>
          <th style={td} class="annot">Unit</th>
          <th style={td} class="annot">Typical</th>
          <th style={td} class="annot">Source</th>
          <th style={td} class="annot">State</th>
          <th style={td} class="annot">Freeze</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((p) => (
          <tr data-key={p.key} data-state={p.state} style="border-bottom:1px solid var(--rule);">
            <td style={td}>{p.label}{SOURCING[p.key] && (
              <span class="mono" title={SOURCING[p.key]} aria-label={`Where ${p.label} comes from: ${SOURCING[p.key]}`}
                style="margin-left:0.35rem;color:var(--sky);cursor:help;border:1px solid var(--rule-strong);border-radius:50%;padding:0 0.32rem;font-size:var(--fs-200);">i</span>
            )}</td>
            <td style={td} class="mono">{p.symbol}</td>
            <td style={td + 'text-align:right;'} class="mono">
              {p.state === 'computed' ? (
                <span class={`field ${stateClass[p.state]}`} data-value>—</span>
              ) : p.type === 'text' ? (
                <input type="text" data-input-text placeholder={p.ref?.typ ?? 'choose…'}
                  class={`field ${stateClass[p.state]}`} aria-label={p.label}
                  style="width:160px;font-family:var(--font-mono);" />
              ) : (
                <input type="number" step="any" data-input value={p.value ?? ''} placeholder={p.ref?.typ ?? ''}
                  class={`field ${stateClass[p.state]}`} aria-label={p.label}
                  style="width:104px;text-align:right;font-family:var(--font-mono);" />
              )}
            </td>
            <td style={td} class="mono">{p.unit}</td>
            <td style={td}>{p.ref && <span class="ct-ref" title={p.ref.src ?? ''}>{p.ref.typ}</span>}</td>
            <td style={td + 'color:var(--ink-3);'} class="mono">{p.source}</td>
            <td style={td}><span data-badges><span class="badge badge-est">Est</span></span></td>
            <td style={td}>
              {p.state !== 'computed' && (
                <input type="checkbox" data-freeze aria-label={`Freeze ${p.label}`} style="width:16px;height:16px;accent-color:var(--sky);" />
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="mono" style="margin-top:1.5rem;font-size:var(--fs-200);color:var(--ink-3);">
    The original Excel Master stays the authoritative archive. Typical-value
    sources: Team Blitz VD Handbook · common FSAE ranges (orientation only).
  </p>
</Base>

<script>
  import { loadMaster, setMasterValue, setFrozen, editFrozenParam, setMasterText, editFrozenText, fmt, debounce, loadPresets, saveNamedPreset, deletePreset } from '../lib/store';
  import { COUPLING_BY_KEY } from '../lib/config';

  const G = 9.81;
  const note = document.querySelector('[data-source-note]') as HTMLElement | null;
  const status = document.querySelector('[data-save-status]') as HTMLElement | null;
  const gateSel = document.getElementById('freeze-gate') as HTMLSelectElement;
  const frozenState: Record<string, boolean> = {};

  function setStatus(text: string, color = 'var(--ink-3)') { if (status) { status.textContent = text; status.style.color = color; } }
  const cell = (key: string) => document.querySelector(`tr[data-key="${key}"]`);
  function setComputed(key: string, v: number | null) {
    const el = cell(key)?.querySelector('[data-value]');
    if (el) el.textContent = v === null || !Number.isFinite(v) ? '—' : fmt(v);
  }
  function inputVal(key: string): number {
    const el = cell(key)?.querySelector('[data-input]') as HTMLInputElement | null;
    return el && el.value.trim() !== '' ? Number(el.value) : NaN;
  }

  function renderBadges(tr: Element, frozen: boolean, gate: string | null, conf: string) {
    const badges = tr.querySelector('[data-badges]');
    if (!badges) return;
    const c = conf === 'Live' ? '<span class="badge badge-live">Live</span>' : '<span class="badge badge-est">Est</span>';
    const f = frozen ? ` <span class="badge badge-frozen">Frozen${gate ? ' · ' + gate : ''}</span>` : '';
    badges.innerHTML = c + f;
  }

  // weight = m·g · avg_track = (tf+tr)/2 · axle_load_front = W·ff · rear = W·(1−ff)
  async function recomputeDerived() {
    const m = inputVal('mass_total'), ff = inputVal('mass_frac_front');
    const tf = inputVal('track_front'), tr = inputVal('track_rear');
    const updates: [string, number][] = [];
    if (Number.isFinite(tf) && Number.isFinite(tr)) { const v = (tf + tr) / 2; setComputed('avg_track', v); updates.push(['avg_track', v]); }
    let W = NaN;
    if (Number.isFinite(m)) { W = m * G; setComputed('weight', W); updates.push(['weight', W]); }
    if (Number.isFinite(W) && Number.isFinite(ff)) {
      const af = W * ff, ar = W * (1 - ff);
      setComputed('axle_load_front', af); setComputed('axle_load_rear', ar);
      updates.push(['axle_load_front', af], ['axle_load_rear', ar]);
    }
    await Promise.all(updates.map(([k, v]) => setMasterValue(k, v)));
  }

  (async () => {
    const master = await loadMaster();
    if (Object.keys(master).length === 0) return;

    for (const key of Object.keys(master)) {
      const row = master[key]; const tr = cell(key); if (!tr) continue;
      frozenState[key] = row.frozen;
      const input = tr.querySelector('[data-input]') as HTMLInputElement | null;
      const textInput = tr.querySelector('[data-input-text]') as HTMLInputElement | null;
      if (textInput) textInput.value = (row as any).text_value ?? '';
      else if (input) input.value = row.value === null || row.value === undefined ? '' : String(row.value);
      else setComputed(key, row.value as number | null);
      const fz = tr.querySelector('[data-freeze]') as HTMLInputElement | null;
      if (fz) fz.checked = row.frozen;
      renderBadges(tr, row.frozen, row.frozen_gate, row.confidence);
    }
    if (note) note.innerHTML = 'Showing <strong>live shared values</strong> from the Master store. Edits save for the whole team.';

    // ---- Baseline presets (P1.3) ----
    const PRESET_TOOL = 'vehicle_spec_master';
    const bar = document.querySelector('[data-baseline]') as HTMLElement | null;
    const presetSel = document.getElementById('vs-preset') as HTMLSelectElement;
    const presetStatus = document.getElementById('vs-preset-status')!;
    const pSay = (m: string, ok = true) => { presetStatus.textContent = m; presetStatus.style.color = ok ? 'var(--state-linked)' : 'var(--heritage)'; };
    if (bar) bar.hidden = false;
    async function refreshPresetList() {
      const presets = await loadPresets(PRESET_TOOL);
      const names = Object.keys(presets).sort();
      presetSel.innerHTML = '<option value="">— preset —</option>' + names.map((n) => `<option value="${n.replace(/"/g, '&quot;')}">${n}</option>`).join('');
    }
    const editableKeys = () => Array.from(document.querySelectorAll('[data-input]')).map((el) => (el as HTMLInputElement).closest('tr')?.getAttribute('data-key')).filter(Boolean) as string[];
    document.getElementById('vs-preset-save')!.addEventListener('click', async () => {
      const name = prompt('Baseline name (saved for the whole team, e.g. "2024 car"):')?.trim();
      if (!name) return;
      const values: Record<string, number> = {};
      for (const k of editableKeys()) { const v = inputVal(k); if (Number.isFinite(v)) values[k] = v; }
      pSay('Saving…', true);
      const err = await saveNamedPreset(PRESET_TOOL, name, { values });
      if (err) return pSay('Save failed: ' + err, false);
      await refreshPresetList(); presetSel.value = name; pSay('saved ✓');
    });
    document.getElementById('vs-preset-load')!.addEventListener('click', async () => {
      const name = presetSel.value; if (!name) return pSay('Pick a preset first.', false);
      const presets = await loadPresets<{ values: Record<string, number> }>(PRESET_TOOL);
      const values = presets[name]?.values; if (!values) return pSay('Preset not found.', false);
      pSay('Loading…', true);
      const errs: string[] = [];
      for (const [k, v] of Object.entries(values)) {
        if (frozenState[k]) { errs.push(`${k} frozen`); continue; }
        const e = await setMasterValue(k, v); if (e) errs.push(`${k}: ${e}`);
      }
      pSay(errs.length ? 'Loaded with skips: ' + errs.join('; ') : 'Loaded ✓', !errs.length);
      setTimeout(() => window.location.reload(), 700);
    });
    document.getElementById('vs-preset-del')!.addEventListener('click', async () => {
      const name = presetSel.value; if (!name) return pSay('Pick a preset first.', false);
      if (!confirm(`Delete baseline "${name}" for everyone?`)) return;
      const err = await deletePreset(PRESET_TOOL, name);
      if (err) return pSay('Delete failed: ' + err, false);
      await refreshPresetList(); pSay('deleted ✓');
    });
    refreshPresetList();

    const saveNormal = debounce(async (key: string, value: number) => {
      setStatus('Saving…');
      const err = await setMasterValue(key, value);
      if (err) return setStatus('Save failed: ' + err, 'var(--heritage)');
      await recomputeDerived();
      setStatus('Saved ✓', 'var(--state-linked)');
    }, 500);

    async function saveFrozen(key: string, value: number) {
      // Coupling prompt (handbook §H): surface the knock-ons before logging.
      const knock = COUPLING_BY_KEY[key];
      const msg = `"${key}" is frozen.` +
        (knock ? `\n\nThis also affects: ${knock}\n\nVerify those, then` : '\n\n') +
        ` enter a reason for this change (recorded in the Change Log):`;
      const reason = window.prompt(msg);
      if (reason === null || reason.trim() === '') { setStatus('Frozen edit cancelled — a reason is required.', 'var(--heritage)'); return false; }
      setStatus('Saving…');
      const err = await editFrozenParam(key, value, reason.trim());
      if (err) { setStatus('Save failed: ' + err, 'var(--heritage)'); return false; }
      await recomputeDerived();
      setStatus('Saved & logged ✓', 'var(--state-linked)');
      return true;
    }

    document.querySelectorAll('[data-input]').forEach((el) => {
      const input = el as HTMLInputElement;
      const key = input.closest('tr')?.getAttribute('data-key'); if (!key) return;
      if (frozenState[key]) {
        input.addEventListener('change', async () => {
          const v = Number(input.value);
          if (input.value.trim() === '' || !Number.isFinite(v)) return;
          const ok = await saveFrozen(key, v);
          if (!ok) { const m = await loadMaster(); if (m[key]) input.value = m[key].value === null ? '' : String(m[key].value); }
        });
      } else {
        input.addEventListener('input', () => {
          if (input.value.trim() === '') { setStatus('Cleared — enter a number to save.', 'var(--ink-3)'); return; }
          const v = Number(input.value);
          if (!Number.isFinite(v)) return setStatus('Enter a number', 'var(--heritage)');
          saveNormal(key, v);
        });
      }
    });

    // Text "selected" keys (0008): same freeze mechanic, via text paths.
    const saveNormalText = debounce(async (key: string, text: string) => {
      setStatus('Saving…');
      const err = await setMasterText(key, text);
      setStatus(err ? 'Save failed: ' + err : 'Saved ✓', err ? 'var(--heritage)' : 'var(--state-linked)');
    }, 500);
    async function saveFrozenText(key: string, text: string) {
      const knock = COUPLING_BY_KEY[key];
      const msg = `"${key}" is frozen.` + (knock ? `\n\nThis also affects: ${knock}\n\n` : '\n\n') + 'enter a reason for this change (recorded in the Change Log):';
      const reason = window.prompt(msg);
      if (reason === null || reason.trim() === '') { setStatus('Frozen edit cancelled — a reason is required.', 'var(--heritage)'); return false; }
      setStatus('Saving…');
      const err = await editFrozenText(key, text.trim(), reason.trim());
      if (err) { setStatus('Save failed: ' + err, 'var(--heritage)'); return false; }
      setStatus('Saved & logged ✓', 'var(--state-linked)');
      return true;
    }
    document.querySelectorAll('[data-input-text]').forEach((el) => {
      const input = el as HTMLInputElement;
      const key = input.closest('tr')?.getAttribute('data-key'); if (!key) return;
      if (frozenState[key]) {
        input.addEventListener('change', async () => {
          const ok = await saveFrozenText(key, input.value);
          if (!ok) { const m = await loadMaster(); if (m[key]) input.value = (m[key] as any).text_value ?? ''; }
        });
      } else {
        input.addEventListener('input', () => saveNormalText(key, input.value));
      }
    });

    document.querySelectorAll('[data-freeze]').forEach((el) => {
      const box = el as HTMLInputElement;
      const tr = box.closest('tr')!; const key = tr.getAttribute('data-key')!;
      box.addEventListener('change', async () => {
        const gate = box.checked ? gateSel.value : null;
        setStatus('Saving…');
        const err = await setFrozen(key, box.checked, gate);
        if (err) { setStatus('Freeze failed: ' + err, 'var(--heritage)'); box.checked = !box.checked; return; }
        frozenState[key] = box.checked;
        const conf = tr.querySelector('.badge-live') ? 'Live' : 'Est';
        renderBadges(tr, box.checked, gate, conf);
        setStatus(box.checked ? `Frozen at ${gate} ✓` : 'Unfrozen ✓', 'var(--state-linked)');
        setTimeout(() => window.location.reload(), 600);
      });
    });
  })();
</script>
