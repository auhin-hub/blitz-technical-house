---
import Base from '../layouts/Base.astro';
import LegendKey from '../components/LegendKey.astro';
import WorkbookDownload from '../components/WorkbookDownload.astro';
import { PARAM_SEED, fieldState } from '../lib/master';

const stateClass = { input: 'field-input', linked: 'field-linked', computed: 'field-computed' } as const;
const rows = PARAM_SEED.map((p) => ({ ...p, state: fieldState(p.source) }));
const GATES = ['G0', 'G1', 'G2', 'G3', 'G4', 'G5', 'G6', 'G7', 'G8', 'G9'];
---
<Base title="Vehicle Spec">
  <p class="annot annot-tick">Cross-cutting · the Master store</p>
  <h1 style="margin-top:0.4rem;">Vehicle Spec</h1>
  <p style="color:var(--ink-2);margin-top:0.5rem;max-width:70ch;">
    The one live set of car parameters. Enter a number once here and every tool
    reads it. Edits save for the whole team; axle loads are computed from mass and
    mass fraction. Freeze a parameter at a gate to lock it — a later change then
    needs a reason and is recorded in the <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/change-log`}>Change Log</a>.
  </p>

  <div class="notice" style="margin:1.25rem 0;" data-source-note>
    Showing <strong>workbook defaults</strong> (TOOL_SPECS §0). Sign in to load
    and edit the live shared values.
  </div>

  <div style="display:flex;gap:0.75rem;flex-wrap:wrap;align-items:center;justify-content:space-between;">
    <LegendKey />
    <WorkbookDownload file="MIST_Blitz_FS_Master_Workbook.xlsx" label="Download master workbook (.xlsx)" />
  </div>
  <p class="mono" style="margin-top:0.6rem;font-size:var(--fs-200);color:var(--ink-3);display:flex;gap:1rem;flex-wrap:wrap;align-items:center;">
    <span>Green values will be computed by their sub-tool (MassBudget, Tyre) once built — editable here meanwhile.</span>
    <label style="display:inline-flex;gap:0.4rem;align-items:center;">Freeze at
      <select id="freeze-gate" style="font-family:var(--font-mono);background:var(--surface-2);border:1px solid var(--rule-strong);border-radius:var(--radius);color:var(--ink);padding:0.2rem 0.4rem;">
        {GATES.map((g) => <option value={g} selected={g === 'G3'}>{g}</option>)}
      </select>
    </label>
    <span data-save-status></span>
  </p>

  <div style="overflow-x:auto;margin-top:1rem;">
    <table style="width:100%;border-collapse:collapse;font-size:var(--fs-300);min-width:720px;">
      <thead>
        <tr style="text-align:left;border-bottom:1px solid var(--rule-strong);">
          <th style="padding:0.6rem 0.75rem;" class="annot">Parameter</th>
          <th style="padding:0.6rem 0.75rem;" class="annot">Sym</th>
          <th style="padding:0.6rem 0.75rem;text-align:right;min-width:120px;" class="annot">Value</th>
          <th style="padding:0.6rem 0.75rem;" class="annot">Unit</th>
          <th style="padding:0.6rem 0.75rem;" class="annot">Source</th>
          <th style="padding:0.6rem 0.75rem;" class="annot">State</th>
          <th style="padding:0.6rem 0.75rem;" class="annot">Freeze</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((p) => (
          <tr data-key={p.key} data-state={p.state} style="border-bottom:1px solid var(--rule);">
            <td style="padding:0.5rem 0.75rem;">{p.label}</td>
            <td style="padding:0.5rem 0.75rem;" class="mono">{p.symbol}</td>
            <td style="padding:0.5rem 0.75rem;text-align:right;" class="mono">
              {p.state === 'computed' ? (
                <span class={`field ${stateClass[p.state]}`} data-value>{p.value}</span>
              ) : (
                <input type="number" step="any" data-input value={p.value}
                  class={`field ${stateClass[p.state]}`} aria-label={p.label}
                  style="width:110px;text-align:right;font-family:var(--font-mono);" />
              )}
            </td>
            <td style="padding:0.5rem 0.75rem;" class="mono">{p.unit}</td>
            <td style="padding:0.5rem 0.75rem;color:var(--ink-3);" class="mono">{p.source}</td>
            <td style="padding:0.5rem 0.75rem;"><span data-badges><span class="badge badge-est">Est</span></span></td>
            <td style="padding:0.5rem 0.75rem;">
              {p.state !== 'computed' && (
                <input type="checkbox" data-freeze aria-label={`Freeze ${p.label}`} style="width:16px;height:16px;accent-color:var(--sky);" />
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="mono" style="margin-top:1.5rem;font-size:var(--fs-200);color:var(--ink-3);">
    The original Excel Master stays the authoritative archive (BRIEF §C).
  </p>
</Base>

<script>
  import { loadMaster, setMasterValue, setFrozen, editFrozenParam, fmt, debounce } from '../lib/store';

  const G = 9.81;
  const note = document.querySelector('[data-source-note]') as HTMLElement | null;
  const status = document.querySelector('[data-save-status]') as HTMLElement | null;
  const gateSel = document.getElementById('freeze-gate') as HTMLSelectElement;
  const frozenState: Record<string, boolean> = {};

  function setStatus(text: string, color = 'var(--ink-3)') { if (status) { status.textContent = text; status.style.color = color; } }
  const cell = (key: string) => document.querySelector(`tr[data-key="${key}"]`);
  function setComputed(key: string, v: number) { const el = cell(key)?.querySelector('[data-value]'); if (el) el.textContent = fmt(v); }

  function renderBadges(tr: Element, frozen: boolean, gate: string | null, conf: string) {
    const badges = tr.querySelector('[data-badges]');
    if (!badges) return;
    const c = conf === 'Live' ? '<span class="badge badge-live">Live</span>' : '<span class="badge badge-est">Est</span>';
    const f = frozen ? ` <span class="badge badge-frozen">Frozen${gate ? ' · ' + gate : ''}</span>` : '';
    badges.innerHTML = c + f;
  }

  async function recomputeAxleLoads(mass: number, ff: number) {
    const front = mass * G * ff, rear = mass * G * (1 - ff);
    setComputed('axle_load_front', front); setComputed('axle_load_rear', rear);
    // Ignore errors (e.g. if an axle load is itself frozen).
    await Promise.all([setMasterValue('axle_load_front', front), setMasterValue('axle_load_rear', rear)]);
  }

  (async () => {
    const master = await loadMaster();
    if (Object.keys(master).length === 0) return;

    for (const key of Object.keys(master)) {
      const row = master[key]; const tr = cell(key); if (!tr) continue;
      frozenState[key] = row.frozen;
      const input = tr.querySelector('[data-input]') as HTMLInputElement | null;
      if (input) input.value = String(row.value ?? '');
      else setComputed(key, row.value as number);
      const fz = tr.querySelector('[data-freeze]') as HTMLInputElement | null;
      if (fz) fz.checked = row.frozen;
      renderBadges(tr, row.frozen, row.frozen_gate, row.confidence);
    }
    if (note) note.innerHTML = 'Showing <strong>live shared values</strong> from the Master store. Edits save for the whole team.';

    const saveNormal = debounce(async (key: string, value: number) => {
      setStatus('Saving…');
      const err = await setMasterValue(key, value);
      if (err) return setStatus('Save failed: ' + err, 'var(--heritage)');
      if (key === 'mass_total' || key === 'mass_frac_front') {
        const mass = Number((cell('mass_total')?.querySelector('[data-input]') as HTMLInputElement)?.value);
        const ff = Number((cell('mass_frac_front')?.querySelector('[data-input]') as HTMLInputElement)?.value);
        if (Number.isFinite(mass) && Number.isFinite(ff)) await recomputeAxleLoads(mass, ff);
      }
      setStatus('Saved ✓', 'var(--state-linked)');
    }, 500);

    // Frozen edits: confirm a reason, go through the enforced edit_param path.
    async function saveFrozen(key: string, value: number) {
      const reason = window.prompt(`"${key}" is frozen. Enter a reason for this change (recorded in the Change Log):`);
      if (reason === null || reason.trim() === '') { setStatus('Frozen edit cancelled — a reason is required.', 'var(--heritage)'); return false; }
      setStatus('Saving…');
      const err = await editFrozenParam(key, value, reason.trim());
      if (err) { setStatus('Save failed: ' + err, 'var(--heritage)'); return false; }
      setStatus('Saved & logged ✓', 'var(--state-linked)');
      return true;
    }

    document.querySelectorAll('[data-input]').forEach((el) => {
      const input = el as HTMLInputElement;
      const key = input.closest('tr')?.getAttribute('data-key'); if (!key) return;
      if (frozenState[key]) {
        // Frozen: edit on change (after a reason), not keystroke-by-keystroke.
        input.addEventListener('change', async () => {
          const v = Number(input.value);
          if (!Number.isFinite(v)) return;
          const ok = await saveFrozen(key, v);
          if (!ok) { const m = await loadMaster(); if (m[key]) input.value = String(m[key].value); }
        });
      } else {
        input.addEventListener('input', () => {
          const v = Number(input.value);
          if (input.value.trim() === '' || !Number.isFinite(v)) return setStatus('Enter a number', 'var(--heritage)');
          saveNormal(key, v);
        });
      }
    });

    // Freeze / unfreeze toggles.
    document.querySelectorAll('[data-freeze]').forEach((el) => {
      const box = el as HTMLInputElement;
      const tr = box.closest('tr')!; const key = tr.getAttribute('data-key')!;
      box.addEventListener('change', async () => {
        const gate = box.checked ? gateSel.value : null;
        setStatus('Saving…');
        const err = await setFrozen(key, box.checked, gate);
        if (err) { setStatus('Freeze failed: ' + err, 'var(--heritage)'); box.checked = !box.checked; return; }
        frozenState[key] = box.checked;
        const conf = tr.querySelector('.badge-live') ? 'Live' : 'Est';
        renderBadges(tr, box.checked, gate, conf);
        setStatus(box.checked ? `Frozen at ${gate} ✓` : 'Unfrozen ✓', 'var(--state-linked)');
        // Rebind the value input to the right handler by reloading the page's logic is overkill;
        // the next edit will use the current frozenState via the closures above only if reloaded.
        // Simplest correctness: reload so handlers match the new frozen state.
        setTimeout(() => window.location.reload(), 600);
      });
    });
  })();
</script>
