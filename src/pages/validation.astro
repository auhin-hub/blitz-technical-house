---
// Validation moved into the Design report (section "Validation"). Kept so old links
// and bookmarks still work: meta refresh + a visible link (no JS needed).
import { url } from '../lib/config';
const target = `${url('report')}#validation`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Validation has moved</title>
  </head>
  <body style="font-family: system-ui, sans-serif; padding: 2rem; line-height: 1.5;">
    <p>Validation is now a section of the <a href={target}>Design report</a>. Redirecting…</p>
    <script is:inline define:vars={{ target }}>location.replace(target);</script>
  </body>
</html>
