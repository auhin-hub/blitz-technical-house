---
import Base from '../layouts/Base.astro';
import { url } from '../lib/config';

// Hardpoints (one corner). Coordinate convention (SolidWorks-friendly):
// origin = front-axle centre on the ground; x = rearward, y = right, z = up (mm).
// Front-view kinematics (RC/camber/scrub) use y,z; x is for the side view + export.
const HP = [
  { key: 'lip', label: 'Lower inner pivot', x: 10, y: 150, z: 120 },
  { key: 'uip', label: 'Upper inner pivot', x: -10, y: 230, z: 330 },
  { key: 'lbj', label: 'Lower outer ball joint', x: 5, y: 620, z: 135 },
  { key: 'ubj', label: 'Upper outer ball joint', x: -5, y: 560, z: 365 },
  { key: 'wc', label: 'Wheel centre', x: 0, y: 610, z: 228 },
  { key: 'cp', label: 'Contact patch', x: 0, y: 620, z: 0 },
];
const ni = 'width:72px;text-align:right;font-family:var(--font-mono);background:var(--surface-2);border:1px solid var(--rule);border-radius:var(--radius-sm);color:var(--ink);padding:0.22rem 0.4rem;';
// Synthesis (target-driven) inputs — Suspension_Geometry.xlsx D11–D32.
const SYNTH = [
  { key: 'rcHeight', label: 'RC height', val: 50 }, { key: 'vsal', label: 'VSAL (Y)', val: 3000 },
  { key: 'scrub', label: 'Scrub radius', val: 40 }, { key: 'kpi', label: 'KPI angle (deg)', val: 2 },
  { key: 'lowerOuterHeight', label: 'Lower outer height', val: 135 }, { key: 'upperOuterHeight', label: 'Upper outer height', val: 365 },
  { key: 'lowerArmLen', label: 'Lower arm length', val: 493 }, { key: 'upperArmLen', label: 'Upper arm length', val: 360 },
  { key: 'caster', label: 'Caster (deg)', val: 4 }, { key: 'mechTrail', label: 'Mechanical trail', val: 25 },
  { key: 'lowerInnerLong', label: 'Lower inner fore-aft span', val: 300 }, { key: 'lowerInnerFwd', label: 'Lower inner fwd of CP', val: 50 },
  { key: 'upperInnerLong', label: 'Upper inner fore-aft span', val: 400 }, { key: 'upperInnerFwd', label: 'Upper inner fwd of CP', val: 75 },
  { key: 'pushrodLowerY', label: 'Pushrod lower Y', val: 45 }, { key: 'pushrodLowerZ', label: 'Pushrod lower Z', val: 135 },
  { key: 'pushrodUpperY', label: 'Pushrod upper Y', val: 412 }, { key: 'pushrodUpperZ', label: 'Pushrod upper Z', val: 343 },
  { key: 'tyreRadius', label: 'Tyre loaded radius', val: 228 }, { key: 'track', label: 'Front track', val: 1600 },
];
---
<Base title="Suspension geometry">
  <nav class="annot" style="margin-bottom:0.75rem;">
    <a href={url('vehicle-dynamics')} style="color:inherit;">VD Workspace</a> / Suspension geometry
  </nav>
  <header style="margin-bottom:1rem;">
    <p class="annot annot-tick">Stage 05 · Gate G3 · hardpoints freeze here</p>
    <h1 style="margin-top:0.4rem;">Suspension geometry</h1>
    <p style="color:var(--ink-2);margin-top:0.5rem;max-width:74ch;">
      Dual-mode: <strong>synthesis</strong> generates the hardpoint set from target
      parameters (ported from the Suspension_Geometry workbook); the
      <strong>solver</strong> reads that one shared set and computes roll-centre,
      camber and scrub through travel, with a live front-view diagram (arms →
      instant centre → roll centre, tyre), a car-scaled side view, target-vs-achieved
      against the synthesis intent, and a SolidWorks-coordinate hardpoint export. A
      design-stage estimate — full 3D kinematics stays in ADAMS.
      <strong>Freeze the hardpoints at G3.</strong>
    </p>
  </header>

  <div class="card" style="margin-bottom:1rem;">
    <span class="annot">From Master</span>
    <div style="display:flex;gap:1.4rem;flex-wrap:wrap;margin-top:0.4rem;font-size:var(--fs-300);">
      <span>Wheelbase (L) <span class="field field-linked mono" data-master="wheelbase">—</span> mm</span>
      <span>CoG height (h) <span class="field field-linked mono" data-master="cog_height">—</span> mm</span>
    </div>
  </div>

  <div class="card">
    <div class="ct-body">
      <div class="ct-col">
        <details class="synth" style="margin-bottom:0.8rem;border:1px solid var(--rule);border-radius:var(--radius);padding:0.6rem;">
          <summary class="annot" style="cursor:pointer;">Synthesis — generate hardpoints from targets (Suspension_Geometry.xlsx)</summary>
          <p class="ct-ref" style="margin:0.3rem 0;">Planar (front-view y/z) synthesis; longitudinal x from caster + inner-distance inputs. <strong>Generate</strong> overwrites the hardpoint table; the solver then reports target-vs-achieved. Targets are retained after hand-edits.</p>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:0.25rem 0.8rem;">
            {SYNTH.map((s) => (
              <label style="font-size:var(--fs-200);display:flex;justify-content:space-between;gap:0.4rem;align-items:center;">{s.label}
                <input type="number" step="any" data-synth={s.key} value={s.val} style={ni} aria-label={s.label} /></label>
            ))}
          </div>
          <button class="btn btn-heritage" type="button" id="geo-generate" style="margin-top:0.5rem;">Generate hardpoints</button>
          <span class="mono" id="geo-generate-status" style="margin-left:0.6rem;font-size:var(--fs-200);color:var(--ink-3);"></span>
        </details>

        <h3 class="ct-h3">Hardpoints — one corner (freeze at G3)</h3>
        <div class="ct-wrap"><table class="ct-table"><thead><tr><th>Point</th><th class="ct-num">x (mm)</th><th class="ct-num">y (mm)</th><th class="ct-num">z (mm)</th></tr></thead>
          <tbody>{HP.map((p) => (
            <tr><td>{p.label}</td>
              <td class="ct-num"><input type="number" step="any" style={ni} data-hp={`${p.key}_x`} value={p.x} aria-label={`${p.label} x`} /></td>
              <td class="ct-num"><input type="number" step="any" style={ni} data-hp={`${p.key}_y`} value={p.y} aria-label={`${p.label} y`} /></td>
              <td class="ct-num"><input type="number" step="any" style={ni} data-hp={`${p.key}_z`} value={p.z} aria-label={`${p.label} z`} /></td></tr>
          ))}</tbody></table></div>
        <div style="display:flex;gap:0.6rem;flex-wrap:wrap;margin-top:0.5rem;">
          <button class="btn btn-ghost" type="button" id="geo-export" style="font-size:var(--fs-200);">Export hardpoints (CSV → SolidWorks)</button>
        </div>
        <p class="ct-ref" style="margin-top:0.3rem;">Origin = front-axle centre on the ground · x rearward · y right · z up.</p>

        <h3 class="ct-h3" style="margin-top:1rem;">Front view (live)</h3>
        <div id="geo-front-svg" style="border:1px solid var(--rule);border-radius:var(--radius);background:var(--surface-2);margin-top:0.3rem;overflow:hidden;"></div>
        <p class="ct-ref" style="margin-top:0.3rem;">Arms extended to the instant centre (IC); contact-patch→IC crosses the centreline at the roll centre (RC).</p>

        <h3 class="ct-h3" style="margin-top:1rem;">Side view (anti-geometry schematic)</h3>
        <div id="geo-side-svg" style="border:1px solid var(--rule);border-radius:var(--radius);background:var(--surface-2);margin-top:0.3rem;overflow:hidden;"></div>
        <p class="ct-ref" style="margin-top:0.3rem;">Schematic from the side-view swing-arm angle below; the line from the contact patch meets the % of the way to the CoG set by anti-dive/squat.</p>

        <h3 class="ct-h3">Anti-dive / anti-squat</h3>
        <p style="color:var(--ink-2);font-size:var(--fs-300);">% anti = share · tan(θ_svsa) · L / h (L, h from Master).</p>
        <div class="ct-wrap"><table class="ct-table"><thead><tr><th>Parameter</th><th class="ct-num">Front</th><th class="ct-num">Rear</th><th>Unit</th></tr></thead>
          <tbody>
            <tr><td>Side-view swing-arm angle θ</td><td class="ct-num"><input type="number" step="any" style={ni} data-in="f_svsa" value="8" /></td><td class="ct-num"><input type="number" step="any" style={ni} data-in="r_svsa" value="6" /></td><td class="ct-unit">deg</td></tr>
            <tr><td>Brake / drive share on axle</td><td class="ct-num"><input type="number" step="any" style={ni} data-in="f_share" value="0.65" /></td><td class="ct-num"><input type="number" step="any" style={ni} data-in="r_share" value="1" /></td><td class="ct-unit">-</td></tr>
            <tr><td>% anti-dive (F) / anti-squat (R)</td><td class="ct-num"><span class="field field-computed mono" data-out="f_anti">—</span></td><td class="ct-num"><span class="field field-computed mono" data-out="r_anti">—</span></td><td class="ct-unit">%</td></tr>
          </tbody></table></div>
      </div>

      <div class="ct-col">
        <div class="ct-stats">
          <div class="ct-stat"><span class="annot">Static RC height</span><div class="val"><span data-out="staticRc">—</span><span class="ct-unit" style="font-size:var(--fs-400)"> mm</span></div></div>
          <div class="ct-stat"><span class="annot">Camber gain / bump</span><div class="val"><span data-out="camberGain">—</span><span class="ct-unit" style="font-size:var(--fs-400)"> °/10mm</span></div><span class="ct-ref">&lt;0.5</span></div>
          <div class="ct-stat"><span class="annot">RC migration</span><div class="val"><span data-out="rcMig">—</span><span class="ct-unit" style="font-size:var(--fs-400)"> mm</span></div><span class="ct-ref">&lt;60</span></div>
          <div class="ct-stat"><span class="annot">Scrub @ bump</span><div class="val"><span data-out="scrubBump">—</span><span class="ct-unit" style="font-size:var(--fs-400)"> mm</span></div></div>
          <div class="ct-stat"><span class="annot">Static camber</span><div class="val"><span data-out="staticCamber">—</span><span class="ct-unit" style="font-size:var(--fs-400)"> deg</span></div></div>
        </div>
        <h3 class="ct-h3">Target vs achieved</h3>
        <div class="ct-wrap"><table class="ct-table"><thead><tr><th>Parameter</th><th class="ct-num">Target</th><th class="ct-num">Solved</th></tr></thead>
          <tbody>
            <tr><td>RC height (mm)</td><td class="ct-num"><span data-out="tgtRc">—</span></td><td class="ct-num"><span data-out="solRc">—</span></td></tr>
            <tr><td>Scrub radius (mm)</td><td class="ct-num"><span data-out="tgtScrub">—</span></td><td class="ct-num"><span data-out="solScrub">—</span></td></tr>
            <tr><td>KPI (deg)</td><td class="ct-num"><span data-out="tgtKpi">—</span></td><td class="ct-num"><span data-out="solKpi">—</span></td></tr>
          </tbody></table></div>
        <h3 class="ct-h3">Roll-centre height vs heave</h3>
        <div style="height:190px;position:relative;"><canvas id="rc-chart"></canvas></div>
        <h3 class="ct-h3">Camber &amp; scrub vs heave</h3>
        <div style="height:190px;position:relative;"><canvas id="cam-chart"></canvas></div>
        <p style="margin-top:0.6rem;"><button class="btn btn-heritage" type="button" id="geo-contribute">Contribute to Master</button>
          <span class="mono" id="geo-contribute-status" style="margin-left:0.6rem;font-size:var(--fs-200);color:var(--ink-3);"></span></p>
        <p style="margin-top:0.4rem;font-size:var(--fs-300);">Rear roll-centre height <input type="number" step="any" id="geo-rear-rc" style={ni} placeholder="mm" /> mm
          <button class="btn btn-ghost" type="button" id="geo-rear-rc-write" style="font-size:var(--fs-200);margin-left:0.4rem;">Write rear_rc_height → Master</button>
          <span class="mono" id="geo-rear-rc-status" style="margin-left:0.4rem;font-size:var(--fs-200);color:var(--ink-3);"></span></p>
      </div>
    </div>
    <p class="mono" data-save-status style="margin-top:0.7rem;font-size:var(--fs-200);color:var(--ink-3);"></p>
  </div>
</Base>

<script>
  import Chart from 'chart.js/auto';
  import { geometrySweep, geometrySummary, antiGeometry, frontViewConstruction, staticCamber, type Hardpoints } from '../lib/calc/geometry';
  import { synthesize, solvedScrub, solvedKpiDeg, type SynthInput } from '../lib/calc/geometry-synth';
  import { loadMaster, saveToolJson, loadToolJson, saveToolOutputs, setMasterValue, fmt, debounce } from '../lib/store';
  import { toCsv, downloadText } from '../lib/csv';
  import { decorateLinkedCells } from '../lib/linked';
  import { applyChartDefaults, palette, watchTheme } from '../lib/chart-theme';

  const TOOL = 'geometry';
  const saveStatus = document.querySelector('[data-save-status]') as HTMLElement;
  let master: Record<string, number> = {};
  const charts = new Map<string, Chart>();
  let last: any = {};
  const gh = (k: string) => Number((document.querySelector(`[data-hp="${k}"]`) as HTMLInputElement)?.value);
  const gi = (k: string) => Number((document.querySelector(`[data-in="${k}"]`) as HTMLInputElement)?.value);
  const gsy = (k: string) => Number((document.querySelector(`[data-synth="${k}"]`) as HTMLInputElement)?.value);
  const put = (k: string, v: number, d = 1) => { const el = document.querySelector(`[data-out="${k}"]`); if (el) el.textContent = Number.isFinite(v) ? fmt(v, d) : '—'; };
  const setText = (k: string, s: string) => { const el = document.querySelector(`[data-out="${k}"]`); if (el) el.textContent = s; };
  // Retained synthesis targets (survive hand-edits), for target-vs-achieved.
  let targets: { rcHeight: number; scrub: number; kpi: number } | null = null;

  function hardpoints(): Hardpoints {
    const p = (k: string) => ({ y: gh(`${k}_y`), z: gh(`${k}_z`) });
    return { lip: p('lip'), uip: p('uip'), lbj: p('lbj'), ubj: p('ubj'), wc: p('wc'), cp: p('cp') };
  }
  const KEYS = ['lip', 'uip', 'lbj', 'ubj', 'wc', 'cp'] as const;
  const hp3d = () => Object.fromEntries(KEYS.map((k) => [k, { x: gh(`${k}_x`), y: gh(`${k}_y`), z: gh(`${k}_z`) }])) as Record<string, { x: number; y: number; z: number }>;

  // ---- Live diagrams (P2.1) ----
  const r1 = (n: number) => Math.round(n * 10) / 10;
  type P = { y: number; z: number };
  function buildFront(hp: Hardpoints, ic: P | null, rcZ: number): string {
    const r = Math.abs(hp.wc.z - hp.cp.z) || 100;
    const useIc = ic && Number.isFinite(ic.y) && Number.isFinite(ic.z) && Math.abs(ic.y) < 6000 && Math.abs(ic.z) < 6000;
    const all: P[] = [hp.lip, hp.uip, hp.lbj, hp.ubj, hp.wc, hp.cp, { y: hp.wc.y - r, z: hp.wc.z }, { y: hp.wc.y + r, z: hp.wc.z }, { y: 0, z: 0 }, { y: 0, z: rcZ }];
    if (useIc) all.push(ic!);
    const minY = Math.min(...all.map((p) => p.y)) - 30, maxY = Math.max(...all.map((p) => p.y)) + 30;
    const minZ = Math.min(...all.map((p) => p.z)) - 30, maxZ = Math.max(...all.map((p) => p.z)) + 30;
    const W = 360, s = W / (maxY - minY), H = Math.max(150, (maxZ - minZ) * s);
    const X = (y: number) => ((y - minY) * s).toFixed(1), Y = (z: number) => ((maxZ - z) * s).toFixed(1);
    const line = (a: P, b: P, st: string, dash = false) => `<line x1="${X(a.y)}" y1="${Y(a.z)}" x2="${X(b.y)}" y2="${Y(b.z)}" stroke="${st}" stroke-width="2"${dash ? ' stroke-dasharray="4 3"' : ''}/>`;
    const dot = (p: P, st: string, rr = 3) => `<circle cx="${X(p.y)}" cy="${Y(p.z)}" r="${rr}" fill="${st}"/>`;
    let el = `<line x1="${X(0)}" y1="0" x2="${X(0)}" y2="${H}" stroke="var(--rule-strong)" stroke-width="1" stroke-dasharray="2 4"/>`;
    el += `<line x1="0" y1="${Y(0)}" x2="${W}" y2="${Y(0)}" stroke="var(--rule-strong)" stroke-width="1"/>`;
    // tyre rectangle (ground → 2·wheel-centre height, ~tyre width around wc.y)
    const tw = 90;
    el += `<rect x="${X(hp.wc.y - tw)}" y="${Y(hp.wc.z * 2)}" width="${(2 * tw * s).toFixed(1)}" height="${(hp.wc.z * 2 * s).toFixed(1)}" fill="none" stroke="var(--rule-strong)" stroke-width="1"/>`;
    el += `<circle cx="${X(hp.wc.y)}" cy="${Y(hp.wc.z)}" r="${(r * s).toFixed(1)}" fill="none" stroke="var(--ink-3)" stroke-width="1.5"/>`;
    el += line(hp.lip, hp.lbj, 'var(--sky)') + line(hp.uip, hp.ubj, 'var(--sky)') + line(hp.lbj, hp.ubj, 'var(--ink)');
    if (useIc) {
      el += line(hp.lbj, ic!, 'var(--sky)', true) + line(hp.ubj, ic!, 'var(--sky)', true) + line(hp.cp, ic!, 'var(--amber)', true);
      el += dot(ic!, 'var(--sky)', 3) + `<text x="${X(ic!.y)}" y="${+Y(ic!.z) - 6}" fill="var(--ink-2)" font-size="10">IC</text>`;
    }
    el += dot({ y: 0, z: rcZ }, 'var(--maroon)', 5) + `<text x="${+X(0) + 6}" y="${+Y(rcZ) - 4}" fill="var(--maroon)" font-size="10">RC ${r1(rcZ)}</text>`;
    for (const p of [hp.lip, hp.uip, hp.lbj, hp.ubj]) el += dot(p, 'var(--ink)');
    el += dot(hp.cp, 'var(--amber)');
    return `<svg viewBox="0 0 ${W} ${H.toFixed(0)}" width="100%" style="display:block;height:auto;" role="img" aria-label="front-view suspension diagram">${el}</svg>`;
  }
  function buildSide(hp: Record<string, { x: number; y: number; z: number }>, svsaDeg: number, antiPct: number, wheelbase: number): string {
    // Clip the view to a car-scaled window around the wheel (not a runaway SVSA
    // circle): x window = ±~¼ wheelbase (fallback 450 mm). The side-view swing arm
    // is drawn as a direction clipped to the right edge; its IC usually lies well
    // outside the window, so we annotate it rather than zooming out to include it.
    const r = Math.abs(hp.wc.z - hp.cp.z) || 100;
    const win = Number.isFinite(wheelbase) && wheelbase > 0 ? wheelbase / 4 : 450;
    const minX = hp.cp.x - win - 30, maxX = hp.cp.x + win + 30;
    const minZ = -30, maxZ = Math.max(hp.wc.z + r, r) + 40;
    const W = 360, s = W / (maxX - minX), H = Math.max(140, (maxZ - minZ) * s);
    const X = (x: number) => ((x - minX) * s).toFixed(1), Y = (z: number) => ((maxZ - z) * s).toFixed(1);
    const th = (svsaDeg * Math.PI) / 180;
    // SVSA line from the contact patch, clipped to the right window edge.
    const dx = maxX - hp.cp.x;
    const endX = hp.cp.x + dx, endZ = hp.cp.z + dx * Math.tan(th);
    let el = `<line x1="0" y1="${Y(0)}" x2="${W}" y2="${Y(0)}" stroke="var(--rule-strong)" stroke-width="1"/>`;
    el += `<rect x="${X(hp.wc.x - 90)}" y="${Y(hp.wc.z * 2)}" width="${(180 * s).toFixed(1)}" height="${(hp.wc.z * 2 * s).toFixed(1)}" fill="none" stroke="var(--rule-strong)" stroke-width="1"/>`;
    el += `<circle cx="${X(hp.wc.x)}" cy="${Y(hp.wc.z)}" r="${(r * s).toFixed(1)}" fill="none" stroke="var(--ink-3)" stroke-width="1.5"/>`;
    el += `<line x1="${X(hp.cp.x)}" y1="${Y(hp.cp.z)}" x2="${X(endX)}" y2="${Y(endZ)}" stroke="var(--amber)" stroke-width="2" stroke-dasharray="4 3"/>`;
    el += `<circle cx="${X(hp.cp.x)}" cy="${Y(hp.cp.z)}" r="3" fill="var(--amber)"/>`;
    el += `<text x="8" y="16" fill="var(--ink-2)" font-size="11">θ_svsa ${r1(svsaDeg)}° · anti ${r1(antiPct)}% · side-view IC off-window (long swing arm)</text>`;
    return `<svg viewBox="0 0 ${W} ${H.toFixed(0)}" width="100%" style="display:block;height:auto;" role="img" aria-label="side-view anti-geometry schematic">${el}</svg>`;
  }

  function upsert(id: string, cfg: any) {
    const ex = charts.get(id);
    if (ex) { ex.data = cfg.data; ex.options = cfg.options; ex.update(); }
    else { const cv = document.getElementById(id) as HTMLCanvasElement | null; if (cv) charts.set(id, new Chart(cv, cfg)); }
  }

  function recompute() {
    const hp = hardpoints();
    const sweep = geometrySweep(hp, 30);
    const sum = geometrySummary(hp, 30);
    last = { sum, sweep };
    put('staticRc', sum.staticRc as number, 1);
    put('camberGain', sum.camberGainBump as number, 3);
    put('rcMig', sum.rcMigration as number, 1);
    const bump = sweep.reduce((p, c) => (Math.abs(c.heave - 25) < Math.abs(p.heave - 25) ? c : p), sweep[0] ?? { scrub: NaN, heave: 0 } as any);
    put('scrubBump', bump ? bump.scrub : NaN, 1);

    put('staticCamber', staticCamber(hp), 2);
    const fAnti = antiGeometry(gi('f_share'), gi('f_svsa'), master.wheelbase, master.cog_height);
    const rAnti = antiGeometry(gi('r_share'), gi('r_svsa'), master.wheelbase, master.cog_height);
    put('f_anti', fAnti, 1);
    put('r_anti', rAnti, 1);

    // Live diagrams.
    const { ic, rc } = frontViewConstruction(hp);
    const frontEl = document.getElementById('geo-front-svg'); if (frontEl) frontEl.innerHTML = buildFront(hp, ic, rc.z);
    const sideEl = document.getElementById('geo-side-svg'); if (sideEl) sideEl.innerHTML = buildSide(hp3d(), gi('f_svsa'), Number.isFinite(fAnti) ? fAnti : 0, master.wheelbase);

    // Target vs achieved (retained synthesis targets vs the solved geometry).
    const hpf = hardpoints();
    put('solRc', sum.staticRc as number, 1);
    put('solScrub', solvedScrub(hpf.lbj, hpf.ubj), 1);
    put('solKpi', solvedKpiDeg(hpf.lbj, hpf.ubj), 2);
    setText('tgtRc', targets ? fmt(targets.rcHeight, 1) : '—');
    setText('tgtScrub', targets ? fmt(targets.scrub, 1) : '—');
    setText('tgtKpi', targets ? fmt(targets.kpi, 2) : '—');

    const p = palette();
    const labels = sweep.map((s) => s.heave.toFixed(0));
    upsert('rc-chart', { type: 'line', data: { labels, datasets: [{ label: 'RC height (mm)', data: sweep.map((s) => +s.rcHeight.toFixed(1)), borderColor: p.sky, backgroundColor: p.sky, pointRadius: 0 }] },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { title: { display: true, text: 'wheel heave (mm)' } }, y: { title: { display: true, text: 'RC (mm)' } } } } });
    upsert('cam-chart', { type: 'line', data: { labels, datasets: [
      { label: 'Camber (deg)', data: sweep.map((s) => +s.camber.toFixed(3)), borderColor: p.amber, backgroundColor: p.amber, pointRadius: 0, yAxisID: 'y' },
      { label: 'Scrub (mm)', data: sweep.map((s) => +s.scrub.toFixed(2)), borderColor: p.maroon, backgroundColor: p.maroon, pointRadius: 0, yAxisID: 'y1' },
    ] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { labels: { usePointStyle: true } } },
      scales: { x: { title: { display: true, text: 'wheel heave (mm)' } }, y: { position: 'left', title: { display: true, text: 'camber °' } }, y1: { position: 'right', grid: { drawOnChartArea: false }, title: { display: true, text: 'scrub mm' } } } } });
  }

  const persist = debounce(async () => {
    const data: Record<string, any> = {};
    document.querySelectorAll('[data-hp]').forEach((el) => { data[(el as HTMLInputElement).dataset.hp!] = Number((el as HTMLInputElement).value); });
    document.querySelectorAll('[data-in]').forEach((el) => { data['in_' + (el as HTMLInputElement).dataset.in!] = Number((el as HTMLInputElement).value); });
    document.querySelectorAll('[data-synth]').forEach((el) => { data['sy_' + (el as HTMLInputElement).dataset.synth!] = Number((el as HTMLInputElement).value); });
    if (targets) data.targets = targets;
    saveStatus.textContent = 'Saving…';
    const err = await saveToolJson(TOOL, data);
    saveStatus.textContent = err ? 'Save failed: ' + err : 'Saved ✓';
    saveStatus.style.color = err ? 'var(--heritage)' : 'var(--state-linked)';
  }, 600);

  function readSynth(): SynthInput {
    const k = (x: string) => gsy(x);
    return {
      rcHeight: k('rcHeight'), vsal: k('vsal'), scrub: k('scrub'), kpi: k('kpi'),
      lowerOuterHeight: k('lowerOuterHeight'), upperOuterHeight: k('upperOuterHeight'),
      lowerArmLen: k('lowerArmLen'), upperArmLen: k('upperArmLen'), caster: k('caster'), mechTrail: k('mechTrail'),
      lowerInnerLong: k('lowerInnerLong'), lowerInnerFwd: k('lowerInnerFwd'), upperInnerLong: k('upperInnerLong'), upperInnerFwd: k('upperInnerFwd'),
      pushrodLowerY: k('pushrodLowerY'), pushrodLowerZ: k('pushrodLowerZ'), pushrodUpperY: k('pushrodUpperY'), pushrodUpperZ: k('pushrodUpperZ'),
      tyreRadius: k('tyreRadius'), track: k('track'),
    };
  }
  function generate() {
    const inp = readSynth();
    const r = synthesize(inp);
    const setHp = (key: string, pt: { x: number; y: number; z: number }) => {
      for (const f of ['x', 'y', 'z'] as const) { const el = document.querySelector(`[data-hp="${key}_${f}"]`) as HTMLInputElement | null; if (el) el.value = String(+pt[f].toFixed(2)); }
    };
    setHp('lip', r.hp.lip); setHp('uip', r.hp.uip); setHp('lbj', r.hp.lbj); setHp('ubj', r.hp.ubj); setHp('wc', r.hp.wc); setHp('cp', r.hp.cp);
    targets = { rcHeight: inp.rcHeight, scrub: inp.scrub, kpi: inp.kpi };
    const st = document.getElementById('geo-generate-status'); if (st) { st.textContent = 'hardpoints generated ✓'; st.style.color = 'var(--state-linked)'; }
    recompute(); persist();
  }

  (async () => {
    applyChartDefaults();
    const rows = await loadMaster();
    master = Object.fromEntries(Object.entries(rows).map(([k, v]) => { const val = (v as any).value; return [k, val === null || val === undefined ? NaN : Number(val)]; }));
    decorateLinkedCells(document, rows);
    const saved = await loadToolJson<Record<string, any>>(TOOL, {});
    for (const [k, v] of Object.entries(saved)) {
      if (v == null) continue;
      if (k === 'targets') { targets = v as any; continue; }
      if (k.startsWith('in_')) { const el = document.querySelector(`[data-in="${k.slice(3)}"]`) as HTMLInputElement | null; if (el) el.value = String(v); }
      else if (k.startsWith('sy_')) { const el = document.querySelector(`[data-synth="${k.slice(3)}"]`) as HTMLInputElement | null; if (el) el.value = String(v); }
      else { const el = document.querySelector(`[data-hp="${k}"]`) as HTMLInputElement | null; if (el) el.value = String(v); }
    }
    recompute();
    document.querySelectorAll('[data-hp],[data-in]').forEach((el) => el.addEventListener('input', () => { recompute(); persist(); }));
    document.querySelectorAll('[data-synth]').forEach((el) => el.addEventListener('input', persist));
    document.getElementById('geo-generate')!.addEventListener('click', generate);

    // Rear roll-centre height → Master (freeze-aware), for the rear corner.
    document.getElementById('geo-rear-rc-write')!.addEventListener('click', async () => {
      const st = document.getElementById('geo-rear-rc-status')!;
      const v = Number((document.getElementById('geo-rear-rc') as HTMLInputElement).value);
      if (!Number.isFinite(v)) { st.textContent = 'Enter a value.'; st.style.color = 'var(--heritage)'; return; }
      st.textContent = 'Saving…'; st.style.color = 'var(--ink-3)';
      const err = await setMasterValue('rear_rc_height', +v.toFixed(2));
      st.textContent = err ? 'Failed (frozen?): ' + err : 'Written ✓';
      st.style.color = err ? 'var(--heritage)' : 'var(--state-linked)';
    });

    document.getElementById('geo-export')!.addEventListener('click', () => {
      const hp = hp3d();
      const labels: Record<string, string> = { lip: 'Lower inner pivot', uip: 'Upper inner pivot', lbj: 'Lower outer ball joint', ubj: 'Upper outer ball joint', wc: 'Wheel centre', cp: 'Contact patch' };
      const rows = KEYS.map((k) => [k, labels[k], hp[k].x, hp[k].y, hp[k].z]);
      const header = toCsv(['point', 'name', 'x_mm', 'y_mm', 'z_mm'], rows);
      const note = '# MIST Blitz suspension hardpoints (one corner)\r\n# Origin = front-axle centre on the ground; x = rearward, y = right, z = up; mm.\r\n';
      downloadText('hardpoints.csv', note + header);
    });

    document.getElementById('geo-contribute')!.addEventListener('click', async () => {
      const st = document.getElementById('geo-contribute-status')!;
      st.textContent = 'Saving…'; st.style.color = 'var(--ink-3)';
      const num = (v: any) => Number.isFinite(v) ? +(+v).toFixed(2) : null;
      const err = await saveToolOutputs(TOOL, [
        { key: 'rc_height_static', label: 'Static roll-centre height', value: num(last.sum?.staticRc), unit: 'mm' },
        { key: 'rc_migration', label: 'RC migration over travel', value: num(last.sum?.rcMigration), unit: 'mm' },
        { key: 'camber_gain_bump', label: 'Camber gain per 10 mm bump', value: num(last.sum?.camberGainBump), unit: 'deg' },
      ]);
      st.textContent = err ? 'Failed: ' + err : 'Contributed ✓';
      st.style.color = err ? 'var(--heritage)' : 'var(--state-linked)';
    });

    watchTheme(() => { applyChartDefaults(); recompute(); });
  })();
</script>
