---
import Base from '../layouts/Base.astro';
import { url } from '../lib/config';
import '../styles/pitwall.css';
---
<Base title="Task Map" description="The car programme as a live pit-wall work map: subteam lanes across the ten phases, every hand-off, and where the programme actually stands.">
  <!-- Pit-wall fonts for this page only (the design the team built). -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Titillium+Web:wght@400;600;700;900&family=Barlow:wght@400;500;600&family=JetBrains+Mono:wght@500;700&display=swap" />

  <div class="pitwall">
    <div class="wrap">
      <nav class="eyebrow" style="padding-top:12px;"><a href={url('')} style="color:inherit;">← Home</a></nav>

      <header class="hero">
        <div class="flag" aria-hidden="true"></div>
        <div class="eyebrow"><b>MIST BLITZ</b><span>CV · Steel spaceframe · Single cylinder · Chain + LSD · Aero</span></div>
        <h1>Car Program <em>Work Map</em></h1>
        <p class="lede">Every technical activity needed to take a Formula Student combustion car from rulebook to a track-ready car at FS UK and FS Japan — who owns each activity, what they need and from whom, where the work loops back, and how far each one has got. Click any block for its tasks and to set its status.</p>
        <div class="stats" id="stats"></div>
      </header>

      <div id="tm-alert" class="tm-alert" hidden></div>

      <div class="bar" role="toolbar" aria-label="Map controls">
        <div class="grp"><label for="q">Find</label><input id="q" class="search" type="search" placeholder="hub, restrictor, SES…" autocomplete="off" /></div>
        <div class="grp"><label>Links</label>
          <div class="seg" id="linkmode">
            <button type="button" data-v="all" aria-pressed="true">All</button>
            <button type="button" data-v="focus" aria-pressed="false">Focus</button>
            <button type="button" data-v="off" aria-pressed="false">Off</button>
          </div></div>
        <div class="grp"><button type="button" class="tog" id="crit" aria-pressed="false"><span style="width:9px;height:9px;background:var(--red);display:inline-block"></span>Critical path</button>
          <button type="button" class="tog" id="chain" aria-pressed="false" title="Highlight the full upstream and downstream chain of the selected activity">Full chain</button>
          <button type="button" class="tog" id="unblocked" aria-pressed="false" title="Only activities that are not done and have every input delivered">Unblocked only</button></div>
        <div class="grp"><label>Loops</label><div class="loopchips" id="loopchips"></div></div>
      </div>

      <div class="legend" aria-label="Legend">
        <span><svg width="38" height="8"><path d="M1 4H32" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M31 1L37 4L31 7" fill="currentColor"/></svg>Hard input (needed before starting)</span>
        <span><svg width="38" height="8"><path d="M1 4H32" stroke="currentColor" stroke-width="1.6" stroke-dasharray="5 4" fill="none"/><path d="M31 1L37 4L31 7" fill="currentColor"/></svg>Iterative / feedback input</span>
        <span><svg width="38" height="8"><path d="M1 4H36" stroke="var(--in)" stroke-width="2.4"/></svg>Needs from (upstream)</span>
        <span><svg width="38" height="8"><path d="M1 4H36" stroke="var(--out)" stroke-width="2.4"/></svg>Gives to (downstream)</span>
        <span><span style="display:inline-flex;gap:4px"><s class="st st-not_started" style="width:8px;height:8px;border-radius:50%"></s><s class="st st-in_progress" style="width:8px;height:8px;border-radius:50%"></s><s class="st st-blocked" style="width:8px;height:8px;border-radius:50%"></s><s class="st st-done" style="width:8px;height:8px;border-radius:50%"></s></span>not started · in progress · blocked · done</span>
      </div>

      <div class="mapbox" id="mapbox"><div class="map" id="map"><svg class="edges" id="edges" aria-hidden="true"></svg></div></div>
      <p class="hint">Scroll sideways to follow the programme from rules to review. Click a lane name for that subteam's duty sheet. Click a block to trace what it needs and feeds, and to set its status.</p>

      <section class="below" id="loops-sec">
        <div class="shead"><h2>Iteration loops</h2><span id="loopcount"></span><p>Car design is not a straight line. These are the cycles where activities trade information back and forth until they converge. Click a loop to light it up on the map.</p></div>
        <div class="loops" id="loopcards"></div>
      </section>

      <section class="below" id="matrix-sec">
        <div class="shead"><h2>Handoff matrix</h2><span>Who gives what to whom</span><p>Rows give, columns receive. Each number counts the information handoffs between two subteams. Click a cell to list exactly what must be handed over.</p></div>
        <div class="mxwrap"><table class="mx" id="mx"></table></div>
        <div class="handoffs" id="handoffs"></div>
      </section>

      <section class="below" id="reg-sec">
        <div class="shead"><h2>Technical task register</h2><span id="regcount"></span><p>The full list of activities by subteam, with owner, inputs, outputs, task checklist, tools, rules and pitfalls. Use it as the season's duty sheet.</p></div>
        <div class="toolsrow"><button type="button" id="expandall">Expand all</button><button type="button" id="collapseall">Collapse all</button></div>
        <div class="reg" id="reg"></div>
      </section>

      <section class="below" id="manage-sec">
        <div class="shead"><h2>Manage</h2><span id="tm-manage-status" class="status"></span><p>Load the authored programme, add activities or hand-offs, and tie phases to gates. Loading the seed keeps every status, owner and note.</p></div>
        <div class="manage" id="manage"></div>
      </section>

      <footer>
        <p>Rule references point to rule sections: FS Rules 2026 (FS UK) and Formula SAE Rules 2026 + FSAEJ local rules (FS Japan). Confirm clause numbers in the current rulebook before designing to them.</p>
        <p>Owners are listed by role so the map survives handovers; assign names in the drawer or your season tracker.</p>
      </footer>
    </div>

    <div class="scrim" id="scrim"></div>
    <aside class="drawer" id="drawer" aria-label="Activity details" aria-hidden="true">
      <div class="dhead" id="dhead"></div>
      <div class="dbody" id="dbody"></div>
    </aside>
  </div>
</Base>

<script>
  import { loadTaskmap, seedTaskmap, setActivityState, createActivity, deleteActivity, addDependency, setPhaseGate, type TaskmapData } from '../lib/taskmap-store';
  import { readyToStart, buildGraph } from '../lib/calc/taskmap';
  import { myRole, loadMembers, type MemberRow } from '../lib/roles';
  import { loadGates, type Gate } from '../lib/store';
  import { subscribeLive, liveToast } from '../lib/realtime';
  import { esc } from '../lib/html';
  import { url } from '../lib/config';

  type Status = 'not_started' | 'in_progress' | 'blocked' | 'done';
  interface Lane { k: string; n: string; s: string; c: string; }
  interface Phase { k: number; key: string; n: string; s: string; gate: boolean; gate_key: string | null; }
  interface Loop { k: string; n: string; c: string; d: string; b: string[]; }
  interface Block {
    id: string; l: string; p: number; n: string; o: string; w: string[]; loops: string[];
    crit: boolean; why: string; done: string; tasks: string[]; pit: string[]; tools: string; rules: string;
    in: [string, string, boolean][];
    status: Status; percent: number | null; owner_user_id: string | null; notes: string; tool_href: string;
  }
  interface Edge { f: string; t: string; what: string; fb: boolean; }

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const STATUS: Status[] = ['not_started', 'in_progress', 'blocked', 'done'];
  const STATUS_LABEL: Record<Status, string> = { not_started: 'not started', in_progress: 'in progress', blocked: 'blocked', done: 'done' };

  // ---- live state kept across rebuilds ----
  let lanes: Lane[] = [], phases: Phase[] = [], loops: Loop[] = [], B: Block[] = [];
  let byId: Record<string, Block> = {}, laneBy: Record<string, Lane> = {}, loopBy: Record<string, Loop> = {};
  let E: Edge[] = [], outs: Record<string, Edge[]> = {}, ins: Record<string, Edge[]> = {};
  const paths: Record<number, SVGPathElement> = {};
  const S = { sel: null as string | null, mode: 'all', crit: false, chain: false, unblocked: false, loop: null as string | null, q: '', lane: null as string | null };
  let members: MemberRow[] = [], gates: Gate[] = [], lead = false, readySet = new Set<string>();

  const map = $('map'), svg = $('edges') as unknown as SVGSVGElement, mapbox = $('mapbox');
  const drawer = $('drawer'), dh = $('dhead'), db = $('dbody'), scrim = $('scrim');
  const lc = (k: string) => '--lc:' + (laneBy[k]?.c ?? '#888');

  // ---- build the D-model from live data ----
  function build(data: TaskmapData) {
    const phaseIdx = new Map(data.phases.map((p) => [p.key, p.idx]));
    lanes = [...data.buckets].sort((a, b) => (a.display_order ?? 0) - (b.display_order ?? 0))
      .map((b) => ({ k: b.key, n: b.name, s: b.scope ?? '', c: b.color ?? '#888' }));
    phases = [...data.phases].sort((a, b) => a.idx - b.idx)
      .map((p) => ({ k: p.idx, key: p.key, n: p.name, s: p.subtitle ?? '', gate: !!p.is_gate, gate_key: p.gate_key ?? null }));
    loops = data.loops.map((l) => ({
      k: l.key, n: l.name, c: l.color ?? '#888', d: l.description ?? '',
      b: data.activities.filter((a) => (a.loop_keys ?? []).includes(l.key)).map((a) => a.code),
    }));
    B = data.activities.map((a) => {
      const inDeps: [string, string, boolean][] = data.dependencies
        .filter((d) => d.to_code === a.code)
        .map((d) => [d.from_code, d.label ?? '', !!d.is_feedback]);
      const ext: [string, string, boolean][] = (a.external_inputs ?? []).map((s) => ['X:' + s, s, false]);
      return {
        id: a.code, l: a.bucket_key, p: phaseIdx.get(a.phase_key) ?? 0, n: a.title, o: a.owner_role ?? '',
        w: a.contributor_keys ?? [], loops: a.loop_keys ?? [], crit: !!a.is_critical, why: a.why ?? '',
        done: a.done_when ?? '', tasks: a.tasks ?? [], pit: a.pitfalls ?? [], tools: a.tools ?? '', rules: a.rules ?? '',
        in: [...inDeps, ...ext],
        status: (a.status ?? 'not_started') as Status, percent: a.percent ?? null,
        owner_user_id: a.owner_user_id ?? null, notes: a.notes ?? '', tool_href: a.tool_href ?? '',
      } as Block;
    });
    byId = {}; laneBy = {}; loopBy = {};
    lanes.forEach((l) => { laneBy[l.k] = l; });
    loops.forEach((l) => { loopBy[l.k] = l; });
    B.forEach((b) => { byId[b.id] = b; });
    E = []; outs = {}; ins = {};
    B.forEach((b) => { outs[b.id] = []; ins[b.id] = []; });
    B.forEach((b) => b.in.forEach((x) => {
      if (x[0].indexOf('X:') === 0) return;
      const f = byId[x[0]]; if (!f) return;
      E.push({ f: f.id, t: b.id, what: x[1], fb: !!x[2] || f.p > b.p });
    }));
    E.forEach((e) => { outs[e.f].push(e); ins[e.t].push(e); });
    // "unblocked now" set, via the shared graph helper (status-aware).
    const g = buildGraph(
      data.activities,
      data.dependencies.map((d) => ({ from_code: d.from_code, to_code: d.to_code, label: d.label, is_feedback: d.is_feedback })),
    );
    readySet = new Set(readyToStart(g).map((a) => a.code));
  }

  // ---- grid ----
  function renderGrid() {
    $('stats').innerHTML = ([[B.length, 'Activities'], [lanes.length, 'Subteam lanes'], [E.length, 'Handoffs'], [loops.length, 'Iteration loops'], [B.filter((b) => b.crit).length, 'Critical-path steps'], [B.filter((b) => b.status === 'done').length, 'Done']] as [number, string][])
      .map((s) => `<div class="stat"><b>${s[0]}</b><span>${esc(s[1])}</span></div>`).join('');

    let html = '<div class="corner">Lane / Phase</div>';
    phases.forEach((p) => {
      html += `<div class="ph${p.gate ? ' gate' : ''}"><div class="no">${esc(p.key)}${p.gate ? ' · GATE' : ''}</div><h3>${esc(p.n)}</h3><p>${esc(p.s)}</p></div>`;
    });
    lanes.forEach((l) => {
      const n = B.filter((b) => b.l === l.k).length;
      html += `<button type="button" class="lane" data-lane="${esc(l.k)}" style="${lc(l.k)}"><b>${esc(l.n)}</b><small>${esc(l.s)}</small><em>${n} activities</em></button>`;
      phases.forEach((p) => {
        const bs = B.filter((b) => b.l === l.k && b.p === p.k);
        html += `<div class="cell${p.gate ? ' gatecol' : ''}">`;
        bs.forEach((b) => {
          html += `<button type="button" class="blk${b.crit ? ' crit' : ''} s-${b.status}" id="b-${esc(b.id)}" data-id="${esc(b.id)}" style="${lc(b.l)}">`
            + `<span class="id"><i></i>${esc(b.id)}</span><span class="nm">${esc(b.n)}</span><span class="ft">`
            + b.loops.map((k) => `<s style="background:${esc(loopBy[k]?.c ?? '#888')}" title="${esc(loopBy[k]?.n ?? k)}" class="st auto"></s>`).join('')
            + (b.crit ? '<span class="cp">CP</span>' : '')
            + `<s class="st st-${b.status}" title="${STATUS_LABEL[b.status]}"></s></span></button>`;
        });
        html += '</div>';
      });
    });
    // keep the <svg> overlay; replace the rest
    map.querySelectorAll(':scope > :not(#edges)').forEach((el) => el.remove());
    map.insertAdjacentHTML('beforeend', html);
    map.style.gridTemplateColumns = `186px repeat(${phases.length},206px)`;
  }

  // ---- edges ----
  const NS = 'http://www.w3.org/2000/svg';
  function drawEdges() {
    const r0 = map.getBoundingClientRect();
    svg.setAttribute('width', String(map.scrollWidth)); svg.setAttribute('height', String(map.scrollHeight));
    svg.setAttribute('viewBox', `0 0 ${map.scrollWidth} ${map.scrollHeight}`);
    const mk = (id: string, col: string) => `<marker id="m-${id}" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L8 4L0 8z" style="fill:${col}"/></marker>`;
    svg.innerHTML = '<defs>'
      + mk('e', 'var(--edge)') + mk('in', 'var(--in)') + mk('out', 'var(--out)') + mk('red', 'var(--red)')
      + loops.map((L) => mk(L.k, L.c)).join('') + '</defs>';
    const rects: Record<string, { x: number; y: number; w: number; h: number }> = {};
    B.forEach((b) => { const el = $('b-' + b.id); if (!el) return; const r = el.getBoundingClientRect(); rects[b.id] = { x: r.left - r0.left, y: r.top - r0.top, w: r.width, h: r.height }; });
    E.forEach((e, i) => {
      const a = rects[e.f], b = rects[e.t]; if (!a || !b) return;
      const x1 = a.x + a.w, y1 = a.y + a.h / 2, x2 = b.x, y2 = b.y + b.h / 2; let d: string;
      if (x2 > x1 + 8) { const dx = Math.max(30, (x2 - x1) * 0.45); d = `M${x1} ${y1}C${x1 + dx} ${y1} ${x2 - dx} ${y2} ${x2 - 2} ${y2}`; }
      else if (Math.abs(a.x - b.x) < 4) { const xr = a.x + a.w, bulge = 26 + Math.min(40, Math.abs(y2 - y1) * 0.08); d = `M${xr} ${y1}C${xr + bulge} ${y1} ${xr + bulge} ${y2} ${xr + 2} ${y2}`; }
      else { const k = 70; d = `M${x1} ${y1}C${x1 + k} ${y1 - 30} ${x2 - k} ${y2 - 30} ${x2 - 2} ${y2}`; }
      const p = document.createElementNS(NS, 'path') as SVGPathElement;
      p.setAttribute('d', d); if (e.fb) p.setAttribute('class', 'fb');
      p.setAttribute('marker-end', 'url(#m-e)'); p.dataset.i = String(i); svg.appendChild(p); paths[i] = p;
    });
    applyState();
  }

  function chainSet(id: string, dir: 'up' | 'down') {
    const seen: Record<string, 1> = {}; const st = [id];
    while (st.length) { const c = st.pop()!; (dir === 'up' ? ins[c] : outs[c]).forEach((e) => { const n = dir === 'up' ? e.f : e.t; if (!seen[n] && n !== id) { seen[n] = 1; st.push(n); } }); }
    return seen;
  }

  function applyState() {
    const hl: Record<string, 1> = {}, up: Record<string, 1> = {}, down: Record<string, 1> = {}, onE: Record<number, string> = {};
    let any = false;
    map.querySelectorAll('.blk').forEach((el) => el.classList.remove('hl', 'sel', 'up', 'down', 'match'));
    if (S.loop) { any = true; const L = loopBy[S.loop]; L.b.forEach((id) => { hl[id] = 1; }); E.forEach((e, i) => { if (hl[e.f] && hl[e.t]) onE[i] = 'loop:' + L.k; }); }
    if (S.crit) { any = true; B.forEach((b) => { if (b.crit) hl[b.id] = 1; }); E.forEach((e, i) => { if (byId[e.f].crit && byId[e.t].crit && !e.fb) onE[i] = 'crit'; }); }
    if (S.unblocked) { any = true; B.forEach((b) => { if (readySet.has(b.id)) hl[b.id] = 1; }); }
    if (S.lane) { any = true; B.forEach((b) => { if (b.l === S.lane) hl[b.id] = 1; }); }
    if (S.q) { any = true; const q = S.q.toLowerCase(); B.forEach((b) => { const t = (b.id + ' ' + b.n + ' ' + b.why + ' ' + b.tasks.join(' ') + ' ' + b.in.map((x) => x[1]).join(' ')).toLowerCase(); if (t.indexOf(q) >= 0) { hl[b.id] = 1; $('b-' + b.id)?.classList.add('match'); } }); }
    if (S.sel) {
      any = true; hl[S.sel] = 1;
      let u: Record<string, 1> = {}, dn: Record<string, 1> = {};
      if (S.chain) { u = chainSet(S.sel, 'up'); dn = chainSet(S.sel, 'down'); }
      else { ins[S.sel].forEach((e) => { u[e.f] = 1; }); outs[S.sel].forEach((e) => { dn[e.t] = 1; }); }
      E.forEach((e, i) => {
        if (S.chain) { if ((u[e.f] || e.f === S.sel) && (u[e.t] || e.t === S.sel)) onE[i] = 'in'; else if ((dn[e.t] || e.t === S.sel) && (dn[e.f] || e.f === S.sel)) onE[i] = 'out'; }
        else { if (e.t === S.sel) onE[i] = 'in'; else if (e.f === S.sel) onE[i] = 'out'; }
      });
      Object.keys(u).forEach((id) => { hl[id] = 1; up[id] = 1; });
      Object.keys(dn).forEach((id) => { hl[id] = 1; down[id] = 1; });
    }
    map.classList.toggle('dim', any);
    Object.keys(hl).forEach((id) => $('b-' + id)?.classList.add('hl'));
    Object.keys(up).forEach((id) => $('b-' + id)?.classList.add('up'));
    Object.keys(down).forEach((id) => $('b-' + id)?.classList.add('down'));
    if (S.sel) $('b-' + S.sel)?.classList.add('sel');
    svg.classList.toggle('hide-rest', S.mode !== 'all');
    svg.style.display = S.mode === 'off' && !any ? 'none' : '';
    E.forEach((e, i) => {
      const p = paths[i]; if (!p) return; const o = onE[i]; p.removeAttribute('style');
      let cls = e.fb ? 'fb' : '';
      if (o === 'in') { cls += ' on-in'; p.setAttribute('marker-end', 'url(#m-in)'); }
      else if (o === 'out') { cls += ' on-out'; p.setAttribute('marker-end', 'url(#m-out)'); }
      else if (o === 'crit') { cls += ' on-crit'; p.setAttribute('marker-end', 'url(#m-red)'); }
      else if (o && o.indexOf('loop:') === 0) { const L = loopBy[o.slice(5)]; cls += ' on-loop'; p.style.stroke = L.c; p.setAttribute('marker-end', `url(#m-${L.k})`); }
      else p.setAttribute('marker-end', 'url(#m-e)');
      p.setAttribute('class', cls.trim());
      if (o) svg.appendChild(p);
    });
  }

  // ---- drawer ----
  let hist: string[] = [];
  const laneChip = (k: string) => `<button type="button" class="lanechip" data-lane="${esc(k)}" style="${lc(k)}"><i></i>${esc(laneBy[k]?.n ?? k)}</button>`;
  function srcChip(id: string) {
    if (id.indexOf('X:') === 0) return `<span class="src ext">EXT · ${esc(id.slice(2))}</span>`;
    const b = byId[id]; if (!b) return `<span class="src ext">${esc(id)}</span>`;
    return `<button type="button" class="src" data-go="${esc(id)}" style="${lc(b.l)}" title="${esc(b.n)}"><i></i>${esc(id)}</button>`;
  }
  function flowIn(b: Block) {
    return b.in.map((x) => {
      const f = x[0].indexOf('X:') === 0 ? null : byId[x[0]];
      return `<li style="--fc:${f ? laneBy[f.l].c : 'var(--line2)'}">${srcChip(x[0])}<div class="txt">${esc(x[1])}${(x[2] || (f && f.p > b.p)) ? '<span class="fbtag">iterative</span>' : ''}<small>${f ? esc(f.n) + ' · ' + esc(laneBy[f.l].n) + ' (' + esc(f.o) + ')' : 'Outside source'}</small></div></li>`;
    }).join('');
  }
  function flowOut(b: Block) {
    const o = outs[b.id]; if (!o.length) return '<li style="--fc:var(--line2)"><span class="src ext">END</span><div class="txt">Final output of the programme</div></li>';
    return o.map((e) => { const t = byId[e.t]; return `<li style="--fc:${laneBy[t.l].c}">${srcChip(t.id)}<div class="txt">${esc(e.what)}${e.fb ? '<span class="fbtag">iterative</span>' : ''}<small>to ${esc(t.n)} · ${esc(laneBy[t.l].n)} (${esc(t.o)})</small></div></li>`; }).join('');
  }
  function detailHTML(b: Block, compact?: boolean) {
    return `<div class="sec"><h4>Why it matters</h4><p>${esc(b.why)}</p></div>`
      + `<div class="sec"><h4>Who</h4><dl class="who"><dt>Owner</dt><dd><strong>${esc(b.o)}</strong>&nbsp;${laneChip(b.l)}</dd>${b.w.length ? '<dt>Works with</dt><dd>' + b.w.map(laneChip).join('') + '</dd>' : ''}</dl></div>`
      + `<div class="sec"><h4>Needs from · ${b.in.length}</h4><ul class="flow">${flowIn(b)}</ul></div>`
      + `<div class="sec"><h4>Gives to · ${outs[b.id].length}</h4><ul class="flow">${flowOut(b)}</ul></div>`
      + `<div class="sec${compact ? ' full' : ''}"><h4>Tasks</h4><ol class="tasks">${b.tasks.map((t) => `<li>${esc(t)}</li>`).join('')}</ol></div>`
      + `<div class="sec"><h4>Tools</h4><p class="kv">${esc(b.tools)}</p></div>`
      + `<div class="sec"><h4>Rules & checks</h4><p class="kv">${esc(b.rules)}</p></div>`
      + `<div class="sec"><h4>Done when</h4><p class="kv">${esc(b.done)}</p></div>`
      + `<div class="sec"><h4>Common pitfalls</h4><ul class="pit">${b.pit.map((t) => `<li>${esc(t)}</li>`).join('')}</ul></div>`;
  }

  function progressHTML(b: Block) {
    const ownerOpts = ['<option value="">— unassigned —</option>']
      .concat(members.map((m) => `<option value="${esc(m.user_id)}"${m.user_id === b.owner_user_id ? ' selected' : ''}>${esc(m.full_name || m.email || m.user_id.slice(0, 8))}</option>`)).join('');
    const blockers = ins[b.id].filter((e) => !e.fb && byId[e.f] && byId[e.f].status !== 'done');
    return `<div class="sec"><h4>Status${readySet.has(b.id) ? ' · ready to start' : ''}</h4>
      <div class="prog">
        <div class="row">
          <select id="pr-status" aria-label="Status">${STATUS.map((s) => `<option value="${s}"${b.status === s ? ' selected' : ''}>${STATUS_LABEL[s]}</option>`).join('')}</select>
          <label>% <input id="pr-pct" type="number" min="0" max="100" step="1" value="${b.percent ?? ''}" style="width:62px" /></label>
          <select id="pr-owner" aria-label="Assigned to">${ownerOpts}</select>
        </div>
        <textarea id="pr-notes" placeholder="Notes — where this actually stands">${esc(b.notes)}</textarea>
        <div class="row"><input id="pr-tool" placeholder="Workspace tool link, e.g. ${esc(url('geometry'))}" value="${esc(b.tool_href)}" style="flex:1;min-width:150px" />${b.tool_href ? `<a class="src" href="${esc(b.tool_href)}">Open ↗</a>` : ''}</div>
        ${blockers.length ? `<small style="color:var(--out)">Waiting on: ${blockers.map((e) => esc(e.f)).join(', ')}</small>` : ''}
        <span class="save" id="pr-save"></span>
      </div>
    </div>`;
  }

  function openBlock(id: string, push?: boolean) {
    const b = byId[id]; if (!b) return;
    if (push !== false && S.sel && S.sel !== id) hist.push(S.sel);
    S.sel = id; S.lane = null; applyState();
    const ph = phases[b.p];
    drawer.style.cssText = lc(b.l);
    dh.innerHTML = '<button type="button" class="dclose" id="dclose" aria-label="Close">×</button>'
      + (hist.length ? `<div class="dnav"><button type="button" id="dback">← ${esc(hist[hist.length - 1])}</button></div>` : '')
      + `<div class="dmeta"><b>${esc(b.id)}</b> · ${esc(ph.key)} ${esc(ph.n)} · ${esc(laneBy[b.l].n)}</div><h2>${esc(b.n)}</h2><div class="badges">`
      + (b.crit ? '<span class="badge cp">Critical path</span>' : '')
      + `<span class="badge"><i class="st-${b.status}" style="border-radius:50%"></i>${STATUS_LABEL[b.status]}</span>`
      + b.loops.map((k) => `<span class="badge"><i style="background:${esc(loopBy[k]?.c ?? '#888')}"></i>${esc(loopBy[k]?.n ?? k)}</span>`).join('')
      + '</div>';
    db.innerHTML = progressHTML(b) + detailHTML(b) + `<div class="sec danger"><h4>Danger zone</h4><button type="button" id="pr-del">Delete this activity</button></div>`;
    db.scrollTop = 0;
    wireProgress(b);
    showDrawer();
    if (innerWidth > 700) { const el = $('b-' + id); const r = el.getBoundingClientRect(); const lim = innerWidth - drawer.offsetWidth - 24; if (r.right > lim) mapbox.scrollBy({ left: r.right - lim + 40, behavior: 'smooth' }); }
    try { history.replaceState(null, '', '#' + id); } catch (e) { /* ignore */ }
  }

  function wireProgress(b: Block) {
    const saveEl = $('pr-save');
    const say = (m: string, ok = true) => { saveEl.textContent = m; saveEl.style.color = ok ? '#35c46a' : 'var(--out)'; };
    const patch = async (p: Parameters<typeof setActivityState>[1]) => {
      say('saving…'); saveEl.style.color = 'var(--muted)';
      const err = await setActivityState(b.id, p);
      if (err) { say('failed: ' + err, false); return; }
      Object.assign(b, p);
      // reflect on the block without a full rebuild
      const blk = $('b-' + b.id);
      if (blk) {
        blk.className = blk.className.replace(/\bs-\w+/g, '').trim() + ' s-' + b.status;
        blk.querySelector('.ft .st:last-child')?.setAttribute('class', 'st st-' + b.status);
      }
      say('saved ✓');
    };
    $('pr-status').addEventListener('change', (e) => patch({ status: (e.target as HTMLSelectElement).value as Status }));
    $('pr-pct').addEventListener('change', (e) => { const v = (e.target as HTMLInputElement).value.trim(); patch({ percent: v === '' ? null : Math.max(0, Math.min(100, Number(v))) }); });
    $('pr-owner').addEventListener('change', (e) => patch({ owner_user_id: (e.target as HTMLSelectElement).value || null }));
    $('pr-notes').addEventListener('change', (e) => patch({ notes: (e.target as HTMLTextAreaElement).value.trim() || null }));
    $('pr-tool').addEventListener('change', (e) => patch({ tool_href: (e.target as HTMLInputElement).value.trim() || null }));
    $('pr-del').addEventListener('click', async () => {
      if (!confirm(`Delete ${b.id} and every hand-off attached to it? This cannot be undone.`)) return;
      const err = await deleteActivity(b.id); if (err) { say('failed: ' + err, false); return; }
      S.sel = null; closeDrawer(); await reload();
    });
  }

  function openLane(k: string) {
    const l = laneBy[k]; S.sel = null; S.lane = k; hist = []; applyState();
    const mine = B.filter((b) => b.l === k);
    const give: Record<string, number> = {}, need: Record<string, number> = {};
    E.forEach((e) => { const f = byId[e.f], t = byId[e.t]; if (f.l === k && t.l !== k) give[t.l] = (give[t.l] || 0) + 1; if (t.l === k && f.l !== k) need[f.l] = (need[f.l] || 0) + 1; });
    const support = B.filter((b) => b.l !== k && b.w.indexOf(k) >= 0);
    drawer.style.cssText = lc(k);
    dh.innerHTML = `<button type="button" class="dclose" id="dclose" aria-label="Close">×</button><div class="dmeta">Subteam duty sheet</div><h2>${esc(l.n)}</h2><div class="badges"><span class="badge">${mine.length} owned</span><span class="badge">${support.length} supporting</span></div>`;
    const cnt = (o: Record<string, number>) => Object.keys(o).sort((a, b) => o[b] - o[a]).map((x) => `<span style="display:inline-flex;gap:4px;align-items:center">${laneChip(x)}<small style="font-family:var(--f-mono);color:var(--muted)">×${o[x]}</small></span>`).join('') || '<span style="color:var(--muted)">None</span>';
    db.innerHTML = `<div class="sec"><h4>Scope</h4><p>${esc(l.s)}</p></div>`
      + `<div class="sec"><h4>Owns · in programme order</h4><ul class="flow">${mine.map((b) => `<li style="--fc:${l.c}">${srcChip(b.id)}<div class="txt">${esc(b.n)}${b.crit ? '<span class="fbtag" style="border-color:var(--red);color:var(--red)">CP</span>' : ''}<small>${esc(phases[b.p].key)} ${esc(phases[b.p].n)} · ${esc(b.o)} · ${STATUS_LABEL[b.status]}</small></div></li>`).join('')}</ul></div>`
      + `<div class="sec"><h4>Needs information from</h4><dl class="who"><dd>${cnt(need)}</dd></dl></div>`
      + `<div class="sec"><h4>Gives information to</h4><dl class="who"><dd>${cnt(give)}</dd></dl></div>`
      + (support.length ? `<div class="sec"><h4>Supports other subteams on</h4><ul class="flow">${support.map((b) => `<li style="--fc:${laneBy[b.l].c}">${srcChip(b.id)}<div class="txt">${esc(b.n)}<small>owned by ${esc(laneBy[b.l].n)}</small></div></li>`).join('')}</ul></div>` : '');
    db.scrollTop = 0; showDrawer();
  }

  function showDrawer() { drawer.classList.add('open'); drawer.setAttribute('aria-hidden', 'false'); if (innerWidth <= 700) scrim.classList.add('on'); }
  function closeDrawer() { drawer.classList.remove('open'); drawer.setAttribute('aria-hidden', 'true'); scrim.classList.remove('on'); S.sel = null; S.lane = null; hist = []; applyState(); try { history.replaceState(null, '', location.pathname + location.search); } catch (e) { /* ignore */ } }
  function goTo(id: string) { openBlock(id); const el = $('b-' + id); const r = el.getBoundingClientRect(), rb = mapbox.getBoundingClientRect(); mapbox.scrollTo({ left: mapbox.scrollLeft + (r.left - rb.left) - rb.width / 2 + r.width / 2 + (innerWidth > 700 ? -200 : 0), behavior: 'smooth' }); if (r.top < 80 || r.bottom > innerHeight - 40) window.scrollTo({ top: scrollY + r.top - innerHeight / 3, behavior: 'smooth' }); }

  // ---- loop cards / matrix / register ----
  function renderBelow() {
    $('loopcount').textContent = `${loops.length} loops`;
    $('loopchips').innerHTML = loops.map((L) => `<button type="button" class="lchip" data-loop="${esc(L.k)}" aria-pressed="${S.loop === L.k}"><i style="background:${esc(L.c)}"></i>${esc(L.n)}</button>`).join('');
    $('loopcards').innerHTML = loops.map((L) => `<button type="button" class="loopcard" data-loopcard="${esc(L.k)}" style="--lpc:${esc(L.c)}"><h3><i></i>${esc(L.n)}<small>${esc(L.k)}</small></h3><p>${esc(L.d)}</p><span class="ids">${L.b.map((id) => `<span>${esc(id)}</span>`).join('')}</span></button>`).join('');

    const M: Record<string, Edge[]> = {}; E.forEach((e) => { const k = byId[e.f].l + '>' + byId[e.t].l; (M[k] = M[k] || []).push(e); });
    let maxv = 0; Object.keys(M).forEach((k) => { const a = k.split('>'); if (a[0] !== a[1]) maxv = Math.max(maxv, M[k].length); });
    let mh = `<thead><tr><th class="corner2">Gives ↓ · Receives →</th>${lanes.map((l) => `<th style="${lc(l.k)}"><i></i>${esc(l.k)}</th>`).join('')}</tr></thead><tbody>`;
    lanes.forEach((a) => {
      mh += `<tr><th style="${lc(a.k)}"><i style="width:30px"></i>${esc(a.n)}</th>`;
      lanes.forEach((b) => { const k = a.k + '>' + b.k, n = (M[k] || []).length; const alpha = a.k === b.k ? 0 : (maxv ? n / maxv : 0);
        mh += `<td class="${a.k === b.k ? 'diag' : ''}" style="background:${n && a.k !== b.k ? 'color-mix(in srgb,var(--red) ' + Math.round(10 + alpha * 60) + '%,transparent)' : 'transparent'}">${n ? `<button type="button" data-mx="${esc(k)}" aria-pressed="false" title="${esc(a.n)} → ${esc(b.n)}">${n}</button>` : ''}</td>`; });
      mh += '</tr>';
    });
    $('mx').innerHTML = mh + '</tbody>';

    $('regcount').textContent = `${B.length} activities`;
    $('reg').innerHTML = lanes.map((l) => { const mine = B.filter((b) => b.l === l.k);
      return `<div class="reglane" style="${lc(l.k)}"><h3><i></i>${esc(l.n)}<small>${mine.length} ACTIVITIES</small></h3>`
        + mine.map((b) => `<details class="act" id="r-${esc(b.id)}"><summary><span class="i">${esc(b.id)}</span><span class="n">${esc(b.n)}${b.crit ? ' <span class="fbtag" style="border-color:var(--red);color:var(--red)">CP</span>' : ''}</span><span class="p">${esc(phases[b.p].key)} · ${STATUS_LABEL[b.status]}</span></summary><div class="in">${detailHTML(b, true)}</div></details>`).join('') + '</div>';
    }).join('');
  }

  let firstHand = true;
  function showHand(k: string) {
    const M: Record<string, Edge[]> = {}; E.forEach((e) => { const kk = byId[e.f].l + '>' + byId[e.t].l; (M[kk] = M[kk] || []).push(e); });
    if (!M[k]) { const avail = Object.keys(M).find((x) => x.split('>')[0] !== x.split('>')[1]); if (!avail) { $('handoffs').innerHTML = ''; return; } k = avail; }
    document.querySelectorAll('[data-mx]').forEach((b) => b.setAttribute('aria-pressed', String((b as HTMLElement).dataset.mx === k)));
    const a = k.split('>');
    $('handoffs').innerHTML = `<div class="hh">${esc(laneBy[a[0]].n)} → ${esc(laneBy[a[1]].n)} · ${M[k].length} handoffs</div>`
      + M[k].map((e) => { const f = byId[e.f], t = byId[e.t]; return `<div class="ho"><div class="pair"><button type="button" data-go="${esc(f.id)}">${esc(f.id)}</button>→<button type="button" data-go="${esc(t.id)}">${esc(t.id)}</button></div><div class="what">${esc(e.what)}${e.fb ? '<span class="fbtag">iterative</span>' : ''}<small>${esc(f.n)} (${esc(f.o)}) → ${esc(t.n)} (${esc(t.o)})</small></div></div>`; }).join('');
  }

  // ---- manage ----
  const GATE_FALLBACK = ['G0', 'G1', 'G2', 'G3', 'G4', 'G5', 'G6', 'G7', 'G8', 'G9'];
  function renderManage() {
    const say = (m: string, ok = true) => { const el = $('tm-manage-status'); el.textContent = m; el.style.color = ok ? '#35c46a' : 'var(--out)'; };
    const bucketOpts = lanes.map((l) => `<option value="${esc(l.k)}">${esc(l.k)} · ${esc(l.n)}</option>`).join('');
    const phaseOpts = phases.map((p) => `<option value="${esc(p.key)}">${esc(p.key)} · ${esc(p.n)}</option>`).join('');
    const gateList = gates.length ? gates.map((g) => g.id) : GATE_FALLBACK;
    $('manage').innerHTML = `
      <div class="mrow">
        <button type="button" class="seedbtn go" id="tm-seed-fill">Load / refresh from seed</button>
        <button type="button" class="seedbtn" id="tm-seed-reset">Reset to seed (loses progress)</button>
      </div>
      <form class="mrow" id="tm-add-act">
        <label>Code<input id="na-code" required placeholder="VD17" /></label>
        <label style="flex:1;min-width:180px">Title<input id="na-title" required style="width:100%" /></label>
        <label>Subteam<select id="na-bucket">${bucketOpts}</select></label>
        <label>Phase<select id="na-phase">${phaseOpts}</select></label>
        <label>Owner role<input id="na-owner" /></label>
        <label style="flex-direction:row;align-items:center;gap:4px"><input type="checkbox" id="na-crit" /> critical</label>
        <button type="submit">Add activity</button>
      </form>
      <form class="mrow" id="tm-add-dep">
        <label>From<input id="nd-from" required list="tm-codes" placeholder="VD3" /></label>
        <label>To<input id="nd-to" required list="tm-codes" placeholder="CH2" /></label>
        <label style="flex:1;min-width:180px">What is handed over<input id="nd-label" style="width:100%" /></label>
        <label style="flex-direction:row;align-items:center;gap:4px"><input type="checkbox" id="nd-fb" /> feedback</label>
        <button type="submit">Add hand-off</button>
      </form>
      <datalist id="tm-codes">${B.map((b) => `<option value="${esc(b.id)}">${esc(b.n)}</option>`).join('')}</datalist>
      <div class="mrow" id="tm-gatemap">${phases.map((p) => `<label>${esc(p.key)} → gate<select data-gate-for="${esc(p.key)}"${lead ? '' : ' disabled title="Lead action"'}><option value="">— none —</option>${gateList.map((g) => `<option value="${g}"${false ? ' selected' : ''}>${g}</option>`).join('')}</select></label>`).join('')}</div>`;

    $('tm-seed-fill').addEventListener('click', async () => { say('loading…'); ($('tm-manage-status') as HTMLElement).style.color = 'var(--muted)'; const r = await seedTaskmap('fill'); if (r.error) return say('failed: ' + r.error, false); say(`loaded ${r.counts.activities} activities ✓`); await reload(); });
    $('tm-seed-reset').addEventListener('click', async () => { if (!confirm('Delete every activity (status, owners, notes) and reload the seed?')) return; if (!confirm('This cannot be undone. Really reset?')) return; const r = await seedTaskmap('reset'); if (r.error) return say('failed: ' + r.error, false); say(`reset: ${r.counts.activities} activities ✓`); await reload(); });
    ($('tm-add-act') as HTMLFormElement).addEventListener('submit', async (e) => { e.preventDefault(); const code = ($('na-code') as HTMLInputElement).value.trim(), title = ($('na-title') as HTMLInputElement).value.trim(); if (!code || !title) return; const err = await createActivity({ code, title, bucket_key: ($('na-bucket') as HTMLSelectElement).value, phase_key: ($('na-phase') as HTMLSelectElement).value, owner_role: ($('na-owner') as HTMLInputElement).value.trim() || null, is_critical: ($('na-crit') as HTMLInputElement).checked } as any); if (err) return say(err.includes('duplicate') ? `"${code}" exists` : 'failed: ' + err, false); say(`${code} added ✓`); await reload(); });
    ($('tm-add-dep') as HTMLFormElement).addEventListener('submit', async (e) => { e.preventDefault(); const from = ($('nd-from') as HTMLInputElement).value.trim(), to = ($('nd-to') as HTMLInputElement).value.trim(); if (!byId[from] || !byId[to]) return say('both codes must exist', false); const err = await addDependency({ from_code: from, to_code: to, label: ($('nd-label') as HTMLInputElement).value.trim(), is_feedback: ($('nd-fb') as HTMLInputElement).checked }); if (err) return say(err, false); say(`${from} → ${to} added ✓`); await reload(); });
    $('tm-gatemap').querySelectorAll<HTMLSelectElement>('[data-gate-for]').forEach((sel) => { const pk = sel.dataset.gateFor!; const cur = phases.find((p) => p.key === pk)?.gate_key; if (cur) sel.value = cur; sel.addEventListener('change', async () => { const err = await setPhaseGate(pk, sel.value || null); if (err) return say(/row-level|permission/i.test(err) ? 'lead only' : 'failed: ' + err, false); say('gate mapping saved ✓'); await reload(); }); });
  }

  // ---- render all ----
  function renderAll() { renderGrid(); renderBelow(); renderManage(); drawEdges(); if (firstHand) { showHand('VD>CH'); firstHand = false; } else showHand((document.querySelector('[data-mx][aria-pressed="true"]') as HTMLElement)?.dataset.mx || 'VD>CH'); if (S.sel && byId[S.sel]) openBlock(S.sel, false); }

  async function reload(announce = false) {
    const data = await loadTaskmap();
    const al = $('tm-alert');
    if (data.error) { al.hidden = false; al.innerHTML = `<b>Task Map unavailable.</b> ${esc(data.error)}`; return; }
    if (!data.activities.length) { al.hidden = false; al.innerHTML = '<b>The map is empty.</b> Use “Load / refresh from seed” in Manage below to load the authored programme (13 subteams, 10 phases, 109 activities, 385 hand-offs).'; }
    else al.hidden = true;
    build(data);
    renderAll();
    if (announce) liveToast('Task Map updated.');
  }

  // ---- one-time wiring ----
  document.addEventListener('click', (ev) => {
    const t = (ev.target as HTMLElement).closest('[data-id],[data-go],[data-lane],[data-loopcard],[data-mx],#dclose,#dback,#scrim') as HTMLElement | null;
    if (!t) return;
    if (t.id === 'dclose' || t.id === 'scrim') return closeDrawer();
    if (t.id === 'dback') { const p = hist.pop(); if (p) { goTo(p); hist.pop(); } return; }
    if (t.dataset.id) return openBlock(t.dataset.id);
    if (t.dataset.go) return goTo(t.dataset.go);
    if (t.dataset.lane) return openLane(t.dataset.lane);
    if (t.dataset.loopcard) { setLoop(t.dataset.loopcard); mapbox.scrollIntoView({ behavior: 'smooth', block: 'start' }); return; }
    if (t.dataset.mx) return showHand(t.dataset.mx);
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDrawer(); });

  document.querySelectorAll('#linkmode button').forEach((btn) => btn.addEventListener('click', () => { S.mode = (btn as HTMLElement).dataset.v!; document.querySelectorAll('#linkmode button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn))); applyState(); }));
  const tog = (id: string, key: 'crit' | 'chain' | 'unblocked') => { const b = $(id); b.addEventListener('click', () => { S[key] = !S[key]; b.setAttribute('aria-pressed', String(S[key])); applyState(); }); };
  tog('crit', 'crit'); tog('chain', 'chain'); tog('unblocked', 'unblocked');
  function setLoop(k: string) { S.loop = S.loop === k ? null : k; document.querySelectorAll('[data-loop]').forEach((b) => b.setAttribute('aria-pressed', String((b as HTMLElement).dataset.loop === S.loop))); applyState(); }
  $('loopchips').addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest('[data-loop]') as HTMLElement | null; if (b) setLoop(b.dataset.loop!); });
  const q = $('q') as HTMLInputElement; q.addEventListener('input', () => { S.q = q.value.trim(); applyState(); });
  $('expandall').addEventListener('click', () => document.querySelectorAll('details.act').forEach((d) => (d as HTMLDetailsElement).open = true));
  $('collapseall').addEventListener('click', () => document.querySelectorAll('details.act').forEach((d) => (d as HTMLDetailsElement).open = false));

  let rt: ReturnType<typeof setTimeout>; const redraw = () => { clearTimeout(rt); rt = setTimeout(drawEdges, 60); };
  addEventListener('resize', redraw);

  (async () => {
    const [role, ms, gs] = await Promise.all([myRole(), loadMembers(), loadGates()]);
    lead = role.role === 'lead'; members = ms; gates = gs;
    await reload();
    if (document.fonts && (document.fonts as any).ready) (document.fonts as any).ready.then(drawEdges);
    const h = (location.hash || '').slice(1); if (h && byId[h]) setTimeout(() => goTo(h), 300);
    subscribeLive({ name: 'taskmap', tables: ['taskmap_activities', 'taskmap_dependencies', 'gates'], onChange: async () => { gates = await loadGates(); await reload(true); } });
  })();
</script>
