---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import LegendKey from '../components/LegendKey.astro';
import WorkbookDownload from '../components/WorkbookDownload.astro';
import { DISCIPLINES, url } from '../lib/config';

// One static page per discipline (BRIEF §D). Calculators are stubbed as tool
// cards here; each is built from TOOL_SPECS.md in a later step.
export function getStaticPaths() {
  return DISCIPLINES.map((d) => ({ params: { discipline: d.slug }, props: { discipline: d } }));
}

const { discipline } = Astro.props;
---
<Base title={discipline.title} description={discipline.blurb}>
  <nav class="annot" style="margin-bottom:0.75rem;">
    <a href={url('')} style="color:inherit;">Home</a> / {discipline.title}
  </nav>

  <header style="margin-bottom:1.5rem;">
    <p class="annot annot-tick">Discipline</p>
    <h1 style="margin-top:0.4rem;">{discipline.title}</h1>
    <p style="color:var(--ink-2);margin-top:0.5rem;">{discipline.blurb}</p>

    <div style="display:flex;gap:0.75rem;flex-wrap:wrap;align-items:center;margin-top:1.1rem;">
      {discipline.workbook && <WorkbookDownload file={discipline.workbook} />}
    </div>
  </header>

  <div class="notice" style="margin-bottom:1.5rem;">
    <strong>Shared numbers come from Vehicle Spec.</strong> Linked fields are
    read-only here; edit them in <a href={url('vehicle-spec')}>Vehicle Spec</a>.
    Nothing below is a validated result until its calculator is built and
    cross-checked against the workbook.
  </div>

  <LegendKey />

  <section class="grid" style="margin-top:1.5rem;grid-template-columns:repeat(auto-fill,minmax(min(100%,340px),1fr));">
    {discipline.tools.map((t) => <ToolCard tool={t} />)}
  </section>
</Base>
