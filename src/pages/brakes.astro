---
import Base from '../layouts/Base.astro';
import ToolTabs from '../components/ToolTabs.astro';
import { url } from '../lib/config';
import { MC_PRESETS, CALIPER_PRESETS } from '../lib/calc/brakes';

const LINKED = [
  { k: 'mass_total', l: 'Mass', s: 'm', u: 'kg' },
  { k: 'mass_frac_front', l: 'Front fraction', s: 'ff', u: '-' },
  { k: 'cog_height', l: 'CoG height', s: 'h', u: 'mm' },
  { k: 'wheelbase', l: 'Wheelbase', s: 'L', u: 'mm' },
  { k: 'mu_lat_peak', l: 'Peak μ', s: 'μ', u: '-' },
  { k: 'rolling_radius', l: 'Rolling radius', s: 'Re', u: 'mm' },
];
const INPUTS = [
  { key: 'pedalForce', label: 'Pedal force', unit: 'N', f: 400, r: 400 },
  { key: 'pedalRatio', label: 'Pedal ratio', unit: '-', f: 5, r: 5 },
  { key: 'mcBore', label: 'Master-cyl bore', unit: 'mm', f: 15.875, r: 15.875 },
  { key: 'circuits', label: 'Circuits fed', unit: '-', f: 2, r: 2 },
  { key: 'caliperBore', label: 'Caliper piston bore', unit: 'mm', f: 25, r: 25 },
  { key: 'pistons', label: 'Pistons per side', unit: '-', f: 2, r: 1 },
  { key: 'padMu', label: 'Pad friction μ', unit: '-', f: 0.45, r: 0.45 },
  { key: 'rotorOd', label: 'Rotor outer dia', unit: 'mm', f: 180, r: 180 },
  { key: 'padDepth', label: 'Pad radial depth', unit: 'mm', f: 27, r: 27 },
];
const OUTPUTS = [
  { key: 'pushrodForce', label: 'Pushrod force', unit: 'N' },
  { key: 'linePressureKpa', label: 'Line pressure', unit: 'kPa' },
  { key: 'clamp', label: 'Clamp force', unit: 'N' },
  { key: 'friction', label: 'Friction force', unit: 'N' },
  { key: 'effRadius', label: 'Effective radius', unit: 'm' },
  { key: 'brakeTorque', label: 'Brake torque / wheel', unit: 'N·m' },
];
const ni = 'width:84px;text-align:right;font-family:var(--font-mono);background:var(--surface-2);border:1px solid var(--rule);border-radius:var(--radius-sm);color:var(--ink);padding:0.22rem 0.4rem;';
const sel = 'font-family:var(--font-mono);font-size:var(--fs-300);background:var(--surface-2);border:1px solid var(--rule-strong);border-radius:var(--radius);color:var(--ink);padding:0.25rem 0.4rem;';
---
<Base title="Brake System">
  <nav class="annot" style="margin-bottom:0.75rem;">
    <a href={url('vehicle-dynamics')} style="color:inherit;">VD Workspace</a> / Brake System
  </nav>
  <header style="margin-bottom:1rem;">
    <p class="annot annot-tick">Pedal → master cylinder → caliper → rotor</p>
    <h1 style="margin-top:0.4rem;">Brake System</h1>
    <p style="color:var(--ink-2);margin-top:0.5rem;max-width:74ch;">
      Size the hydraulics, then check achieved vs Olley-optimum bias across a
      deceleration sweep. Shared inputs come from the Master. Advanced (Magic-
      Formula + rolling/skidding + thermal) lands in a follow-up.
    </p>
  </header>

  <div class="card" style="margin-bottom:1rem;">
    <span class="annot">From Master</span>
    <div style="display:flex;gap:1.4rem;flex-wrap:wrap;margin-top:0.4rem;font-size:var(--fs-300);">
      {LINKED.map((l) => (
        <span>{l.l} <span class="mono" style="color:var(--ink-3)">({l.s})</span>
          <span class="field field-linked mono" data-master={l.k} style="margin-left:0.35rem;">—</span> {l.u}</span>
      ))}
    </div>
  </div>

  <div class="card">
    <ToolTabs tabs={[{ id: 'sizing', label: 'Sizing' }, { id: 'bias', label: 'Bias sweep' }, { id: 'adv', label: 'Advanced' }]}>
      <!-- SIZING -->
      <div data-tab-panel="sizing">
        <div style="display:flex;gap:1rem;flex-wrap:wrap;align-items:flex-end;margin-bottom:0.6rem;">
          <label style="font-size:var(--fs-300);">Target decel (g)
            <input type="number" step="any" id="target-decel" value="1.2" style={ni + 'display:block;margin-top:0.2rem;'} />
            <span id="target-decel-note" class="mono" style="display:block;margin-top:0.2rem;font-size:var(--fs-200);color:var(--ink-3);"></span></label>
          <label style="font-size:var(--fs-300);">MC preset
            <select id="mc-preset" style={sel + 'display:block;margin-top:0.2rem;'}>
              <option value="">— custom —</option>
              {Object.keys(MC_PRESETS).map((n) => <option value={n}>{n}</option>)}
            </select></label>
          <label style="font-size:var(--fs-300);">Caliper preset
            <select id="cal-preset" style={sel + 'display:block;margin-top:0.2rem;'}>
              <option value="">— custom —</option>
              {Object.keys(CALIPER_PRESETS).map((n) => <option value={n}>{n}</option>)}
            </select></label>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.4rem 1.5rem;align-items:start;" class="ct-body">
          <div>
            <h3 class="ct-h3">Inputs</h3>
            <div class="ct-wrap"><table class="ct-table"><thead><tr><th>Parameter</th><th class="ct-num">Front</th><th class="ct-num">Rear</th><th>Unit</th></tr></thead>
              <tbody>{INPUTS.map((i) => (
                <tr><td>{i.label}</td>
                  <td class="ct-num"><input type="number" step="any" style={ni} data-in={`f_${i.key}`} value={i.f} aria-label={`${i.label} front`} /></td>
                  <td class="ct-num"><input type="number" step="any" style={ni} data-in={`r_${i.key}`} value={i.r} aria-label={`${i.label} rear`} /></td>
                  <td class="ct-unit">{i.unit}</td></tr>
              ))}</tbody></table></div>
          </div>
          <div>
            <div class="ct-stats">
              <div class="ct-stat"><span class="annot">Achieved front bias</span><div class="val"><span data-out="achievedFrontBias">—</span></div></div>
              <div class="ct-stat"><span class="annot">Optimal @ target</span><div class="val"><span data-out="optimalBiasTarget">—</span></div></div>
              <div class="ct-stat"><span class="annot">Recommended front MC Ø</span><div class="val"><span data-out="recommendedMcDia">—</span><span class="ct-unit" style="font-size:var(--fs-400)"> mm</span></div><span class="ct-ref">sizing aid</span></div>
              <div class="ct-stat"><span class="annot">Dyn load F / R</span><div class="val" style="font-size:var(--fs-500)"><span data-out="dynFront">—</span> / <span data-out="dynRear">—</span></div></div>
            </div>
            <h3 class="ct-h3">Outputs</h3>
            <div class="ct-wrap"><table class="ct-table"><thead><tr><th>Result</th><th class="ct-num">Front</th><th class="ct-num">Rear</th><th>Unit</th></tr></thead>
              <tbody>{OUTPUTS.map((o) => (
                <tr><td>{o.label}</td>
                  <td class="ct-num"><span class="field field-computed mono" data-out={`f_${o.key}`}>—</span></td>
                  <td class="ct-num"><span class="field field-computed mono" data-out={`r_${o.key}`}>—</span></td>
                  <td class="ct-unit">{o.unit}</td></tr>
              ))}</tbody></table></div>
            <p style="margin-top:0.7rem;"><button class="btn btn-heritage" type="button" id="brk-contribute">Contribute to Master</button>
              <span class="mono" id="brk-contribute-status" style="margin-left:0.6rem;font-size:var(--fs-200);color:var(--ink-3);"></span></p>
          </div>
        </div>
      </div>

      <!-- BIAS SWEEP -->
      <div data-tab-panel="bias" hidden>
        <h3 class="ct-h3">Achieved vs optimal front bias — deceleration sweep</h3>
        <p style="color:var(--ink-2);font-size:var(--fs-300);">Optimal = ff + a·h/L per the Master; achieved is the hardware torque ratio (fixed here). Where <strong>achieved &lt; optimal</strong> the front is under-braked, so the <strong>rear locks first</strong> — shaded as the danger zone. Aim to sit slightly front-biased at your peak decel.</p>
        <div class="ct-stat" style="margin:0.5rem 0;max-width:360px;">
          <span class="annot">Recommended bias @ target decel</span>
          <div class="val"><span id="bias-reco">—</span></div>
          <span class="ct-ref" id="bias-reco-note"></span>
        </div>
        <div style="height:300px;position:relative;margin-top:0.5rem;"><canvas id="bias-chart"></canvas></div>
      </div>

      <!-- ADVANCED -->
      <div data-tab-panel="adv" hidden>
        <div class="notice" style="margin-bottom:1rem;">
          <strong>What this tab is for.</strong> Sizing and Bias use one peak-grip
          number (μ) — all that brake sizing needs, and it matches the team's brake
          workbooks. This tab adds what a constant-μ model can't: using the
          longitudinal tyre curve (the Magic Formula) it shows <em>whether a wheel
          locks and which axle locks first</em>, and estimates rotor heat. It is
          optional — skip it and you lose nothing for sizing. It only means
          something with <strong>your own longitudinal tyre coefficients from the
          TTC fit</strong>; the defaults below are placeholders, not real numbers.
        </div>

        <div class="ct-body">
          <div class="ct-col">
            <h3 class="ct-h3">Longitudinal tyre (Magic Formula)</h3>
            <p style="color:var(--ink-2);font-size:var(--fs-300);">Fx vs slip ratio κ (−1 = locked → 0 = rolling). Grip peaks near κ ≈ −0.1 then falls toward lock. Enter B, C, peak μx and E from your TTC longitudinal fit; Fz is the wheel's vertical load.</p>
            <div class="ct-wrap"><table class="ct-table"><tbody>
              <tr><td>Stiffness B</td><td class="ct-num"><input type="number" step="any" style={ni} data-in="adv_B" value="10" /></td><td class="ct-ref" title="longitudinal TTC fit">your fit</td></tr>
              <tr><td>Shape C</td><td class="ct-num"><input type="number" step="any" style={ni} data-in="adv_C" value="1.6" /></td><td class="ct-ref">1.5–1.8</td></tr>
              <tr><td>Peak μx (D = μx·Fz)</td><td class="ct-num"><input type="number" step="any" style={ni} data-in="adv_muX" value="1.5" /></td><td class="ct-ref">1.4–1.6 (belt)</td></tr>
              <tr><td>Curvature E</td><td class="ct-num"><input type="number" step="any" style={ni} data-in="adv_E" value="0.95" /></td><td class="ct-ref">~1.0</td></tr>
              <tr><td>Wheel vertical load Fz</td><td class="ct-num"><input type="number" step="any" style={ni} data-in="adv_Fz" value="1500" /></td><td class="ct-unit">N</td></tr>
            </tbody></table></div>

            <h3 class="ct-h3">Thermal — one stop</h3>
            <p style="color:var(--ink-2);font-size:var(--fs-300);">KE lost → rotor heat. ΔT = energy ÷ (rotor mass × specific heat). Keep peak temp below the pad/rotor fade limit.</p>
            <div class="ct-wrap"><table class="ct-table"><tbody>
              <tr><td>Speed before / after</td><td class="ct-num"><input type="number" step="any" style={ni} data-in="adv_v1" value="100" /></td><td class="ct-num"><input type="number" step="any" style={ni} data-in="adv_v2" value="30" /></td><td class="ct-unit">km/h</td></tr>
              <tr><td>Rotors</td><td class="ct-num"><input type="number" step="any" style={ni} data-in="adv_nRotors" value="4" /></td><td></td><td class="ct-unit">-</td></tr>
              <tr><td>Rotor mass (each)</td><td class="ct-num"><input type="number" step="any" style={ni} data-in="adv_rotorMass" value="0.8" /></td><td></td><td class="ct-unit">kg</td></tr>
              <tr><td>Specific heat cp</td><td class="ct-num"><input type="number" step="any" style={ni} data-in="adv_cp" value="460" /></td><td class="ct-ref">steel ~460</td><td class="ct-unit">J/kg·K</td></tr>
              <tr><td>Ambient / fade limit</td><td class="ct-num"><input type="number" step="any" style={ni} data-in="adv_ambient" value="40" /></td><td class="ct-num"><input type="number" step="any" style={ni} data-in="adv_maxTemp" value="600" /></td><td class="ct-unit">°C</td></tr>
            </tbody></table></div>
          </div>

          <div class="ct-col">
            <h3 class="ct-h3">Fx vs slip</h3>
            <div style="height:200px;position:relative;"><canvas id="fx-chart"></canvas></div>

            <h3 class="ct-h3">Lock-up</h3>
            <p style="color:var(--ink-2);font-size:var(--fs-300);">With your achieved bias (from Sizing) and peak μx, the axle whose grip is exceeded first caps deceleration. Rear-first → unstable (ease front bias); front-first → grip left unused. ABS/bias-bar shifts this.</p>
            <div class="ct-stats">
              <div class="ct-stat"><span class="annot">Achievable decel</span><div class="val"><span data-out="adv_achievable">—</span><span class="ct-unit" style="font-size:var(--fs-400)"> g</span></div></div>
              <div class="ct-stat"><span class="annot">First to lock</span><div class="val" style="font-size:var(--fs-500)"><span data-out="adv_first">—</span></div></div>
              <div class="ct-stat"><span class="annot">Front / rear lock @</span><div class="val" style="font-size:var(--fs-500)"><span data-out="adv_aFront">—</span> / <span data-out="adv_aRear">—</span> g</div></div>
            </div>

            <h3 class="ct-h3">Rotor heat</h3>
            <div class="ct-stats">
              <div class="ct-stat"><span class="annot">Energy / stop</span><div class="val"><span data-out="adv_energy">—</span><span class="ct-unit" style="font-size:var(--fs-400)"> J</span></div></div>
              <div class="ct-stat"><span class="annot">Rotor ΔT</span><div class="val"><span data-out="adv_deltaT">—</span><span class="ct-unit" style="font-size:var(--fs-400)"> K</span></div></div>
              <div class="ct-stat"><span class="annot">Peak temp</span><div class="val"><span data-out="adv_peakTemp">—</span><span class="ct-unit" style="font-size:var(--fs-400)"> °C</span></div></div>
              <div class="ct-stat"><span class="annot">Fade margin</span><div class="val"><span data-out="adv_fade">—</span><span class="ct-unit" style="font-size:var(--fs-400)"> K</span></div></div>
            </div>
          </div>
        </div>
      </div>
    </ToolTabs>
    <p class="mono" data-save-status style="margin-top:0.8rem;font-size:var(--fs-200);color:var(--ink-3);"></p>
  </div>
</Base>

<script>
  import Chart from 'chart.js/auto';
  import { computeBrakeSystem, biasSweep, fxCurve, lockupDecel, brakeThermal, MC_PRESETS, CALIPER_PRESETS, type BrakeSystemMaster } from '../lib/calc/brakes';
  import type { BrakeSide } from '../lib/calc/vd-brakes';
  import { loadMaster, saveToolJson, loadToolJson, saveToolOutputs, fmt, debounce } from '../lib/store';
  import { decorateLinkedCells } from '../lib/linked';
  import { applyChartDefaults, palette, watchTheme } from '../lib/chart-theme';

  const TOOL = 'brakes';
  const saveStatus = document.querySelector('[data-save-status]') as HTMLElement;
  let master: Record<string, number> = {};
  let chart: Chart | null = null;
  let fxChart: Chart | null = null;
  let last: any = {};
  const gi = (k: string) => Number((document.querySelector(`[data-in="${k}"]`) as HTMLInputElement)?.value);
  const setText = (k: string, s: string) => { const el = document.querySelector(`[data-out="${k}"]`); if (el) el.textContent = s; };

  const side = (p: string): BrakeSide => {
    const g = (f: string) => Number((document.querySelector(`[data-in="${p}_${f}"]`) as HTMLInputElement)?.value);
    return { pedalForce: g('pedalForce'), pedalRatio: g('pedalRatio'), mcBore: g('mcBore'), circuits: g('circuits'), caliperBore: g('caliperBore'), pistons: g('pistons'), padMu: g('padMu'), rotorOd: g('rotorOd'), padDepth: g('padDepth') };
  };
  const put = (k: string, v: number, d = 2) => { const el = document.querySelector(`[data-out="${k}"]`); if (el) el.textContent = v === null || !Number.isFinite(v) ? '—' : fmt(v, d); };

  function recompute() {
    // Sizing target decel is linked to Master accel_brake_target when set;
    // otherwise it falls back to the local input.
    const localDecel = Number((document.getElementById('target-decel') as HTMLInputElement).value) || 1;
    const targetDecel = Number.isFinite(master.accel_brake_target) ? master.accel_brake_target : localDecel;
    const m: BrakeSystemMaster = {
      ff: master.mass_frac_front, h: master.cog_height, L: master.wheelbase,
      mu: master.mu_lat_peak, tyreRadius: master.rolling_radius, mass: master.mass_total,
    };
    const r = computeBrakeSystem(side('f'), side('r'), m, targetDecel);
    last = r;
    (['pushrodForce', 'linePressureKpa', 'clamp', 'friction', 'effRadius', 'brakeTorque'] as const).forEach((k) => {
      put(`f_${k}`, r[`f_${k}`] as number, k === 'effRadius' ? 4 : 2);
      put(`r_${k}`, r[`r_${k}`] as number, k === 'effRadius' ? 4 : 2);
    });
    put('achievedFrontBias', r.achievedFrontBias as number, 3);
    put('optimalBiasTarget', r.optimalBiasTarget as number, 3);
    put('recommendedMcDia', r.recommendedMcDia as number, 1);
    put('dynFront', r.dynFront as number, 0);
    put('dynRear', r.dynRear as number, 0);
    renderChart(m, r.achievedFrontBias as number);
  }

  function renderChart(m: BrakeSystemMaster, achieved: number) {
    const p = palette();
    const sweep = biasSweep(achieved, m);
    // Recommended bias = optimal at the target decel (Master accel_brake_target, else local).
    const aTarget = Number.isFinite(master.accel_brake_target) ? master.accel_brake_target
      : (Number(((document.getElementById('target-decel') as HTMLInputElement)?.value)) || 1);
    const reco = Number.isFinite(m.ff) && Number.isFinite(m.h) && Number.isFinite(m.L) ? m.ff + aTarget * (m.h / m.L) : NaN;
    const recoEl = document.getElementById('bias-reco'); const recoNote = document.getElementById('bias-reco-note');
    if (recoEl) recoEl.textContent = Number.isFinite(reco) ? reco.toFixed(3) : '—';
    if (recoNote) recoNote.textContent = Number.isFinite(reco) ? `ff + ${aTarget}·h/L — set hardware slightly above this` : 'needs ff, h, L and a target decel in Master';
    const cfg: any = {
      type: 'line',
      data: { labels: sweep.map((s) => s.g.toFixed(1)), datasets: [
        { label: 'Optimal front bias', data: sweep.map((s) => Number.isFinite(s.optimal) ? +s.optimal.toFixed(4) : null), borderColor: p.sky, backgroundColor: p.sky, tension: 0.2, pointRadius: 3 },
        { label: 'Achieved front bias', data: sweep.map((s) => Number.isFinite(s.achieved) ? +s.achieved.toFixed(4) : null), borderColor: p.amber, backgroundColor: p.amber, borderDash: [6, 4], pointRadius: 0 },
        // Danger: optimal above achieved → front under-braked → rear locks first.
        { label: 'Rear locks first (danger)', data: sweep.map((s) => (Number.isFinite(s.optimal) && Number.isFinite(s.achieved) && s.optimal > s.achieved) ? +s.optimal.toFixed(4) : null),
          borderColor: 'transparent', backgroundColor: 'rgba(155,30,34,0.18)', pointRadius: 0, fill: 1, spanGaps: false },
      ] },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { labels: { usePointStyle: true } } },
        scales: { x: { title: { display: true, text: 'deceleration (g)' } }, y: { title: { display: true, text: 'front brake bias' } } } },
    };
    if (chart) { chart.data = cfg.data; chart.update(); }
    else { const cv = document.getElementById('bias-chart') as HTMLCanvasElement | null; if (cv) chart = new Chart(cv, cfg); }
  }

  function recomputeAdvanced() {
    const coef = { B: gi('adv_B'), C: gi('adv_C'), muX: gi('adv_muX'), E: gi('adv_E') };
    const Fz = gi('adv_Fz');
    // Fx vs slip curve
    const p = palette();
    const pts = fxCurve(coef, Fz);
    const cfg: any = {
      type: 'line',
      data: { labels: pts.map((q) => q.kappa.toFixed(2)), datasets: [{ label: 'Fx (N)', data: pts.map((q) => +q.fx.toFixed(1)), borderColor: p.sky, backgroundColor: p.sky, pointRadius: 0, tension: 0.2 }] },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } },
        scales: { x: { title: { display: true, text: 'slip ratio κ (−1 locked → 0)' } }, y: { title: { display: true, text: 'Fx (N)' } } } },
    };
    if (fxChart) { fxChart.data = cfg.data; fxChart.update(); }
    else { const cv = document.getElementById('fx-chart') as HTMLCanvasElement | null; if (cv) fxChart = new Chart(cv, cfg); }

    // Lock-up (uses the achieved bias from Sizing + Master geometry + peak μx)
    const bias = Number(last.achievedFrontBias);
    const lk = lockupDecel(Number.isFinite(bias) ? bias : NaN, master.mass_frac_front, master.cog_height, master.wheelbase, coef.muX);
    put('adv_achievable', lk.achievable, 2); put('adv_aFront', lk.aFrontLock, 2); put('adv_aRear', lk.aRearLock, 2);
    setText('adv_first', Number.isFinite(lk.achievable) ? lk.firstToLock : '—');

    // Thermal (km/h → m/s)
    const t = brakeThermal({ mass: master.mass_total, v1: gi('adv_v1') / 3.6, v2: gi('adv_v2') / 3.6, nRotors: gi('adv_nRotors'), rotorMass: gi('adv_rotorMass'), cp: gi('adv_cp'), maxTemp: gi('adv_maxTemp'), ambient: gi('adv_ambient') });
    put('adv_energy', t.energy, 0); put('adv_deltaT', t.deltaT, 1); put('adv_peakTemp', t.peakTemp, 1); put('adv_fade', t.fadeMargin, 1);
  }

  const persist = debounce(async () => {
    const data: Record<string, number> = { targetDecel: Number((document.getElementById('target-decel') as HTMLInputElement).value) };
    document.querySelectorAll('[data-in]').forEach((el) => { data[(el as HTMLInputElement).dataset.in!] = Number((el as HTMLInputElement).value); });
    saveStatus.textContent = 'Saving…';
    const err = await saveToolJson(TOOL, data);
    saveStatus.textContent = err ? 'Save failed: ' + err : 'Saved ✓';
    saveStatus.style.color = err ? 'var(--heritage)' : 'var(--state-linked)';
  }, 600);

  (async () => {
    applyChartDefaults();
    // Blank Master values (null) stay NaN so dependent outputs honestly show "—"
    // rather than computing from a silent 0.
    const rows = await loadMaster();
    master = Object.fromEntries(Object.entries(rows).map(([k, v]) => {
      const val = (v as any).value;
      return [k, val === null || val === undefined ? NaN : Number(val)];
    }));
    decorateLinkedCells(document, rows);
    const saved = await loadToolJson<Record<string, number>>(TOOL, {});
    for (const [k, v] of Object.entries(saved)) {
      if (k === 'targetDecel') { (document.getElementById('target-decel') as HTMLInputElement).value = String(v); continue; }
      const el = document.querySelector(`[data-in="${k}"]`) as HTMLInputElement | null; if (el && v != null) el.value = String(v);
    }

    // Reflect the Master link on the target-decel field: green/linked + read-only
    // when accel_brake_target is set, local blue input (with a note) when it isn't.
    const decelEl = document.getElementById('target-decel') as HTMLInputElement;
    const decelNote = document.getElementById('target-decel-note')!;
    if (Number.isFinite(master.accel_brake_target)) {
      decelEl.value = String(master.accel_brake_target);
      decelEl.readOnly = true;
      decelEl.classList.add('field', 'field-linked');
      decelNote.textContent = 'linked ← Master (accel_brake_target)';
    } else {
      decelEl.readOnly = false;
      decelNote.textContent = 'not set in Vehicle Spec — using local value';
      decelNote.style.color = 'var(--state-input)';
    }

    recompute();
    recomputeAdvanced();
    document.querySelectorAll('[data-in]').forEach((el) => el.addEventListener('input', () => { recompute(); recomputeAdvanced(); persist(); }));
    document.getElementById('target-decel')!.addEventListener('input', () => { recompute(); recomputeAdvanced(); persist(); });

    // Hardware presets fill both sides' bore then recompute.
    document.getElementById('mc-preset')!.addEventListener('change', (e) => {
      const v = MC_PRESETS[(e.target as HTMLSelectElement).value]; if (!v) return;
      (document.querySelector('[data-in="f_mcBore"]') as HTMLInputElement).value = String(v);
      (document.querySelector('[data-in="r_mcBore"]') as HTMLInputElement).value = String(v);
      recompute(); persist();
    });
    document.getElementById('cal-preset')!.addEventListener('change', (e) => {
      const v = CALIPER_PRESETS[(e.target as HTMLSelectElement).value]; if (!v) return;
      (document.querySelector('[data-in="f_caliperBore"]') as HTMLInputElement).value = String(v);
      (document.querySelector('[data-in="r_caliperBore"]') as HTMLInputElement).value = String(v);
      recompute(); persist();
    });

    document.getElementById('brk-contribute')!.addEventListener('click', async () => {
      const st = document.getElementById('brk-contribute-status')!;
      st.textContent = 'Saving…'; st.style.color = 'var(--ink-3)';
      const err = await saveToolOutputs(TOOL, [
        { key: 'brake_torque_front', label: 'Front brake torque / wheel', value: Number.isFinite(last.f_brakeTorque) ? +last.f_brakeTorque.toFixed(2) : null, unit: 'N·m' },
        { key: 'brake_torque_rear', label: 'Rear brake torque / wheel', value: Number.isFinite(last.r_brakeTorque) ? +last.r_brakeTorque.toFixed(2) : null, unit: 'N·m' },
        { key: 'achieved_front_bias', label: 'Achieved front brake bias', value: Number.isFinite(last.achievedFrontBias) ? +last.achievedFrontBias.toFixed(4) : null, unit: '-' },
      ]);
      st.textContent = err ? 'Failed: ' + err : 'Contributed ✓';
      st.style.color = err ? 'var(--heritage)' : 'var(--state-linked)';
    });

    watchTheme(() => { applyChartDefaults(); recompute(); recomputeAdvanced(); });
  })();
</script>
