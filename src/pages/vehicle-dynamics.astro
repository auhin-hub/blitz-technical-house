---
import Base from '../layouts/Base.astro';
import LegendKey from '../components/LegendKey.astro';
import WorkbookDownload from '../components/WorkbookDownload.astro';
import CalcTool from '../components/CalcTool.astro';
import CockpitShell from '../components/CockpitShell.astro';
import VdWorkflowMap from '../components/VdWorkflowMap.astro';
import CouplingPanel from '../components/CouplingPanel.astro';
import { url, DISCIPLINES } from '../lib/config';
import { PARAM_SEED } from '../lib/master';

const vd = DISCIPLINES.find((d) => d.slug === 'vehicle-dynamics')!;
const seed = Object.fromEntries(PARAM_SEED.map((p) => [p.key, p.value]));
const FR = [{ prefix: 'f', label: 'Front' }, { prefix: 'r', label: 'Rear' }];
const ltNi = 'width:84px;text-align:right;font-family:var(--font-mono);background:var(--surface-2);border:1px solid var(--rule);border-radius:var(--radius-sm);color:var(--ink);padding:0.22rem 0.4rem;';

// ---- Setup (targets; no computed outputs) --------------------------------
const SETUP_LINKED = [
  { mkey: 'track_front', label: 'Front track', unit: 'mm' },
  { mkey: 'track_rear', label: 'Rear track', unit: 'mm' },
  { mkey: 'wheelbase', label: 'Wheelbase', unit: 'mm' },
  { mkey: 'mu_lat_peak', label: 'Peak lateral μ', unit: '-' },
];
const SETUP_INPUTS = [
  { key: 'staticCamberF', label: 'Static camber front', unit: 'deg', vals: [-2] },
  { key: 'staticCamberR', label: 'Static camber rear', unit: 'deg', vals: [-1] },
  { key: 'dynCamberMaxRoll', label: 'Dynamic camber at max roll', unit: 'deg', vals: [-0.8] },
  { key: 'rcHeightF', label: 'Roll-centre height front', unit: 'mm', vals: [30] },
  { key: 'rcHeightR', label: 'Roll-centre height rear', unit: 'mm', vals: [45] },
  { key: 'bumpSteer', label: 'Bump steer (target ≈ 0)', unit: 'deg', vals: [0] },
  { key: 'caster', label: 'Caster', unit: 'deg', vals: [5] },
  { key: 'toeF', label: 'Toe front', unit: 'deg', vals: [0] },
  { key: 'toeR', label: 'Toe rear', unit: 'deg', vals: [0.1] },
];


// ---- Springs & dampers ---------------------------------------------------
// ---- Suspension loads ----------------------------------------------------
const LOADS_LINKED = [
  { mkey: 'mass_total', label: 'Total mass', sym: 'm', unit: 'kg' },
  { mkey: 'mass_frac_front', label: 'Front mass fraction', sym: 'ff', unit: '-' },
  { mkey: 'wheelbase', label: 'Wheelbase', sym: 'L', unit: 'mm' },
  { mkey: 'cog_height', label: 'CoG height', sym: 'h', unit: 'mm' },
];
const LOADS_INPUTS = [
  { key: 'dmf', label: 'Dynamic magnification factor (vertical)', unit: '-', vals: [3, 3] },
  { key: 'downforce', label: 'Aero downforce per axle', unit: 'N', vals: [50, 50] },
  { key: 'pushrodAngle', label: 'Pushrod angle to horizontal', unit: 'deg', vals: [45, 45] },
  { key: 'svsaAngle', label: 'Side-view swing-arm angle θ', unit: 'deg', vals: [8, 6] },
  { key: 'share', label: 'Anti share — F: front brake-bias (anti-dive) · R: drive-torque share (anti-squat, RWD=1)', unit: '-', vals: [0.65, 1] },
];
const LOADS_OUTPUTS = [
  { key: 'staticCorner', label: 'Static corner vertical load', unit: 'N' },
  { key: 'maxVertical', label: 'Max vertical case = static·DMF + DF', unit: 'N' },
  { key: 'pushrodForce', label: 'Pushrod force = vertical / sin θ', unit: 'N' },
  { key: 'antiPct', label: 'Anti-dive (F) / anti-squat (R) = share·tanθ·L/h', unit: '%' },
  { key: 'antiNote', label: 'Advisory (>100% = over-compensated)', unit: '' },
];

// ---- Steering ------------------------------------------------------------
const STEER_LINKED = [
  { mkey: 'wheelbase', label: 'Wheelbase', sym: 'L', unit: 'mm' },
  { mkey: 'track_front', label: 'Front track', sym: 't', unit: 'mm' },
];
const STEER_INPUTS = [
  { key: 'turningRadius', label: 'Target turning radius', unit: 'm', vals: [3.5] },
  { key: 'kingpinDist', label: 'Kingpin-to-kingpin distance', unit: 'mm', vals: [1100] },
  { key: 'steeringArm', label: 'Steering-arm length', unit: 'mm', vals: [90] },
  { key: 'rackTravel', label: 'Rack travel (lock-to-lock)', unit: 'mm', vals: [120] },
  { key: 'swTurns', label: 'Steering-wheel turns (lock-to-lock)', unit: '-', vals: [1.5] },
  { key: 'pinionPitchDia', label: 'Pinion pitch diameter', unit: 'mm', vals: [50] },
  { key: 'teeth', label: 'Number of teeth', unit: '-', vals: [18] },
];
const STEER_OUTPUTS = [
  { key: 'ackermannSplit', label: 'Ackermann split δin−δout', unit: 'deg' },
  { key: 'module', label: 'Module m = d / N', unit: 'mm' },
  { key: 'circularPitch', label: 'Circular pitch = π·m', unit: 'mm' },
  { key: 'baseDia', label: 'Base circle dia = PCD·cos20°', unit: 'mm' },
  { key: 'addendum', label: 'Addendum = 0.8·m', unit: 'mm' },
  { key: 'dedendum', label: 'Dedendum = 1.0·m', unit: 'mm' },
  { key: 'toothThickness', label: 'Tooth thickness = 1.5708·m', unit: 'mm' },
  { key: 'rackTravelPerRev', label: 'Rack travel per pinion rev = π·d', unit: 'mm/rev' },
];

// ---- Brakes --------------------------------------------------------------
---
<Base title="VD Workspace" description="Guided Vehicle Dynamics workflow — the handbook design sequence, wired to the gates.">
  <nav class="annot" style="margin-bottom:0.75rem;">
    <a href={url('')} style="color:inherit;">Home</a> / VD Workspace
  </nav>
  <header style="margin-bottom:1.25rem;">
    <p class="annot annot-tick">Guided workflow · design sequence → gates</p>
    <h1 style="margin-top:0.4rem;">VD Workspace</h1>
    <p style="color:var(--ink-2);margin-top:0.5rem;max-width:72ch;">
      The Vehicle Dynamics tools, arranged as the handbook's own design sequence
      (Book Two Part I) with its build gates. Any tool is usable anytime — the map
      shows the recommended order and what each stage needs first, so you can't get lost.
    </p>
    <div style="margin-top:1rem;">{vd.workbook && <WorkbookDownload file={vd.workbook} />}</div>
  </header>

  <!-- The guided design sequence (handbook Part I) + the coupling map (Part H). -->
  <VdWorkflowMap />
  <CouplingPanel />

  <h2 style="font-size:var(--fs-700);margin:1.5rem 0 0.25rem;">Tools</h2>
  <div class="notice" style="margin-bottom:1rem;">
    <strong>Shared numbers come from Vehicle Spec.</strong> Green = read from the
    Master (edit in <a href={url('vehicle-spec')}>Vehicle Spec</a>); blue = this
    tool's own inputs, saved for the whole team; black = computed. Ported from the
    workbook — see each tool's spec tag.
  </div>
  <LegendKey />

  <div style="margin-top:1.25rem;"></div>
  <CockpitShell tools={[
    { id: 'setup', title: 'Setup / kinematics' },
    { id: 'geometry', title: 'Suspension geometry' },
    { id: 'springs', title: 'Springs & dampers' },
    { id: 'loads', title: 'Suspension loads' },
    { id: 'steering', title: 'Steering' },
    { id: 'steereffort', title: 'Steering effort' },
    { id: 'rpsweep', title: 'R&P gear sweep' },
    { id: 'brakes', title: 'Brakes' },
    { id: 'balance', title: 'Balance' },
    { id: 'loadtransfer', title: 'Load transfer' },
  ]} railLabel="VD tools">
  <CalcTool id="setup" title="Setup / kinematics" spec="TOOL_SPECS §7a"
    blurb="Kinematic targets; platform values pulled from Master. A target sheet — no computed outputs."
    linked={SETUP_LINKED} seed={seed} inputs={SETUP_INPUTS} />

  <section id="geometry" class="ct">
    <header class="ct-head"><h2>Suspension geometry</h2><span class="badge">§6.4</span></header>
    <p class="ct-sub">Roll-centre / camber / scrub through travel (instant-centre reconstruction), the hardpoint table, and anti-dive/anti-squat — on its own page. Freeze hardpoints at G3.</p>
    <p style="margin-top:0.9rem;"><a class="btn btn-halftone" href={url('geometry')}>Open Suspension geometry ↗</a></p>
  </section>

  <section id="springs" class="ct">
    <header class="ct-head"><h2>Springs &amp; dampers</h2><span class="badge">§6.5</span></header>
    <p class="ct-sub">Ride-frequency sizing with the tyre in series, MR from rocker geometry, damping, damper catalog and roll gradient — on its own page.</p>
    <p style="margin-top:0.9rem;"><a class="btn btn-halftone" href={url('springs')}>Open Springs &amp; dampers ↗</a></p>
  </section>

  <CalcTool id="loads" title="Suspension loads" spec="TOOL_SPECS §7e"
    blurb="Vertical / braking / cornering cases → pushrod & wishbone loads, anti-dive/anti-squat."
    cols={FR} linked={LOADS_LINKED} seed={seed} inputs={LOADS_INPUTS} outputs={LOADS_OUTPUTS}
    chartId="loads-chart" chartTitle="Pushrod force & max vertical (front / rear)" chartHeight={260} />

  <CalcTool id="steering" title="Steering" spec="TOOL_SPECS §7f"
    blurb="Ackermann split (uses the target turning radius) + rack & pinion gear geometry."
    linked={STEER_LINKED} seed={seed} inputs={STEER_INPUTS} outputs={STEER_OUTPUTS} />

  <CalcTool id="steereffort" title="Steering effort" spec="§9"
    blurb="Worst-case (max lateral grip) kingpin moment → rack force → steering-wheel torque, to size driver effort. Add a braking force to include the scrub-radius term."
    linked={[
      { mkey: 'mu_lat_peak', label: 'Peak lateral μ', sym: 'μ', unit: '-' },
      { mkey: 'axle_load_front', label: 'Front axle static load', unit: 'N' },
      { mkey: 'rolling_radius', label: 'Rolling radius', sym: 'Re', unit: 'mm' },
    ]} seed={seed}
    inputs={[
      { key: 'caster', label: 'Caster angle', unit: 'deg', vals: [5] },
      { key: 'pneumaticTrail', label: 'Pneumatic trail (TTC Mz/Fy)', unit: 'mm', vals: [30], ref: { typ: '20–40' } },
      { key: 'scrubRadius', label: 'Scrub radius', unit: 'mm', vals: [10] },
      { key: 'fx', label: 'Braking force per wheel (0 = pure cornering)', unit: 'N', vals: [0] },
      { key: 'steeringArm', label: 'Steering-arm length', unit: 'mm', vals: [90] },
      { key: 'steeringRatio', label: 'Overall steering ratio i (SW°/road°)', unit: '-', vals: [5] },
      { key: 'efficiency', label: 'Steering efficiency η', unit: '-', vals: [0.9] },
    ]}
    outputs={[{ key: 'fyTyre', label: 'Lateral force / tyre', unit: 'N' }, { key: 'kingpinMoment', label: 'Kingpin moment / tyre', unit: 'N·m' }, { key: 'rackForce', label: 'Rack force', unit: 'N' }]}
    stats={[{ key: 'swTorque', label: 'Steering-wheel torque', unit: 'N·m' }]} />

  <!-- R&P gear sweep: standard tooth counts at a fixed pinion PCD, so you can
       pick the number of teeth against module / tooth-thickness — a companion to
       the single-point gear geometry in the Steering tool (§6.4). -->
  <section id="rpsweep" class="card" style="margin-top:1.25rem;">
    <div style="display:flex;justify-content:space-between;align-items:baseline;gap:1rem;flex-wrap:wrap;">
      <h2 style="font-size:var(--fs-700);">R&amp;P gear sweep</h2>
      <span class="badge">§9</span>
    </div>
    <p style="color:var(--ink-2);margin-top:0.35rem;font-size:var(--fs-300);max-width:66ch;">
      For a fixed pinion pitch-circle diameter (PCD), compare the standard tooth
      counts: fewer teeth = a coarser module and thicker, stronger teeth but
      faster, coarser steering; more teeth = a finer module and smoother steering.
      Rack travel per pinion revolution = π·d is set by the PCD alone, so it does
      not change across the sweep.
    </p>
    <table style="border-collapse:collapse;font-size:var(--fs-300);margin-top:0.8rem;">
      <tbody>
        <tr>
          <td style="padding:0.45rem 0.6rem;">Pinion pitch diameter (PCD)</td>
          <td style="padding:0.45rem 0.6rem;text-align:right;"><input type="number" step="any" class="field field-input" style="width:92px;text-align:right;font-family:var(--font-mono);" id="rp-pcd" value="50" aria-label="Pinion pitch diameter" /></td>
          <td style="padding:0.45rem 0.6rem;" class="mono">mm</td>
        </tr>
        <tr>
          <td style="padding:0.45rem 0.6rem;">Rack travel per pinion rev = π·d</td>
          <td style="padding:0.45rem 0.6rem;text-align:right;"><span class="field field-computed mono" id="rp-travel">—</span></td>
          <td style="padding:0.45rem 0.6rem;" class="mono">mm/rev</td>
        </tr>
      </tbody>
    </table>
    <div style="overflow-x:auto;margin-top:0.9rem;">
      <table style="border-collapse:collapse;font-size:var(--fs-300);min-width:560px;">
        <thead><tr style="border-bottom:1px solid var(--rule-strong);text-align:left;">
          <th style="padding:0.5rem 0.6rem;" class="annot">Teeth N</th>
          <th style="padding:0.5rem 0.6rem;text-align:right;" class="annot">Module m = d/N (mm)</th>
          <th style="padding:0.5rem 0.6rem;text-align:right;" class="annot">Circular pitch π·m (mm)</th>
          <th style="padding:0.5rem 0.6rem;text-align:right;" class="annot">Tooth thickness (mm)</th>
          <th style="padding:0.5rem 0.6rem;text-align:right;" class="annot">Addendum 0.8·m (mm)</th>
        </tr></thead>
        <tbody id="rp-body"></tbody>
      </table>
    </div>
  </section>

  <section id="brakes" class="ct">
    <header class="ct-head"><h2>Brakes</h2><span class="badge">§6.6</span></header>
    <p class="ct-sub">The full Brake System tool — hydraulic sizing, achieved vs Olley-optimum bias sweep, and (next) Magic-Formula + thermal — lives on its own tabbed page.</p>
    <p style="margin-top:0.9rem;"><a class="btn btn-halftone" href={url('brakes')}>Open the Brake System tool ↗</a></p>
  </section>

  <section id="balance" class="ct">
    <header class="ct-head"><h2>Balance</h2><span class="badge">§6.7</span></header>
    <p class="ct-sub">Understeer gradient (bicycle model) + roll-stiffness distribution / ARB vs TLLTD — where the car pushes or gets loose.</p>
    <p style="margin-top:0.9rem;"><a class="btn btn-halftone" href={url('balance')}>Open Balance ↗</a></p>
  </section>

  <!-- Load transfer (P2.5): geometric + elastic + unsprung → achieved TLLTD,
       written to Master so the guessed TLLTD becomes a derived one (feeds Balance). -->
  <section id="loadtransfer" class="ct">
    <header class="ct-head"><h2>Lateral load transfer</h2><span class="badge">§9</span></header>
    <p class="ct-sub">Per-corner vertical loads at a lateral accel, split into geometric (roll centre), elastic (roll stiffness) and unsprung terms → the <strong>achieved TLLTD</strong>. Writing it to Master turns the guessed front TLLTD into a derived one that Balance reads.</p>
    <div style="display:flex;gap:1.4rem;flex-wrap:wrap;margin-top:0.5rem;font-size:var(--fs-300);">
      <span>Mass <span class="mono" style="color:var(--ink-3)">(m)</span> <span class="field field-linked mono" data-master="mass_total">—</span> kg</span>
      <span>Front frac <span class="field field-linked mono" data-master="mass_frac_front">—</span></span>
      <span>CoG h <span class="field field-linked mono" data-master="cog_height">—</span> mm</span>
      <span>Track F/R <span class="field field-linked mono" data-master="track_front">—</span>/<span class="field field-linked mono" data-master="track_rear">—</span> mm</span>
      <span>Unsprung/corner <span class="field field-linked mono" data-master="unsprung_corner">—</span> kg</span>
    </div>
    <div class="ct-body" style="display:grid;grid-template-columns:1fr 1fr;gap:0.4rem 1.5rem;align-items:start;margin-top:0.7rem;">
      <div>
        <h3 class="ct-h3">Inputs</h3>
        <table class="ct-table"><tbody>
          <tr><td>Lateral accel ay</td><td class="ct-num"><input type="number" step="any" data-in="ay" value="1.5" style={ltNi} /></td><td class="ct-unit">g</td></tr>
          <tr><td>RC height front</td><td class="ct-num"><input type="number" step="any" data-in="rcFront" value="30" style={ltNi} /></td><td class="ct-unit">mm</td></tr>
          <tr><td>RC height rear</td><td class="ct-num"><input type="number" step="any" data-in="rcRear" value="45" style={ltNi} /></td><td class="ct-unit">mm</td></tr>
          <tr><td>Roll stiffness front</td><td class="ct-num"><input type="number" step="any" data-in="kRollFront" value="450" style={ltNi} /></td><td class="ct-unit">N·m/deg</td></tr>
          <tr><td>Roll stiffness rear</td><td class="ct-num"><input type="number" step="any" data-in="kRollRear" value="350" style={ltNi} /></td><td class="ct-unit">N·m/deg</td></tr>
          <tr><td>Unsprung CG height</td><td class="ct-num"><input type="number" step="any" data-in="unsprungCog" value="228" style={ltNi} /></td><td class="ct-unit">mm</td></tr>
        </tbody></table>
        <p class="ct-ref" style="margin-top:0.4rem;">RC heights from Geometry; roll stiffness from Springs (roll gradient / rates).</p>
      </div>
      <div>
        <div class="ct-stats"><div class="ct-stat"><span class="annot">Achieved TLLTD (front)</span><div class="val"><span class="field field-computed mono" data-out="tlltdFront">—</span></div><span class="ct-ref">typ 0.45–0.55</span></div></div>
        <h3 class="ct-h3" style="margin-top:0.5rem;">Load transfer / corner loads</h3>
        <table class="ct-table"><tbody>
          <tr><td>ΔW front / rear</td><td class="ct-num"><span class="field field-computed mono" data-out="dWFront">—</span></td><td class="ct-num"><span class="field field-computed mono" data-out="dWRear">—</span></td><td class="ct-unit">N</td></tr>
          <tr><td>Front outer / inner</td><td class="ct-num"><span class="field field-computed mono" data-out="frontOuter">—</span></td><td class="ct-num"><span class="field field-computed mono" data-out="frontInner">—</span></td><td class="ct-unit">N</td></tr>
          <tr><td>Rear outer / inner</td><td class="ct-num"><span class="field field-computed mono" data-out="rearOuter">—</span></td><td class="ct-num"><span class="field field-computed mono" data-out="rearInner">—</span></td><td class="ct-unit">N</td></tr>
        </tbody></table>
        <h3 class="ct-h3" style="margin-top:0.5rem;">Write to Master</h3>
        <p style="color:var(--ink-2);font-size:var(--fs-300);">Sets <span class="mono">tlltd_front</span> to the achieved value (unfreeze first if locked).</p>
        <button class="btn btn-heritage" type="button" id="lt-write" style="margin-top:0.4rem;">Write TLLTD → Master</button>
        <span class="mono" id="lt-status" style="margin-left:0.6rem;font-size:var(--fs-200);color:var(--ink-3);"></span>
        <p class="mono" data-save-status style="margin-top:0.5rem;font-size:var(--fs-200);color:var(--ink-3);"></p>
      </div>
    </div>
  </section>
  </CockpitShell>
</Base>

<script>
  import { mountCalculator } from '../lib/calc/engine';
  import { loadsCompute } from '../lib/calc/vd-loads';
  import { steeringCompute, steeringEffortCompute } from '../lib/calc/vd-steering';
  import { loadTransfer } from '../lib/calc/vd-loadtransfer';
  import { rpSweep, rackTravelPerRev } from '../lib/calc/extras';
  import { loadMaster, setMasterValue } from '../lib/store';

  const noOpts = { responsive: true, maintainAspectRatio: false, plugins: { legend: { labels: { usePointStyle: true } } } };

  mountCalculator({ root: 'setup', tool: 'vd_setup', compute: () => ({}) });

  // Present anti-geometry as a percentage (the workbook core returns a fraction),
  // with a per-side advisory when it exceeds 100% (over-compensated — valid, not an error).
  const loadsComputePct = (inp: Record<string, number>, m: Record<string, number>) => {
    const o = loadsCompute(inp, m) as Record<string, number | string>;
    for (const p of ['f', 'r'] as const) {
      const frac = o[`${p}_antiPct`] as number;
      const pct = frac * 100;
      o[`${p}_antiPct`] = pct;
      o[`${p}_antiNote`] = Number.isFinite(pct) && pct > 100 ? '⚠ over 100% anti' : '';
    }
    return o;
  };

  mountCalculator({
    root: 'loads', tool: 'vd_loads', compute: loadsComputePct, defaultDigits: 2,
    digits: { f_antiPct: 1, r_antiPct: 1 },
    charts: [{
      canvasId: 'loads-chart',
      build: ({ out, pal }) => ({
        type: 'bar',
        data: { labels: ['Front', 'Rear'], datasets: [
          { label: 'Pushrod force (N)', data: [out.f_pushrodForce, out.r_pushrodForce], backgroundColor: pal.sky },
          { label: 'Max vertical (N)', data: [out.f_maxVertical, out.r_maxVertical], backgroundColor: pal.amber },
        ] },
        options: { ...noOpts, scales: { y: { title: { display: true, text: 'N' } } } },
      }),
    }],
  });

  mountCalculator({
    root: 'steering', tool: 'vd_steering', compute: steeringCompute, defaultDigits: 3,
    digits: { baseDia: 2, rackTravelPerRev: 2 },
  });

  mountCalculator({ root: 'steereffort', tool: 'vd_steereffort', compute: steeringEffortCompute, digits: { fyTyre: 0, kingpinMoment: 1, rackForce: 0, swTorque: 1 } });

  // Load transfer: map Master keys + inputs into loadTransfer's shapes.
  const ltCompute = (inp: Record<string, number>, m: Record<string, number>) => loadTransfer(
    { ay: inp.ay, rcFront: inp.rcFront, rcRear: inp.rcRear, kRollFront: inp.kRollFront, kRollRear: inp.kRollRear, unsprungCog: inp.unsprungCog },
    { mass: m.mass_total, ff: m.mass_frac_front, cogHeight: m.cog_height, trackFront: m.track_front, trackRear: m.track_rear, unsprungCorner: m.unsprung_corner },
  ) as unknown as Record<string, number>;
  mountCalculator({ root: 'loadtransfer', tool: 'vd_loadtransfer', compute: ltCompute, defaultDigits: 0, digits: { tlltdFront: 3 } });

  document.getElementById('lt-write')!.addEventListener('click', async () => {
    const st = document.getElementById('lt-status')!;
    const gi = (k: string) => Number((document.querySelector(`#loadtransfer [data-in="${k}"]`) as HTMLInputElement)?.value);
    const mm = await loadMaster();
    const mv = (k: string) => { const v = mm[k]?.value; return v === null || v === undefined ? NaN : Number(v); };
    const r = loadTransfer(
      { ay: gi('ay'), rcFront: gi('rcFront'), rcRear: gi('rcRear'), kRollFront: gi('kRollFront'), kRollRear: gi('kRollRear'), unsprungCog: gi('unsprungCog') },
      { mass: mv('mass_total'), ff: mv('mass_frac_front'), cogHeight: mv('cog_height'), trackFront: mv('track_front'), trackRear: mv('track_rear'), unsprungCorner: mv('unsprung_corner') },
    );
    if (!Number.isFinite(r.tlltdFront)) { st.textContent = 'Fill in Master (mass, ff, tracks…) first.'; st.style.color = 'var(--heritage)'; return; }
    st.textContent = 'Saving…'; st.style.color = 'var(--ink-3)';
    const err = await setMasterValue('tlltd_front', +r.tlltdFront.toFixed(4));
    st.textContent = err ? 'Failed (frozen?): ' + err : 'Written to Master ✓';
    st.style.color = err ? 'var(--heritage)' : 'var(--state-linked)';
  });

  // ---- R&P gear sweep (local only; no shared state) ----
  const rpPcd = document.getElementById('rp-pcd') as HTMLInputElement | null;
  const rpBody = document.getElementById('rp-body');
  const rpTravel = document.getElementById('rp-travel');
  function renderRpSweep() {
    if (!rpPcd || !rpBody || !rpTravel) return;
    const pcd = Number(rpPcd.value);
    if (!Number.isFinite(pcd) || pcd <= 0) { rpBody.innerHTML = ''; rpTravel.textContent = '—'; return; }
    rpTravel.textContent = rackTravelPerRev(pcd).toFixed(2);
    rpBody.innerHTML = rpSweep(pcd).map((r) => `
      <tr style="border-bottom:1px solid var(--rule);">
        <td style="padding:0.4rem 0.6rem;" class="mono">${r.n}</td>
        <td style="padding:0.4rem 0.6rem;text-align:right;" class="mono">${r.module.toFixed(3)}</td>
        <td style="padding:0.4rem 0.6rem;text-align:right;" class="mono">${r.circPitch.toFixed(3)}</td>
        <td style="padding:0.4rem 0.6rem;text-align:right;" class="mono">${r.toothThk.toFixed(3)}</td>
        <td style="padding:0.4rem 0.6rem;text-align:right;" class="mono">${r.addendum.toFixed(3)}</td>
      </tr>`).join('');
  }
  rpPcd?.addEventListener('input', renderRpSweep);
  renderRpSweep();
</script>
