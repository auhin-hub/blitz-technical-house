---
import Base from '../layouts/Base.astro';
import { url } from '../lib/config';
import { DAMPER_PRESETS } from '../lib/calc/springs';

const LINKED = [
  { k: 'mass_total', l: 'Mass', s: 'm', u: 'kg' },
  { k: 'mass_frac_front', l: 'Front fraction', s: 'ff', u: '-' },
  { k: 'tyre_vert_stiffness', l: 'Tyre vert. stiffness', s: 'Kt', u: 'N/mm' },
  { k: 'cog_height', l: 'CoG height', s: 'h', u: 'mm' },
  { k: 'track_front', l: 'Front track', s: 'tf', u: 'mm' },
  { k: 'track_rear', l: 'Rear track', s: 'tr', u: 'mm' },
];
const INPUTS = [
  { key: 'targetFreq', label: 'Target ride frequency', unit: 'Hz', f: 2.6, r: 2.8, ref: '2.3–2.9' },
  { key: 'unsprung', label: 'Unsprung mass / corner', unit: 'kg', f: 12, r: 12, ref: '8–14' },
  { key: 'motionRatio', label: 'Motion ratio (wheel→spring)', unit: '-', f: 0.9, r: 0.9, ref: '' },
  { key: 'chosenSpringRate', label: 'Chosen spring rate (0 = none)', unit: 'N/mm', f: 0, r: 0, ref: '' },
  { key: 'bump', label: 'Wheel travel — bump', unit: 'mm', f: 30, r: 25, ref: '' },
  { key: 'droop', label: 'Wheel travel — droop', unit: 'mm', f: 25, r: 25, ref: '' },
  { key: 'dampingRatio', label: 'Target damping ratio ζ', unit: '-', f: 0.65, r: 0.65, ref: '0.6–0.7' },
];
const OUTPUTS = [
  { key: 'sprungCorner', label: 'Sprung corner mass', unit: 'kg' },
  { key: 'rideRate', label: 'Ride rate Kr = (2πf)²·m', unit: 'N/mm' },
  { key: 'wheelRate', label: 'Wheel rate (tyre in series)', unit: 'N/mm' },
  { key: 'springRate', label: 'Spring rate Ks = Kw/MR²', unit: 'N/mm' },
  { key: 'recheckFreq', label: 'Re-check freq (chosen spring)', unit: 'Hz' },
  { key: 'springTravel', label: 'Spring travel', unit: 'mm' },
  { key: 'critDamping', label: 'Critical damping Cc', unit: 'N·s/m' },
  { key: 'damperRate', label: 'Damper rate ζ·Cc', unit: 'N·s/m' },
];
const ni = 'width:82px;text-align:right;font-family:var(--font-mono);background:var(--surface-2);border:1px solid var(--rule);border-radius:var(--radius-sm);color:var(--ink);padding:0.22rem 0.4rem;';
const sel = 'font-family:var(--font-mono);font-size:var(--fs-300);background:var(--surface-2);border:1px solid var(--rule-strong);border-radius:var(--radius);color:var(--ink);padding:0.25rem 0.4rem;';
---
<Base title="Springs & dampers">
  <nav class="annot" style="margin-bottom:0.75rem;">
    <a href={url('vehicle-dynamics')} style="color:inherit;">VD Workspace</a> / Springs &amp; dampers
  </nav>
  <header style="margin-bottom:1rem;">
    <p class="annot annot-tick">Stage 06 · Gate G5 · writes spring rates to Master</p>
    <h1 style="margin-top:0.4rem;">Springs &amp; dampers</h1>
    <p style="color:var(--ink-2);margin-top:0.5rem;max-width:74ch;">
      Ride-frequency sizing with the <strong>tyre in series</strong> (the fix the
      old tool missed) → wheel rate → spring rate via the motion ratio; damping
      from ζ; plus roll stiffness and roll gradient. Shared inputs come from the Master.
    </p>
  </header>

  <div class="card" style="margin-bottom:1rem;">
    <span class="annot">From Master</span>
    <div style="display:flex;gap:1.3rem;flex-wrap:wrap;margin-top:0.4rem;font-size:var(--fs-300);">
      {LINKED.map((l) => (
        <span>{l.l} <span class="mono" style="color:var(--ink-3)">({l.s})</span>
          <span class="field field-linked mono" data-master={l.k} style="margin-left:0.35rem;">—</span> {l.u}</span>
      ))}
    </div>
  </div>

  <div class="card">
    <div class="ct-body">
      <div class="ct-col">
        <h3 class="ct-h3">Inputs</h3>
        <div class="ct-wrap"><table class="ct-table"><thead><tr><th>Parameter</th><th class="ct-num">Front</th><th class="ct-num">Rear</th><th>Unit</th><th></th></tr></thead>
          <tbody>{INPUTS.map((i) => (
            <tr><td>{i.label}</td>
              <td class="ct-num"><input type="number" step="any" style={ni} data-in={`f_${i.key}`} value={i.f} aria-label={`${i.label} front`} /></td>
              <td class="ct-num"><input type="number" step="any" style={ni} data-in={`r_${i.key}`} value={i.r} aria-label={`${i.label} rear`} /></td>
              <td class="ct-unit">{i.unit}</td>
              <td>{i.ref && <span class="ct-ref">{i.ref}</span>}</td></tr>
          ))}</tbody></table></div>

        <h3 class="ct-h3">Motion ratio from rocker geometry</h3>
        <p style="color:var(--ink-2);font-size:var(--fs-300);">MR = L_damper·cosθ_damper / (L_pushrod·cosθ_pushrod). Fill and apply to both sides.</p>
        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;">
          <label style="font-size:var(--fs-200);">L_d<input type="number" step="any" style={ni} id="mr-ld" value="180" /></label>
          <label style="font-size:var(--fs-200);">θ_d°<input type="number" step="any" style={ni} id="mr-thd" value="10" /></label>
          <label style="font-size:var(--fs-200);">L_p<input type="number" step="any" style={ni} id="mr-lp" value="200" /></label>
          <label style="font-size:var(--fs-200);">θ_p°<input type="number" step="any" style={ni} id="mr-thp" value="15" /></label>
          <span class="mono" style="font-size:var(--fs-300);">MR = <span id="mr-out">—</span></span>
          <button class="btn btn-ghost" type="button" id="mr-apply" style="font-size:var(--fs-200);">Apply</button>
        </div>

        <h3 class="ct-h3">Damper catalog</h3>
        <select id="damper-preset" style={sel}>
          <option value="">— reference only —</option>
          {Object.keys(DAMPER_PRESETS).map((n) => <option value={n}>{n}</option>)}
        </select>
        <span class="mono" id="damper-note" style="margin-left:0.5rem;font-size:var(--fs-200);color:var(--ink-3);"></span>
      </div>

      <div class="ct-col">
        <div class="ct-stats">
          <div class="ct-stat"><span class="annot">Roll gradient</span><div class="val"><span data-out="rollGradient">—</span><span class="ct-unit" style="font-size:var(--fs-400)"> deg/g</span></div><span class="ct-ref">1.0–1.5</span></div>
          <div class="ct-stat"><span class="annot">Roll stiffness F / R</span><div class="val" style="font-size:var(--fs-500)"><span data-out="rollStiffFront">—</span> / <span data-out="rollStiffRear">—</span></div><span class="ct-unit">N·m/deg</span></div>
        </div>
        <h3 class="ct-h3">Outputs</h3>
        <div class="ct-wrap"><table class="ct-table"><thead><tr><th>Result</th><th class="ct-num">Front</th><th class="ct-num">Rear</th><th>Unit</th></tr></thead>
          <tbody>{OUTPUTS.map((o) => (
            <tr><td>{o.label}</td>
              <td class="ct-num"><span class="field field-computed mono" data-out={`f_${o.key}`}>—</span></td>
              <td class="ct-num"><span class="field field-computed mono" data-out={`r_${o.key}`}>—</span></td>
              <td class="ct-unit">{o.unit}</td></tr>
          ))}</tbody></table></div>
        <div style="height:180px;position:relative;margin-top:0.6rem;"><canvas id="rate-chart"></canvas></div>
        <p style="margin-top:0.6rem;"><button class="btn btn-heritage" type="button" id="spr-contribute">Contribute to Master</button>
          <span class="mono" id="spr-contribute-status" style="margin-left:0.6rem;font-size:var(--fs-200);color:var(--ink-3);"></span></p>
      </div>
    </div>
    <p class="mono" data-save-status style="margin-top:0.7rem;font-size:var(--fs-200);color:var(--ink-3);"></p>
  </div>
</Base>

<script>
  import Chart from 'chart.js/auto';
  import { springsCompute, mrFromGeometry, DAMPER_PRESETS, type SpringSide, type SpringsMaster } from '../lib/calc/springs';
  import { loadMaster, saveToolJson, loadToolJson, saveToolOutputs, fmt, debounce } from '../lib/store';
  import { decorateLinkedCells } from '../lib/linked';
  import { applyChartDefaults, palette, watchTheme } from '../lib/chart-theme';

  const TOOL = 'springs';
  const saveStatus = document.querySelector('[data-save-status]') as HTMLElement;
  let master: Record<string, number> = {};
  let chart: Chart | null = null;
  let last: any = {};
  const gi = (k: string) => Number((document.querySelector(`[data-in="${k}"]`) as HTMLInputElement)?.value);
  const gid = (id: string) => Number((document.getElementById(id) as HTMLInputElement)?.value);
  const put = (k: string, v: number, d = 2) => { const el = document.querySelector(`[data-out="${k}"]`); if (el) el.textContent = v === null || !Number.isFinite(v) ? '—' : fmt(v, d); };

  const sideIn = (p: string): SpringSide => ({
    targetFreq: gi(`${p}_targetFreq`), unsprung: gi(`${p}_unsprung`), motionRatio: gi(`${p}_motionRatio`),
    chosenSpringRate: gi(`${p}_chosenSpringRate`), bump: gi(`${p}_bump`), droop: gi(`${p}_droop`), dampingRatio: gi(`${p}_dampingRatio`),
  });

  function recompute() {
    const m: SpringsMaster = { mass: master.mass_total, ff: master.mass_frac_front, kt: master.tyre_vert_stiffness, cogHeight: master.cog_height, trackFront: master.track_front, trackRear: master.track_rear };
    const r = springsCompute(sideIn('f'), sideIn('r'), m);
    last = r;
    const outs = ['sprungCorner', 'rideRate', 'wheelRate', 'springRate', 'recheckFreq', 'springTravel', 'critDamping', 'damperRate'];
    for (const k of outs) { put(`f_${k}`, r[`f_${k}`] as number, k === 'critDamping' || k === 'damperRate' ? 1 : 2); put(`r_${k}`, r[`r_${k}`] as number, k === 'critDamping' || k === 'damperRate' ? 1 : 2); }
    put('rollGradient', r.rollGradient as number, 2); put('rollStiffFront', r.rollStiffFront as number, 1); put('rollStiffRear', r.rollStiffRear as number, 1);
    const p = palette();
    const cfg: any = { type: 'bar', data: { labels: ['Front', 'Rear'], datasets: [
      { label: 'Wheel rate (N/mm)', data: [r.f_wheelRate, r.r_wheelRate], backgroundColor: p.sky },
      { label: 'Spring rate (N/mm)', data: [r.f_springRate, r.r_springRate], backgroundColor: p.amber },
    ] }, options: { responsive: true, maintainAspectRatio: false, scales: { y: { title: { display: true, text: 'N/mm' } } } } };
    if (chart) { chart.data = cfg.data; chart.update(); } else { const cv = document.getElementById('rate-chart') as HTMLCanvasElement | null; if (cv) chart = new Chart(cv, cfg); }
  }

  function recomputeMr() {
    const mr = mrFromGeometry(gid('mr-ld'), gid('mr-thd'), gid('mr-lp'), gid('mr-thp'));
    (document.getElementById('mr-out') as HTMLElement).textContent = Number.isFinite(mr) ? fmt(mr, 3) : '—';
    return mr;
  }

  const persist = debounce(async () => {
    const data: Record<string, number> = {};
    document.querySelectorAll('[data-in]').forEach((el) => { data[(el as HTMLInputElement).dataset.in!] = Number((el as HTMLInputElement).value); });
    saveStatus.textContent = 'Saving…';
    const err = await saveToolJson(TOOL, data);
    saveStatus.textContent = err ? 'Save failed: ' + err : 'Saved ✓';
    saveStatus.style.color = err ? 'var(--heritage)' : 'var(--state-linked)';
  }, 600);

  (async () => {
    applyChartDefaults();
    const rows = await loadMaster();
    master = Object.fromEntries(Object.entries(rows).map(([k, v]) => { const val = (v as any).value; return [k, val === null || val === undefined ? NaN : Number(val)]; }));
    decorateLinkedCells(document, rows);
    const saved = await loadToolJson<Record<string, number>>(TOOL, {});
    for (const [k, v] of Object.entries(saved)) { const el = document.querySelector(`[data-in="${k}"]`) as HTMLInputElement | null; if (el && v != null) el.value = String(v); }

    recompute(); recomputeMr();
    document.querySelectorAll('[data-in]').forEach((el) => el.addEventListener('input', () => { recompute(); persist(); }));
    ['mr-ld', 'mr-thd', 'mr-lp', 'mr-thp'].forEach((id) => document.getElementById(id)!.addEventListener('input', recomputeMr));
    document.getElementById('mr-apply')!.addEventListener('click', () => {
      const mr = recomputeMr(); if (!Number.isFinite(mr)) return;
      (document.querySelector('[data-in="f_motionRatio"]') as HTMLInputElement).value = fmt(mr, 3);
      (document.querySelector('[data-in="r_motionRatio"]') as HTMLInputElement).value = fmt(mr, 3);
      recompute(); persist();
    });
    document.getElementById('damper-preset')!.addEventListener('change', (e) => {
      const d = DAMPER_PRESETS[(e.target as HTMLSelectElement).value];
      const note = document.getElementById('damper-note')!;
      if (!d) { note.textContent = ''; return; }
      const need = Math.max(Number(last.f_springTravel) || 0, Number(last.r_springTravel) || 0);
      note.textContent = `eye ${d.eye} mm · travel ${d.travel} mm · needs ~${fmt(need, 1)} mm${need > d.travel ? ' ⚠ exceeds travel' : ' ✓'}`;
    });

    document.getElementById('spr-contribute')!.addEventListener('click', async () => {
      const st = document.getElementById('spr-contribute-status')!;
      st.textContent = 'Saving…'; st.style.color = 'var(--ink-3)';
      const num = (v: any) => Number.isFinite(v) ? +(+v).toFixed(3) : null;
      const err = await saveToolOutputs(TOOL, [
        { key: 'spring_rate_front', label: 'Front spring rate', value: num(last.f_springRate), unit: 'N/mm' },
        { key: 'spring_rate_rear', label: 'Rear spring rate', value: num(last.r_springRate), unit: 'N/mm' },
        { key: 'roll_gradient', label: 'Roll gradient (springs)', value: num(last.rollGradient), unit: 'deg/g' },
      ]);
      st.textContent = err ? 'Failed: ' + err : 'Contributed ✓';
      st.style.color = err ? 'var(--heritage)' : 'var(--state-linked)';
    });

    watchTheme(() => { applyChartDefaults(); recompute(); });
  })();
</script>
