---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import TeamTools from '../components/TeamTools.astro';
import LegendKey from '../components/LegendKey.astro';
import WorkbookDownload from '../components/WorkbookDownload.astro';
import CalcTool from '../components/CalcTool.astro';
import CockpitShell from '../components/CockpitShell.astro';
import { DISCIPLINES } from '../lib/config';
import { PARAM_SEED } from '../lib/master';
import { MASS_COMPONENTS } from '../lib/calc/chassis-mass';

const ch = DISCIPLINES.find((d) => d.slug === 'chassis')!;
const seed = Object.fromEntries(PARAM_SEED.map((p) => [p.key, p.value]));

// ---- Impact forces (request §2–5) — mass is read from Master, never retyped.
const IMPACT_LINKED = [{ mkey: 'mass_total', label: 'Total mass (car + driver)', sym: 'm', unit: 'kg' }];
const IMPACT_INPUTS = [
  { key: 'nFront', label: 'Front impact deceleration n', unit: 'g', vals: [20], note: 'design assumption' },
  { key: 'nRear', label: 'Rear impact deceleration n', unit: 'g', vals: [10], note: 'design assumption' },
  { key: 'nSide', label: 'Side impact deceleration n', unit: 'g', vals: [10], note: 'design assumption' },
];

// ---- Twist test → torsional + relative stiffness (request §6–7).
const STIFF_INPUTS = [
  { key: 'force', label: 'Force at the load points F', unit: 'N', vals: [1000] },
  { key: 'dist', label: 'Distance between load points d', unit: 'm', vals: [0.6] },
  { key: 'defl1', label: 'Deflection δ1 (left point)', unit: 'mm', vals: [0.8] },
  { key: 'defl2', label: 'Deflection δ2 (right point)', unit: 'mm', vals: [0.8] },
  { key: 'kf', label: 'Front roll stiffness Kf', unit: 'N·m/deg', vals: [133.07], note: 'springs + ARB' },
  { key: 'kr', label: 'Rear roll stiffness Kr', unit: 'N·m/deg', vals: [221.37], note: 'springs + ARB' },
];

const TUBE_INPUTS = [
  { key: 'memberForce', label: 'Design member force (from LoadCases)', unit: 'N', vals: [1455] },
  { key: 'tubeOd', label: 'Tube OD', unit: 'mm', vals: [25] },
  { key: 'tubeWall', label: 'Tube wall', unit: 'mm', vals: [2] },
  { key: 'yield', label: 'Material yield', unit: 'MPa', vals: [435] },
];
const TUBE_OUTPUTS = [
  { key: 'sectionArea', label: 'Section area = π/4·(OD²−(OD−2·wall)²)', unit: 'mm²' },
  { key: 'axialStress', label: 'Axial stress = force / area', unit: 'MPa' },
];
const td = 'padding:0.4rem 0.55rem;';
const th = 'padding:0.5rem 0.55rem;';
const numInput = 'width:78px;text-align:right;font-family:var(--font-mono);';
---
<Base title={ch.title} description={ch.blurb}>
  <Crumbs page="chassis" label={ch.title} />
  <header style="margin-bottom:1.25rem;">
    <p class="annot annot-tick">Discipline</p>
    <h1 style="margin-top:0.4rem;">{ch.title}</h1>
    <p style="color:var(--ink-2);margin-top:0.5rem;max-width:72ch;">{ch.blurb}</p>
    <div style="margin-top:1rem;">{ch.workbook && <WorkbookDownload file={ch.workbook} />}</div>
  </header>
  <TeamTools team={ch} />


  <div class="notice" style="margin-bottom:1.5rem;">
    <strong>Blue = your inputs (saved for the team); black = computed.</strong>
    Ported from the workbook — see each tool's spec tag.
  </div>
  <LegendKey />

  <div style="margin-top:1.25rem;"></div>
  <CockpitShell tools={[
    { id: 'impact', title: 'Impact forces' },
    { id: 'stiffness', title: 'Torsional & relative stiffness' },
    { id: 'tube', title: 'Tube stress & FoS' },
    { id: 'mass', title: 'Component-mass tracker' },
    { id: 'buckling', title: 'Tube buckling', rare: true },
    { id: 'bolt', title: 'Bolted joint', rare: true },
  ]} railLabel="Chassis">
  <CalcTool id="impact" title="Impact forces — front / rear / side" spec="TOOL_SPECS §2c"
    blurb="Quasi-static impact load F = m · n · 9.81. Mass is the car + driver total from Vehicle Spec; the decelerations are the team's design assumptions, not rulebook values."
    linked={IMPACT_LINKED} seed={seed} inputs={IMPACT_INPUTS}
    outputs={[
      { key: 'front', label: 'Front impact force F = m·n·g', unit: 'N' },
      { key: 'rear', label: 'Rear impact force', unit: 'N' },
      { key: 'side', label: 'Side impact force', unit: 'N' },
    ]}
    stats={[
      { key: 'frontKn', label: 'Front', unit: 'kN' },
      { key: 'rearKn', label: 'Rear', unit: 'kN' },
      { key: 'sideKn', label: 'Side', unit: 'kN' },
    ]} />

  <CalcTool id="stiffness" title="Torsional stiffness (twist test) → relative stiffness" spec="TOOL_SPECS §2d"
    blurb="Twist test: T = F·d, θ = arctan((δ1+δ2)/d) with δ converted mm → m, K = T/θ. K chassis then feeds the series model Kf — K chassis — Kr. Kf and Kr are total roll stiffness (springs + anti-roll bars), all in N·m/deg."
    inputs={STIFF_INPUTS}
    outputs={[
      { key: 'torque', label: 'Couple T = F·d', unit: 'N·m' },
      { key: 'thetaDeg', label: 'Twist angle θ', unit: 'deg' },
      { key: 'thetaRad', label: 'Twist angle θ', unit: 'rad' },
      { key: 'kRad', label: 'K chassis', unit: 'N·m/rad' },
      { key: 'kSus', label: 'K sus = (1/Kf + 1/Kr)⁻¹', unit: 'N·m/deg' },
      { key: 'kVehicle', label: 'K vehicle = (1/Kf + 1/Kr + 1/K chassis)⁻¹', unit: 'N·m/deg' },
    ]}
    stats={[
      { key: 'kDeg', label: 'K chassis (torsional stiffness)', unit: 'N·m/deg', ref: { typ: 'target ≥ 1600', src: 'Validation target' } },
      { key: 'kRelative', label: 'K relative = K chassis / K sus', unit: '%' },
    ]}
    contribute contributeNote="Writes K chassis (N·m/deg) to the shared store as the measured torsional stiffness — checked against the 1600 N·m/deg target in the Design report's Validation section." />

  <CalcTool id="tube" title="Tube stress & factor of safety" spec="TOOL_SPECS §2a"
    blurb="Axial stress and factor of safety for a round tube. (Torsional stiffness now comes from the twist-test tool.)"
    inputs={TUBE_INPUTS} outputs={TUBE_OUTPUTS}
    stats={[{ key: 'fos', label: 'Factor of safety (target ≥ 1.5)' }]} />

  <!-- Component-mass tracker: custom grid -->
  <section id="mass" class="card" style="margin-top:1.25rem;">
    <div style="display:flex;justify-content:space-between;align-items:baseline;gap:1rem;flex-wrap:wrap;">
      <h2 style="font-size:var(--fs-700);">Component-mass tracker</h2>
      <span class="badge">TOOL_SPECS §2b</span>
    </div>
    <p style="color:var(--ink-2);margin-top:0.35rem;font-size:var(--fs-300);">
      CAD estimate vs measured per component. CAD total = unit × qty; Δ = measured − CAD.
      Feeds the MassBudget (chassis mass as built). Saved for the whole team.
    </p>
    <div id="mass-ctrls"></div>
    <div style="overflow-x:auto;margin-top:0.8rem;">
      <table style="border-collapse:collapse;font-size:var(--fs-300);min-width:600px;">
        <thead><tr style="border-bottom:1px solid var(--rule-strong);text-align:left;">
          <th style={th} class="annot">Component</th>
          <th style={th + 'text-align:right;'} class="annot">CAD unit (kg)</th>
          <th style={th + 'text-align:right;'} class="annot">Qty</th>
          <th style={th + 'text-align:right;'} class="annot">CAD total</th>
          <th style={th + 'text-align:right;'} class="annot">Measured total</th>
          <th style={th + 'text-align:right;'} class="annot">Δ (meas−CAD)</th>
        </tr></thead>
        <tbody>
          {MASS_COMPONENTS.map((c) => (
            <tr style="border-bottom:1px solid var(--rule);">
              <td style={td}>{c.label}</td>
              <td style={td + 'text-align:right;'}><input type="number" step="any" class="field field-input" style={numInput} data-in={`unit_${c.key}`} value="0" aria-label={`${c.label} CAD unit`} /></td>
              <td style={td + 'text-align:right;'}><input type="number" step="any" class="field field-input" style={numInput} data-in={`qty_${c.key}`} value="0" aria-label={`${c.label} qty`} /></td>
              <td style={td + 'text-align:right;'}><span class="field field-computed mono" data-out={`cad_${c.key}`}>—</span></td>
              <td style={td + 'text-align:right;'}><input type="number" step="any" class="field field-input" style={numInput} data-in={`meas_${c.key}`} value="0" aria-label={`${c.label} measured`} /></td>
              <td style={td + 'text-align:right;'}><span class="field field-computed mono" data-out={`delta_${c.key}`}>—</span></td>
            </tr>
          ))}
          <tr style="border-top:2px solid var(--rule-strong);font-weight:600;">
            <td style={td}>TOTAL</td>
            <td style={td}></td>
            <td style={td}></td>
            <td style={td + 'text-align:right;'}><span class="field field-computed mono" data-out="totalCad">—</span></td>
            <td style={td + 'text-align:right;'}><span class="field field-computed mono" data-out="totalMeas">—</span></td>
            <td style={td + 'text-align:right;'}><span class="field field-computed mono" data-out="totalDelta">—</span></td>
          </tr>
        </tbody>
      </table>
    </div>
    <h3 style="font-size:var(--fs-500);margin-top:1.25rem;">Contribute to Master</h3>
    <p style="color:var(--ink-2);font-size:var(--fs-300);margin-top:0.3rem;">Writes chassis mass (as built = measured total) to the shared store (ToMaster → MassBudget).</p>
    <button class="btn btn-heritage" type="button" data-contribute style="margin-top:0.75rem;">Contribute results to Master</button>
    <span class="mono" data-contribute-status style="margin-left:0.6rem;font-size:var(--fs-200);color:var(--ink-3);"></span>
    <p class="mono" data-save-status style="margin-top:0.8rem;font-size:var(--fs-200);color:var(--ink-3);"></p>
  </section>

  <CalcTool id="buckling" title="Tube buckling (Euler)" spec="§9"
    blurb="Critical buckling load Pcr = π²EI/(KL)² for a round tube."
    inputs={[
      { key: 'od', label: 'Tube OD', unit: 'mm', vals: [25] },
      { key: 'id', label: 'Tube ID', unit: 'mm', vals: [21] },
      { key: 'eGpa', label: "Young's modulus E", unit: 'GPa', vals: [200], ref: { typ: 'steel 200' } },
      { key: 'length', label: 'Member length L', unit: 'mm', vals: [500] },
      { key: 'k', label: 'End-fixity K', unit: '-', vals: [1], ref: { typ: '0.5–2' } },
    ]}
    outputs={[{ key: 'inertia', label: 'Second moment I', unit: 'mm⁴' }]}
    stats={[{ key: 'pcr', label: 'Critical load Pcr', unit: 'N' }]} />

  <CalcTool id="bolt" title="Bolted joint" spec="§9"
    blurb="Proof load, 75% clamp, and tightening torque T = K·d·F for a fastener."
    inputs={[
      { key: 'tensileArea', label: 'Tensile stress area At', unit: 'mm²', vals: [58], ref: { typ: 'M10 ≈ 58' } },
      { key: 'proofStrength', label: 'Proof strength', unit: 'MPa', vals: [830], ref: { typ: '8.8≈580 · 10.9≈830' } },
      { key: 'kFactor', label: 'Nut factor K', unit: '-', vals: [0.2], ref: { typ: '0.18–0.22' } },
      { key: 'dia', label: 'Nominal diameter', unit: 'mm', vals: [10] },
    ]}
    outputs={[{ key: 'proofLoad', label: 'Proof load', unit: 'N' }, { key: 'clamp', label: 'Target clamp (75%)', unit: 'N' }]}
    stats={[{ key: 'torque', label: 'Tightening torque', unit: 'N·m' }]} />
  </CockpitShell>
</Base>

<script>
  import { mountCalculator } from '../lib/calc/engine';
  import { tubeCompute } from '../lib/calc/chassis-tube';
  import { impactCompute } from '../lib/calc/chassis-impact';
  import { stiffnessCompute } from '../lib/calc/chassis-stiffness';
  import { massCompute, MASS_COMPONENTS } from '../lib/calc/chassis-mass';
  import { tubeBucklingCompute, boltedJointCompute } from '../lib/calc/extras';
  import { mountListControls } from '../lib/list-controls';
  import { toCsv, parseCsv, missingColumns } from '../lib/csv';

  mountCalculator({
    root: 'impact', tool: 'chassis_impact', compute: impactCompute,
    digits: { front: 0, rear: 0, side: 0, frontKn: 2, rearKn: 2, sideKn: 2 },
  });

  mountCalculator({
    root: 'stiffness', tool: 'chassis_stiffness', compute: stiffnessCompute,
    digits: { torque: 1, thetaDeg: 4, thetaRad: 6, kRad: 0, kDeg: 0, kSus: 2, kVehicle: 2, kRelative: 2 },
    toMaster: [{ key: 'torsional_stiffness', label: 'Torsional stiffness (twist test)', unit: 'N·m/deg', from: 'kDeg' }],
  });

  mountCalculator({ root: 'tube', tool: 'chassis_tube', compute: tubeCompute, defaultDigits: 2 });

  mountCalculator({
    root: 'mass', tool: 'chassis_mass', compute: massCompute, defaultDigits: 2,
    toMaster: [{ key: 'chassis_mass_built', label: 'Chassis mass (as built)', unit: 'kg', from: 'totalMeas' }],
  });

  mountCalculator({ root: 'buckling', tool: 'chassis_buckling', compute: tubeBucklingCompute, digits: { inertia: 0, pcr: 0 } });
  mountCalculator({ root: 'bolt', tool: 'chassis_bolt', compute: boltedJointCompute, digits: { proofLoad: 0, clamp: 0, torque: 1 } });

  // CSV + presets for the component-mass tracker (P1.5). The grid is engine-
  // mounted, so after setting fields we dispatch 'input' to recompute + persist.
  const MCF = (key: string, f: string) => document.querySelector(`[data-in="${f}_${key}"]`) as HTMLInputElement | null;
  const MASS_CSV_COLS = ['component', 'cad_unit_kg', 'qty', 'measured_kg'];
  const massPing = () => (document.querySelector('#mass [data-in]') as HTMLInputElement | null)?.dispatchEvent(new Event('input', { bubbles: true }));
  function massGetCsv(): string {
    return toCsv(MASS_CSV_COLS, MASS_COMPONENTS.map((c) => {
      const g = (f: string) => { const el = MCF(c.key, f); return el && el.value.trim() !== '' ? el.value : ''; };
      return [c.label, g('unit'), g('qty'), g('meas')];
    }));
  }
  function massApplyCsv(text: string, mode: 'replace' | 'append'): string | void {
    const { headers, rows } = parseCsv(text);
    const miss = missingColumns(headers, ['component']);
    if (miss.length) return 'missing column(s): ' + miss.join(', ');
    const idx = (h: string) => headers.indexOf(h);
    const byLabel = new Map(MASS_COMPONENTS.map((c) => [c.label.toLowerCase(), c.key]));
    if (mode === 'replace') for (const c of MASS_COMPONENTS) for (const f of ['unit', 'qty', 'meas']) { const el = MCF(c.key, f); if (el) el.value = ''; }
    let matched = 0;
    for (const r of rows) {
      const key = byLabel.get((r[idx('component')] ?? '').trim().toLowerCase());
      if (!key) continue;
      matched++;
      const set = (f: string, col: string) => { const ci = idx(col); if (ci < 0) return; const v = (r[ci] ?? '').trim(); const el = MCF(key, f); if (el && v !== '') el.value = v; };
      set('unit', 'cad_unit_kg'); set('qty', 'qty'); set('meas', 'measured_kg');
    }
    massPing();
    if (!matched) return 'no component names matched';
  }
  function massGetRecord(): Record<string, number | null> {
    const rec: Record<string, number | null> = {};
    document.querySelectorAll<HTMLInputElement>('#mass [data-in]').forEach((el) => { rec[el.dataset.in!] = el.value === '' ? null : Number(el.value); });
    return rec;
  }
  function massApplyRecord(rec: Record<string, number | null>) {
    document.querySelectorAll<HTMLInputElement>('#mass [data-in]').forEach((el) => { const v = rec?.[el.dataset.in!]; el.value = v == null ? '' : String(v); });
    massPing();
  }
  mountListControls({
    container: document.getElementById('mass-ctrls')!,
    tool: 'chassis_mass', filename: 'component_mass.csv',
    getCsv: massGetCsv, applyCsv: massApplyCsv,
    getPresetPayload: massGetRecord, applyPreset: (p: any) => massApplyRecord(p ?? {}),
  });
</script>
