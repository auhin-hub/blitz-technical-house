---
import Base from '../layouts/Base.astro';
import WorkbookDownload from '../components/WorkbookDownload.astro';

const td = 'padding:0.45rem 0.6rem;';
const th = 'padding:0.5rem 0.6rem;';
const fieldCss = 'width:100%;margin-top:0.3rem;padding:0.5rem 0.6rem;background:var(--surface-2);border:1px solid var(--rule-strong);border-radius:var(--radius);color:var(--ink);font-family:var(--font-mono);font-size:var(--fs-300);';
// Fit-result fields rendered in the add form.
const FIELDS = [
  { key: 'tyre_label', label: 'Tyre (anonymised)', ph: 'Tyre A / 20.5×7-13', req: true, type: 'text' },
  { key: 'run', label: 'Run', ph: 'R8-xx', type: 'text' },
  { key: 'scope', label: 'Scope', ph: 'Fy pure / combined', type: 'text' },
  { key: 'r_squared', label: 'R²', ph: '0.98', type: 'number' },
  { key: 'rms', label: 'RMS', ph: '', type: 'number' },
  { key: 'lmux', label: 'LMUX', ph: 'if stamped', type: 'number' },
  { key: 'lmuy', label: 'LMUY', ph: 'if stamped', type: 'number' },
  { key: 'tir_link', label: '.tir link', ph: 'private link — not raw coeffs in repo', type: 'url' },
];
const R8_COLS = ['Run', 'Tyre (anon)', 'Size', 'Rim width', 'Test', 'Notes'];
---
<Base title="Tyre">
  <p class="annot annot-tick">Cross-cutting</p>
  <h1 style="margin-top:0.4rem;">Tyre</h1>
  <p style="color:var(--ink-2);margin-top:0.5rem;max-width:72ch;">
    Download the MATLAB tyre toolset, share and browse fit results, and keep the
    Round 8 run reference in one place.
  </p>

  <!-- Grip + licence caveat — stays visible wherever tyre results appear. -->
  <div class="notice notice-heritage" style="margin:1.25rem 0;">
    <strong>Belt-to-track grip caveat.</strong> TTC rig grip is measured on a belt
    surface, not the competition track — treat μ as <em>comparative</em>, not
    absolute. Anonymise tyres (size class or “Tyre A/B/C”), share summary numbers
    and plots (never full coefficient dumps), cite the TTC and acknowledge Calspan
    for any external use. Uploaded files live in private storage behind login.
  </div>

  <!-- Toolset download (private bucket, signed URL) -->
  <section class="card">
    <h2 style="font-size:var(--fs-600);">MATLAB tyre toolset</h2>
    <p style="color:var(--ink-2);margin-top:0.35rem;font-size:var(--fs-300);">
      Members run the fit in their own MATLAB/Octave. The archive is served behind
      login from private storage — not committed to the repo, not a public release.
    </p>
    <div style="margin-top:0.9rem;">
      <WorkbookDownload bucket="tyre" file="TTC_Tyre_Tool.rar" label="Download tyre toolset" />
    </div>
  </section>

  <!-- .tir upload + parse → Master (handoff P2.2) -->
  <section class="card" style="margin-top:1.25rem;">
    <h2 style="font-size:var(--fs-600);">Tyre file (.tir) → Master</h2>
    <p style="color:var(--ink-2);margin-top:0.35rem;font-size:var(--fs-300);max-width:72ch;">
      Load the Pacejka <span class="mono">.tir</span> your MATLAB fit produces. It's parsed
      in the browser; review the extracted parameters, then write them to the Vehicle
      Spec (Master). Optionally upload it to share with the team.
      <strong>Belt-rig (TTC) grip ≠ track grip</strong> — derate μ for the real surface.
    </p>
    <div style="display:flex;gap:0.6rem;flex-wrap:wrap;align-items:center;margin-top:0.8rem;">
      <input type="file" accept=".tir,text/plain" id="tir-file" />
      <label style="font-size:var(--fs-300);">Operating Fz <input type="number" step="any" id="tir-fz" placeholder="FNOMIN" style="width:90px;text-align:right;font-family:var(--font-mono);background:var(--surface-2);border:1px solid var(--rule);border-radius:var(--radius-sm);color:var(--ink);padding:0.2rem 0.4rem;" /> N</label>
      <label style="font-size:var(--fs-300);display:inline-flex;gap:0.3rem;align-items:center;"><input type="checkbox" id="tir-eff" /> use effective rolling radius (0.97×)</label>
    </div>
    <div id="tir-preview" style="margin-top:0.9rem;"></div>
    <div style="display:flex;gap:0.6rem;flex-wrap:wrap;margin-top:0.8rem;">
      <button class="btn btn-heritage" type="button" id="tir-write" disabled>Write to Master</button>
      <button class="btn btn-ghost" type="button" id="tir-upload" disabled>Upload to share</button>
      <span class="mono" id="tir-status" style="font-size:var(--fs-200);color:var(--ink-3);align-self:center;"></span>
    </div>
    <div id="tir-shared" style="margin-top:0.9rem;font-size:var(--fs-300);"></div>
  </section>

  <!-- Results library -->
  <section class="card" style="margin-top:1.25rem;">
    <h2 style="font-size:var(--fs-700);">Results library</h2>
    <p style="color:var(--ink-2);margin-top:0.35rem;font-size:var(--fs-300);">
      Share a fit: anonymised tyre, run, scope, R²/RMS, LMUX/LMUY if stamped, a
      link to the .tir, and a plot image. Others browse them below.
    </p>

    <details style="margin-top:1rem;">
      <summary style="cursor:pointer;font-family:var(--font-mono);font-size:var(--fs-300);color:var(--sky);">+ Add a fit result</summary>
      <form id="tyre-form" style="margin-top:0.9rem;max-width:720px;">
        <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));gap:0.75rem;">
          {FIELDS.map((f) => (
            <label style="font-size:var(--fs-300);color:var(--ink-2);">
              {f.label}{f.req && <span style="color:var(--heritage);"> *</span>}
              <input name={f.key} type={f.type as any} step="any" placeholder={f.ph} required={f.req} style={fieldCss} />
            </label>
          ))}
        </div>
        <label style="display:block;margin-top:0.75rem;font-size:var(--fs-300);color:var(--ink-2);">Notes
          <textarea name="notes" rows="2" style={fieldCss}></textarea>
        </label>
        <label style="display:block;margin-top:0.75rem;font-size:var(--fs-300);color:var(--ink-2);">Plot image (optional, ≤10 MB)
          <input name="plot" type="file" accept="image/*" style={fieldCss + 'font-family:var(--font-body);'} />
        </label>
        <button class="btn btn-halftone" type="submit" style="margin-top:1rem;">Share result</button>
        <span class="mono" id="tyre-form-status" style="margin-left:0.6rem;font-size:var(--fs-200);color:var(--ink-3);"></span>
      </form>
    </details>

    <div id="tyre-results" style="margin-top:1.5rem;"><p class="mono" style="color:var(--ink-3);">Sign in to load shared results.</p></div>
  </section>

  <!-- Round 8 reference -->
  <section class="card" style="margin-top:1.25rem;">
    <h2 style="font-size:var(--fs-600);">Round 8 run reference</h2>
    <p style="color:var(--ink-2);margin-top:0.35rem;font-size:var(--fs-300);">
      The TTC Round 8 run matrix (Calspan TIRF). Populate from the TTC
      documentation — runs are kept anonymised here; raw data stays with cleared members.
    </p>
    <div style="overflow-x:auto;margin-top:0.8rem;">
      <table style="width:100%;border-collapse:collapse;font-size:var(--fs-300);min-width:560px;">
        <thead><tr style="text-align:left;border-bottom:1px solid var(--rule-strong);">
          {R8_COLS.map((c) => <th style={th} class="annot">{c}</th>)}
        </tr></thead>
        <tbody>
          <tr><td style={td} colspan={R8_COLS.length}><span class="mono" style="color:var(--ink-3);">No runs recorded yet — add from the TTC Round 8 matrix.</span></td></tr>
        </tbody>
      </table>
    </div>
  </section>
</Base>

<script>
  import { loadTyreResults, addTyreResult, uploadTyrePlot, signedUrl, fmt, setMasterValue, uploadTir, listTir, type TyreResult } from '../lib/store';
  import { parseTir, tirToMaster, TIR_MASTER_MAP, type TirDerived } from '../lib/calc/tir';
  import { readFileText } from '../lib/csv';

  const listEl = document.getElementById('tyre-results')!;
  const form = document.getElementById('tyre-form') as HTMLFormElement | null;
  const status = document.getElementById('tyre-form-status');
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));

  async function card(r: TyreResult): Promise<string> {
    let plot = '';
    if (r.plot_path) {
      const u = await signedUrl('tyre', r.plot_path);
      if (u) plot = `<a href="${u}" target="_blank" rel="noopener"><img src="${u}" alt="fit plot" loading="lazy" style="margin-top:0.6rem;max-height:200px;border:1px solid var(--rule);border-radius:var(--radius);"></a>`;
    }
    const stat = (label: string, v: number | null) => v === null || v === undefined ? '' : `<span class="badge">${label} ${fmt(v, 3)}</span>`;
    return `<article class="card" style="background:var(--surface-2);">
      <div style="display:flex;justify-content:space-between;gap:0.75rem;flex-wrap:wrap;align-items:baseline;">
        <h3 style="font-size:var(--fs-500);">${esc(r.tyre_label)}</h3>
        <span class="mono" style="font-size:var(--fs-200);color:var(--ink-3);">${r.author_email ? esc(r.author_email) + ' · ' : ''}${new Date(r.created_at).toLocaleDateString()}</span>
      </div>
      <p class="mono" style="font-size:var(--fs-200);color:var(--ink-3);margin-top:0.2rem;">${esc(r.run ?? '')} ${r.scope ? '· ' + esc(r.scope) : ''}</p>
      <div style="display:flex;gap:0.4rem;flex-wrap:wrap;margin-top:0.6rem;">
        ${stat('R²', r.r_squared)}${stat('RMS', r.rms)}${stat('LMUX', r.lmux)}${stat('LMUY', r.lmuy)}
      </div>
      ${r.tir_link ? `<p style="margin-top:0.6rem;font-size:var(--fs-300);"><a href="${esc(r.tir_link)}" target="_blank" rel="noopener">.tir link ↗</a></p>` : ''}
      ${r.notes ? `<p style="margin-top:0.4rem;font-size:var(--fs-300);color:var(--ink-2);">${esc(r.notes)}</p>` : ''}
      ${plot}
    </article>`;
  }

  async function render() {
    const rows = await loadTyreResults();
    if (!rows.length) { listEl.innerHTML = '<p class="mono" style="color:var(--ink-3);">No results shared yet — add the first above.</p>'; return; }
    const cards = await Promise.all(rows.map(card));
    listEl.innerHTML = `<div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));">${cards.join('')}</div>`;
  }

  function num(v: FormDataEntryValue | null): number | null {
    const s = (v ?? '').toString().trim();
    if (s === '') return null;
    const n = Number(s); return Number.isFinite(n) ? n : null;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const label = (fd.get('tyre_label') ?? '').toString().trim();
    if (!label) { if (status) status.textContent = 'Tyre label is required.'; return; }
    if (status) { status.textContent = 'Uploading…'; status.style.color = 'var(--ink-3)'; }

    let plotPath: string | null = null;
    const plot = fd.get('plot') as File | null;
    if (plot && plot.size > 0) {
      if (plot.size > 10 * 1024 * 1024) { if (status) { status.textContent = 'Plot exceeds 10 MB.'; status.style.color = 'var(--heritage)'; } return; }
      const up = await uploadTyrePlot(plot);
      if (up.error) { if (status) { status.textContent = 'Plot upload failed: ' + up.error; status.style.color = 'var(--heritage)'; } return; }
      plotPath = up.path;
    }

    const err = await addTyreResult({
      tyre_label: label,
      run: (fd.get('run') ?? '').toString() || null,
      scope: (fd.get('scope') ?? '').toString() || null,
      r_squared: num(fd.get('r_squared')), rms: num(fd.get('rms')),
      lmux: num(fd.get('lmux')), lmuy: num(fd.get('lmuy')),
      tir_link: (fd.get('tir_link') ?? '').toString() || null,
      notes: (fd.get('notes') ?? '').toString() || null,
      plot_path: plotPath,
    });
    if (err) { if (status) { status.textContent = 'Save failed: ' + err; status.style.color = 'var(--heritage)'; } return; }
    if (status) { status.textContent = 'Shared ✓'; status.style.color = 'var(--state-linked)'; }
    form.reset();
    render();
  });

  render();

  // ---- .tir parse → Master (P2.2) ----
  const tirFile = document.getElementById('tir-file') as HTMLInputElement;
  const tirFz = document.getElementById('tir-fz') as HTMLInputElement;
  const tirEff = document.getElementById('tir-eff') as HTMLInputElement;
  const tirPreview = document.getElementById('tir-preview')!;
  const tirWrite = document.getElementById('tir-write') as HTMLButtonElement;
  const tirUpload = document.getElementById('tir-upload') as HTMLButtonElement;
  const tirStatus = document.getElementById('tir-status')!;
  const tirShared = document.getElementById('tir-shared')!;
  let tirCoef: Record<string, number> | null = null;
  let tirFileRef: File | null = null;

  const tirSay = (m: string, ok = true) => { tirStatus.textContent = m; tirStatus.style.color = ok ? 'var(--state-linked)' : 'var(--heritage)'; };
  const rollRadius = (d: TirDerived) => (tirEff.checked ? d.rollingRadiusEffective : d.rollingRadiusUnloaded);

  function renderTirPreview() {
    if (!tirCoef) { tirPreview.innerHTML = ''; tirWrite.disabled = true; return; }
    const fz = tirFz.value.trim() === '' ? undefined : Number(tirFz.value);
    const d = tirToMaster(tirCoef, fz);
    const rr = rollRadius(d);
    const rows: string[] = [];
    const row = (label: string, v: number | undefined, unit: string, key: string) =>
      v === undefined ? '' : `<tr><td style="padding:0.2rem 0.5rem;">${label}</td><td style="padding:0.2rem 0.5rem;text-align:right;" class="mono">${fmt(v, 3)}</td><td style="padding:0.2rem 0.5rem;" class="mono">${unit}</td><td style="padding:0.2rem 0.5rem;color:var(--ink-3);" class="mono">→ ${key}</td></tr>`;
    rows.push(row(`Rolling radius (${tirEff.checked ? 'effective' : 'unloaded'})`, rr, 'mm', 'rolling_radius'));
    for (const m of TIR_MASTER_MAP) rows.push(row(m.label, d[m.field] as number | undefined, m.unit, m.key));
    const any = rows.some((r) => r);
    tirPreview.innerHTML = any
      ? `<p class="mono" style="font-size:var(--fs-200);color:var(--ink-3);">Evaluated at Fz = ${d.operatingFz ?? 'FNOMIN'} N${tirCoef.FNOMIN ? ` (FNOMIN ${tirCoef.FNOMIN})` : ''}.</p>
         <table style="border-collapse:collapse;font-size:var(--fs-300);margin-top:0.3rem;"><tbody>${rows.join('')}</tbody></table>`
      : '<p class="mono" style="color:var(--heritage);">No recognised coefficients (need UNLOADED_RADIUS, VERTICAL_STIFFNESS, PDY1, PKY1/PKY2…).</p>';
    tirWrite.disabled = !any;
  }

  tirFile.addEventListener('change', async () => {
    const f = tirFile.files?.[0]; tirFileRef = f ?? null; tirUpload.disabled = !f;
    if (!f) { tirCoef = null; renderTirPreview(); return; }
    try { tirCoef = parseTir(await readFileText(f)); tirSay('parsed ✓'); } catch (e) { tirSay('Parse failed: ' + (e as Error).message, false); tirCoef = null; }
    renderTirPreview();
  });
  tirFz.addEventListener('input', renderTirPreview);
  tirEff.addEventListener('change', renderTirPreview);

  tirWrite.addEventListener('click', async () => {
    if (!tirCoef) return;
    const fz = tirFz.value.trim() === '' ? undefined : Number(tirFz.value);
    const d = tirToMaster(tirCoef, fz);
    const writes: [string, number | undefined][] = [['rolling_radius', rollRadius(d)], ...TIR_MASTER_MAP.map((m) => [m.key, d[m.field] as number | undefined] as [string, number | undefined])];
    tirSay('Writing…', true); tirStatus.style.color = 'var(--ink-3)';
    const errs: string[] = [];
    for (const [k, v] of writes) { if (v === undefined || !Number.isFinite(v)) continue; const e = await setMasterValue(k, +v.toFixed(4)); if (e) errs.push(`${k} (frozen?)`); }
    tirSay(errs.length ? 'Some skipped: ' + errs.join(', ') : 'Written to Master ✓', !errs.length);
  });

  tirUpload.addEventListener('click', async () => {
    if (!tirFileRef) return;
    if (tirFileRef.size > 10 * 1024 * 1024) return tirSay('File exceeds 10 MB.', false);
    tirSay('Uploading…', true); tirStatus.style.color = 'var(--ink-3)';
    const up = await uploadTir(tirFileRef);
    tirSay(up.error ? 'Upload failed: ' + up.error : 'Uploaded ✓', !up.error);
    if (!up.error) renderShared();
  });

  async function renderShared() {
    const files = await listTir();
    if (!files.length) { tirShared.innerHTML = ''; return; }
    const links = await Promise.all(files.map(async (f) => {
      const u = await signedUrl('tyre', f.path);
      return u ? `<li><a href="${u}" target="_blank" rel="noopener">${esc(f.name)} ↗</a></li>` : `<li>${esc(f.name)}</li>`;
    }));
    tirShared.innerHTML = `<p class="annot">Shared .tir files</p><ul style="margin-top:0.3rem;padding-left:1.1rem;">${links.join('')}</ul>`;
  }
  renderShared();
</script>
