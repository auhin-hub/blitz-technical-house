---
import Base from '../layouts/Base.astro';
import LegendKey from '../components/LegendKey.astro';
import WorkbookDownload from '../components/WorkbookDownload.astro';
import CalcTool from '../components/CalcTool.astro';
import CockpitShell from '../components/CockpitShell.astro';
import { url, DISCIPLINES } from '../lib/config';
import { LOADS } from '../lib/calc/elec-power';

const el = DISCIPLINES.find((d) => d.slug === 'electronics')!;

const POWER_INPUTS = [
  ...LOADS.map((l, i) => ({ key: l.key, label: l.label, unit: 'A', vals: [[3, 5, 8, 2, 2, 6][i]] })),
  { key: 'stator', label: 'Stator output', unit: 'A', vals: [22.1] },
  { key: 'mainFuse', label: 'Main fuse', unit: 'A', vals: [150] },
  { key: 'batteryMass', label: 'Battery mass (→ MassBudget)', unit: 'kg', vals: [4] },
];
const POWER_OUTPUTS = [{ key: 'total', label: 'Total current = SUM(loads)', unit: 'A' }];
---
<Base title={el.title} description={el.blurb}>
  <nav class="annot" style="margin-bottom:0.75rem;">
    <a href={url('')} style="color:inherit;">Home</a> / {el.title}
  </nav>
  <header style="margin-bottom:1.25rem;">
    <p class="annot annot-tick">Discipline</p>
    <h1 style="margin-top:0.4rem;">{el.title}</h1>
    <p style="color:var(--ink-2);margin-top:0.5rem;max-width:72ch;">{el.blurb}</p>
    <div style="margin-top:1rem;">{el.workbook && <WorkbookDownload file={el.workbook} />}</div>
  </header>


  <div class="notice" style="margin-bottom:1.5rem;">
    <strong>Blue = your inputs (saved for the team); black = computed.</strong>
  </div>
  <LegendKey />

  <div style="margin-top:1.25rem;"></div>
  <CockpitShell tools={[{ id: 'power', title: 'Power budget' }, { id: 'wiring', title: 'Wiring / harness' }, { id: 'daq', title: 'DAQ & Telemetry' }, { id: 'battery', title: 'Battery sizing' }, { id: 'wiredrop', title: 'Wire voltage drop' }]} railLabel="Electronics">
  <CalcTool id="power" title="Power budget" spec="TOOL_SPECS §4a"
    blurb="Load currents vs stator output; margin must stay positive."
    inputs={POWER_INPUTS} outputs={POWER_OUTPUTS}
    stats={[{ key: 'margin', label: 'Margin (stator − load)', unit: 'A' }]}
    chartId="power-chart" chartTitle="Current draw by load (vs stator output)" chartHeight={260}
    contribute contributeNote="Writes battery mass (→ MassBudget) and total current draw to the shared store." />

  <!-- Wiring / harness list: an editable grid is a later enhancement (BRIEF §4b). -->
  <section id="wiring" class="card" style="margin-top:1.25rem;">
    <div style="display:flex;justify-content:space-between;align-items:baseline;gap:1rem;flex-wrap:wrap;">
      <h2 style="font-size:var(--fs-600);">Wiring / harness list</h2>
      <span class="badge">TOOL_SPECS §4b</span>
    </div>
    <p style="color:var(--ink-2);margin-top:0.35rem;font-size:var(--fs-300);">
      One row per wire. Shared across the team and saved as you type.
    </p>
    <div style="overflow-x:auto;margin-top:0.8rem;">
      <table style="border-collapse:collapse;font-size:var(--fs-300);min-width:820px;" id="wiring-table">
        <thead><tr style="border-bottom:1px solid var(--rule-strong);text-align:left;">
          <th style="padding:0.4rem 0.5rem;" class="annot">#</th>
          <th style="padding:0.4rem 0.5rem;" class="annot">Src comp</th>
          <th style="padding:0.4rem 0.5rem;" class="annot">Source name</th>
          <th style="padding:0.4rem 0.5rem;" class="annot">Connector</th>
          <th style="padding:0.4rem 0.5rem;" class="annot">Pins</th>
          <th style="padding:0.4rem 0.5rem;" class="annot">Dst comp</th>
          <th style="padding:0.4rem 0.5rem;" class="annot">Destination name</th>
          <th style="padding:0.4rem 0.5rem;" class="annot">Pin #</th>
          <th style="padding:0.4rem 0.5rem;" class="annot">Colour</th>
          <th style="padding:0.4rem 0.5rem;"></th>
        </tr></thead>
        <tbody id="wiring-body"></tbody>
      </table>
    </div>
    <div style="display:flex;gap:0.6rem;align-items:center;margin-top:0.8rem;">
      <button class="btn btn-ghost" type="button" id="wiring-add">+ Add wire</button>
      <span class="mono" id="wiring-status" style="font-size:var(--fs-200);color:var(--ink-3);"></span>
    </div>
    <div id="wiring-ctrls"></div>
    <p class="mono" style="margin-top:0.8rem;font-size:var(--fs-200);color:var(--ink-3);">
      Colour code (DIN): bl black · br brown · bu blue · gn green · rd red · ws white · ye yellow · gy grey · og orange · vt violet · pk pink
    </p>
  </section>

  <!-- DAQ / Telemetry: editable channel plan (P2.4) -->
  <section id="daq" class="card" style="margin-top:1.25rem;">
    <div style="display:flex;justify-content:space-between;align-items:baseline;gap:1rem;flex-wrap:wrap;">
      <h2 style="font-size:var(--fs-700);">DAQ & Telemetry</h2>
      <span class="badge">TOOL_SPECS §3 · P2.4</span>
    </div>
    <p style="color:var(--ink-2);margin-top:0.35rem;font-size:var(--fs-300);">
      The sensor/logging channel plan — editable, grouped by subsystem. CAN bus load
      per channel = rate × bytes × 8 × qty; keep total utilisation under 60–70%.
      Export/import the full plan (all columns) via CSV; the grid shows the key ones.
      Got a test log? <a href={url('daq')}>Interpret it against the design →</a>
    </p>
    <div id="daq-ctrls"></div>
    <div style="overflow-x:auto;margin-top:0.6rem;">
      <table style="border-collapse:collapse;font-size:var(--fs-300);min-width:720px;">
        <thead><tr style="border-bottom:1px solid var(--rule-strong);text-align:left;">
          <th style="padding:0.4rem 0.5rem;" class="annot">ID</th>
          <th style="padding:0.4rem 0.5rem;" class="annot">Channel</th>
          <th style="padding:0.4rem 0.5rem;" class="annot">Sensor</th>
          <th style="padding:0.4rem 0.5rem;" class="annot">Subsystem</th>
          <th style="padding:0.4rem 0.5rem;text-align:right;" class="annot">Qty</th>
          <th style="padding:0.4rem 0.5rem;text-align:right;" class="annot">Rate Hz</th>
          <th style="padding:0.4rem 0.5rem;text-align:right;" class="annot">Bytes</th>
          <th style="padding:0.4rem 0.5rem;text-align:right;" class="annot">Load bit/s</th>
          <th style="padding:0.4rem 0.5rem;"></th>
        </tr></thead>
        <tbody id="daq-body"></tbody>
        <tfoot><tr style="border-top:2px solid var(--rule-strong);font-weight:600;">
          <td style="padding:0.4rem 0.5rem;" colspan="7">Total bus load</td>
          <td style="padding:0.4rem 0.5rem;text-align:right;" class="mono"><span id="daq-total">—</span></td><td></td>
        </tr></tfoot>
      </table>
    </div>
    <div style="display:flex;gap:0.6rem;align-items:center;margin-top:0.6rem;flex-wrap:wrap;">
      <button class="btn btn-ghost" type="button" id="daq-add">+ Add channel</button>
      <button class="btn btn-ghost" type="button" id="daq-reset" style="font-size:var(--fs-200);">Reset to default plan</button>
      <label style="font-size:var(--fs-300);margin-left:auto;">CAN capacity
        <input type="number" step="any" id="daq-capacity" value="500000" style="width:110px;text-align:right;font-family:var(--font-mono);background:var(--surface-2);border:1px solid var(--rule);border-radius:var(--radius-sm);color:var(--ink);padding:0.22rem 0.4rem;margin-left:0.3rem;" aria-label="CAN capacity bit/s" /> bit/s</label>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,210px),1fr));gap:0.6rem;margin-top:1rem;">
      <div class="card" style="background:var(--surface-2);">
        <span class="annot">Bus utilisation (keep &lt; 60–70%)</span>
        <p class="mono" style="font-size:var(--fs-700);margin-top:0.3rem;"><span id="daq-util">—</span>%</p>
      </div>
    </div>

    <h3 style="font-size:var(--fs-500);margin-top:1rem;">Load by subsystem</h3>
    <div style="margin-top:0.4rem;height:240px;position:relative;"><canvas id="daq-chart"></canvas></div>

    <h3 style="font-size:var(--fs-500);margin-top:1.25rem;">Contribute to Master</h3>
    <button class="btn btn-heritage" type="button" id="daq-contribute" style="margin-top:0.5rem;">Contribute results to Master</button>
    <span class="mono" id="daq-contribute-status" style="margin-left:0.6rem;font-size:var(--fs-200);color:var(--ink-3);"></span>
    <p class="mono" id="daq-save-status" style="margin-top:0.8rem;font-size:var(--fs-200);color:var(--ink-3);"></p>
  </section>

  <CalcTool id="battery" title="Battery sizing" spec="§9"
    blurb="Required capacity for an endurance run from the average current draw, derated for depth of discharge (don't fully flatten the pack)."
    inputs={[
      { key: 'loadA', label: 'Average load current', unit: 'A', vals: [26], ref: { typ: 'from Power budget' } },
      { key: 'timeMin', label: 'Endurance time', unit: 'min', vals: [25], ref: { typ: '~22–25' } },
      { key: 'dodPct', label: 'Usable depth of discharge', unit: '%', vals: [80], ref: { typ: 'LiFePO₄ 80' } },
      { key: 'voltage', label: 'System voltage', unit: 'V', vals: [12] },
    ]}
    outputs={[{ key: 'wh', label: 'Energy = Ah × V', unit: 'Wh' }]}
    stats={[{ key: 'ah', label: 'Required capacity', unit: 'Ah' }]} />

  <CalcTool id="wiredrop" title="Wire voltage drop" spec="§9"
    blurb="Round-trip voltage drop and % drop for a wire run (copper), so you can size gauge against the 3% rule of thumb."
    inputs={[
      { key: 'areaMm2', label: 'Conductor area', unit: 'mm²', vals: [2.5], ref: { typ: 'AWG13 ≈ 2.6' } },
      { key: 'lengthM', label: 'Run length (one way)', unit: 'm', vals: [3] },
      { key: 'currentA', label: 'Current', unit: 'A', vals: [20] },
      { key: 'systemV', label: 'System voltage', unit: 'V', vals: [12] },
    ]}
    outputs={[{ key: 'resistance', label: 'Loop resistance', unit: 'mΩ' }, { key: 'drop', label: 'Voltage drop', unit: 'V' }]}
    stats={[{ key: 'dropPct', label: '% drop (keep < 3%)', unit: '%' }]} />
  </CockpitShell>
</Base>

<script>
  import Chart from 'chart.js/auto';
  import { mountCalculator } from '../lib/calc/engine';
  import { powerCompute, LOADS } from '../lib/calc/elec-power';
  import { batteryCompute, wireDropCompute } from '../lib/calc/extras';
  import { DAQ_PLAN_SEED, DAQ_COLS, channelBusLoad, type DaqChannel } from '../lib/calc/daq-plan';
  import { loadToolJson, saveToolJson, saveToolOutputs, debounce } from '../lib/store';
  import { mountListControls } from '../lib/list-controls';
  import { toCsv, parseCsv, missingColumns } from '../lib/csv';
  import { applyChartDefaults, palette, watchTheme } from '../lib/chart-theme';

  // ---- Wiring / harness grid (shared editable rows) ----
  type Wire = { srcComp: string; srcName: string; connector: string; pins: string; dstComp: string; dstName: string; pin: string; colour: string };
  const WIRE_COLS: (keyof Wire)[] = ['srcComp', 'srcName', 'connector', 'pins', 'dstComp', 'dstName', 'pin', 'colour'];
  const emptyWire = (): Wire => ({ srcComp: '', srcName: '', connector: '', pins: '', dstComp: '', dstName: '', pin: '', colour: '' });
  const body = document.getElementById('wiring-body')!;
  const wStatus = document.getElementById('wiring-status')!;
  let wires: Wire[] = [];

  const saveWires = debounce(async () => {
    wStatus.textContent = 'Saving…';
    const err = await saveToolJson('elec_wiring', { rows: wires });
    wStatus.textContent = err ? 'Save failed: ' + err : 'Saved ✓';
    wStatus.style.color = err ? 'var(--heritage)' : 'var(--state-linked)';
  }, 600);

  function renderWires() {
    body.innerHTML = wires.map((w, i) => `
      <tr style="border-bottom:1px solid var(--rule);">
        <td style="padding:0.3rem 0.4rem;" class="mono">${i + 1}</td>
        ${WIRE_COLS.map((c) => `<td style="padding:0.3rem 0.4rem;"><input data-i="${i}" data-c="${c}" value="${(w[c] ?? '').replace(/"/g, '&quot;')}" style="width:100px;background:var(--surface-2);border:1px solid var(--rule);border-radius:var(--radius-sm);color:var(--ink);padding:0.25rem 0.4rem;font-family:var(--font-mono);font-size:var(--fs-200);"></td>`).join('')}
        <td style="padding:0.3rem 0.4rem;"><button class="btn btn-ghost" data-del="${i}" style="font-size:var(--fs-200);padding:0.2rem 0.5rem;">✕</button></td>
      </tr>`).join('');
    body.querySelectorAll<HTMLInputElement>('input[data-i]').forEach((inp) =>
      inp.addEventListener('input', () => { (wires[+inp.dataset.i!] as any)[inp.dataset.c!] = inp.value; saveWires(); }));
    body.querySelectorAll<HTMLButtonElement>('[data-del]').forEach((b) =>
      b.addEventListener('click', () => { wires.splice(+b.dataset.del!, 1); renderWires(); saveWires(); }));
  }

  document.getElementById('wiring-add')!.addEventListener('click', () => { wires.push(emptyWire()); renderWires(); saveWires(); });

  (async () => {
    const data = await loadToolJson<{ rows: Wire[] }>('elec_wiring', { rows: [] });
    wires = Array.isArray(data.rows) ? data.rows : [];
    if (wires.length === 0) wires = [emptyWire()];
    renderWires();
  })();

  // CSV + presets for the wiring list (P1.5).
  function wiringGetCsv(): string {
    return toCsv(WIRE_COLS as string[], wires.map((w) => WIRE_COLS.map((c) => w[c] ?? '')));
  }
  function wiringApplyCsv(text: string, mode: 'replace' | 'append'): string | void {
    const { headers, rows } = parseCsv(text);
    if (!WIRE_COLS.some((c) => headers.includes(c))) return 'no recognised columns (expected srcName, connector, …)';
    const idx = (h: string) => headers.indexOf(h);
    const mapped = rows.map((r) => {
      const w = emptyWire();
      for (const c of WIRE_COLS) { const ci = idx(c); if (ci >= 0) (w as any)[c] = (r[ci] ?? '').trim(); }
      return w;
    });
    wires = mode === 'append' ? wires.concat(mapped) : mapped;
    if (wires.length === 0) wires = [emptyWire()];
    renderWires(); saveWires();
  }
  mountListControls({
    container: document.getElementById('wiring-ctrls')!,
    tool: 'elec_wiring', filename: 'wiring_harness.csv',
    getCsv: wiringGetCsv, applyCsv: wiringApplyCsv,
    getPresetPayload: () => ({ rows: wires }),
    applyPreset: (p: any) => { wires = Array.isArray(p?.rows) ? p.rows : []; if (wires.length === 0) wires = [emptyWire()]; renderWires(); saveWires(); },
  });

  const noOpts = { responsive: true, maintainAspectRatio: false, plugins: { legend: { labels: { usePointStyle: true } } } };

  mountCalculator({
    root: 'power', tool: 'elec_power', compute: powerCompute, defaultDigits: 2,
    charts: [{
      canvasId: 'power-chart',
      build: ({ inp, pal }) => ({
        type: 'bar',
        data: {
          labels: LOADS.map((l) => l.label),
          datasets: [
            { label: 'Load current (A)', data: LOADS.map((l) => inp[l.key]), backgroundColor: pal.sky },
            { label: 'Stator output (A)', type: 'line', data: LOADS.map(() => inp.stator), borderColor: pal.maroon, borderDash: [6, 4], pointRadius: 0 },
          ],
        },
        options: { ...noOpts, scales: { y: { title: { display: true, text: 'A' } } } },
      }),
    }],
    toMaster: [
      { key: 'battery_mass', label: 'Battery mass', unit: 'kg', from: 'batteryMass' },
      { key: 'total_current_draw', label: 'Total current draw', unit: 'A', from: 'total' },
    ],
  });

  mountCalculator({ root: 'battery', tool: 'elec_battery', compute: batteryCompute, digits: { ah: 1, wh: 0 } });
  mountCalculator({ root: 'wiredrop', tool: 'elec_wiredrop', compute: wireDropCompute, digits: { resistance: 1, drop: 3, dropPct: 1 } });

  // ---- DAQ channel plan (editable list, P2.4) ----
  const daqBody = document.getElementById('daq-body')!;
  const daqSave = document.getElementById('daq-save-status')!;
  let channels: DaqChannel[] = [];
  let daqChart: Chart | null = null;
  const txtS = 'background:var(--surface-2);border:1px solid var(--rule);border-radius:var(--radius-sm);color:var(--ink);padding:0.2rem 0.35rem;font-size:var(--fs-200);';
  const numS = txtS + 'width:62px;text-align:right;font-family:var(--font-mono);';
  const escA = (s: string) => (s ?? '').replace(/"/g, '&quot;');
  const DAQ_NUM = new Set(['qty', 'rate_hz', 'bytes_per_sample']);
  const emptyChannel = (): DaqChannel => ({ channel_id: '', channel_name: '', sensor_type: '', qty: 1, location: '', rate_hz: 0, bytes_per_sample: 1, unit: '', range_min: null, range_max: null, subsystem: '', validates: '', notes: '' });
  const capEl = () => document.getElementById('daq-capacity') as HTMLInputElement;

  const daqSaveDeb = debounce(async () => {
    daqSave.textContent = 'Saving…';
    const err = await saveToolJson('daq', { channels });
    daqSave.textContent = err ? 'Save failed: ' + err : 'Saved ✓';
    daqSave.style.color = err ? 'var(--heritage)' : 'var(--state-linked)';
  }, 600);

  function daqRecompute() {
    let total = 0;
    channels.forEach((c, i) => {
      const load = channelBusLoad(c); total += load;
      const cell = daqBody.querySelector(`[data-load="${i}"]`); if (cell) cell.textContent = String(load);
    });
    const cap = Number(capEl().value) || 0;
    const util = cap > 0 ? (total / cap) * 100 : NaN;
    document.getElementById('daq-total')!.textContent = String(total);
    document.getElementById('daq-util')!.textContent = Number.isFinite(util) ? util.toFixed(1) : '—';
    const by: Record<string, number> = {};
    for (const c of channels) { const s = c.subsystem || '—'; by[s] = (by[s] ?? 0) + channelBusLoad(c); }
    const labels = Object.keys(by);
    const p = palette();
    const cfg: any = { type: 'bar', data: { labels, datasets: [{ label: 'bit/s', data: labels.map((l) => by[l]), backgroundColor: p.sky }] },
      options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { title: { display: true, text: 'bit/s' } } } } };
    if (daqChart) { daqChart.data = cfg.data; daqChart.options = cfg.options; daqChart.update(); }
    else { const cv = document.getElementById('daq-chart') as HTMLCanvasElement | null; if (cv) daqChart = new Chart(cv, cfg); }
  }

  function renderDaq() {
    daqBody.innerHTML = channels.map((c, i) => `
      <tr style="border-bottom:1px solid var(--rule);">
        <td style="padding:0.2rem 0.35rem;"><input data-i="${i}" data-k="channel_id" value="${escA(c.channel_id)}" style="${txtS}width:52px;" aria-label="id"></td>
        <td style="padding:0.2rem 0.35rem;"><input data-i="${i}" data-k="channel_name" value="${escA(c.channel_name)}" style="${txtS}width:150px;" aria-label="channel"></td>
        <td style="padding:0.2rem 0.35rem;"><input data-i="${i}" data-k="sensor_type" value="${escA(c.sensor_type)}" style="${txtS}width:120px;" aria-label="sensor"></td>
        <td style="padding:0.2rem 0.35rem;"><input data-i="${i}" data-k="subsystem" value="${escA(c.subsystem)}" list="daq-subsystems" style="${txtS}width:100px;" aria-label="subsystem"></td>
        <td style="padding:0.2rem 0.35rem;text-align:right;"><input type="number" step="any" data-i="${i}" data-k="qty" value="${c.qty}" style="${numS}" aria-label="qty"></td>
        <td style="padding:0.2rem 0.35rem;text-align:right;"><input type="number" step="any" data-i="${i}" data-k="rate_hz" value="${c.rate_hz}" style="${numS}" aria-label="rate"></td>
        <td style="padding:0.2rem 0.35rem;text-align:right;"><input type="number" step="any" data-i="${i}" data-k="bytes_per_sample" value="${c.bytes_per_sample}" style="${numS}" aria-label="bytes"></td>
        <td style="padding:0.2rem 0.35rem;text-align:right;" class="mono" data-load="${i}">—</td>
        <td style="padding:0.2rem 0.35rem;"><button class="btn btn-ghost" data-del="${i}" style="font-size:var(--fs-200);padding:0.15rem 0.45rem;" aria-label="delete">✕</button></td>
      </tr>`).join('') +
      `<datalist id="daq-subsystems">${[...new Set(channels.map((c) => c.subsystem).filter(Boolean))].map((s) => `<option value="${escA(s)}">`).join('')}</datalist>`;
    daqBody.querySelectorAll<HTMLInputElement>('input[data-i]').forEach((inp) => {
      const i = +inp.dataset.i!, k = inp.dataset.k! as keyof DaqChannel;
      inp.addEventListener('input', () => {
        (channels[i] as any)[k] = DAQ_NUM.has(k) ? (inp.value.trim() === '' ? 0 : Number(inp.value)) : inp.value;
        daqRecompute(); daqSaveDeb();
      });
    });
    daqBody.querySelectorAll<HTMLButtonElement>('[data-del]').forEach((b) =>
      b.addEventListener('click', () => { channels.splice(+b.dataset.del!, 1); if (!channels.length) channels = [emptyChannel()]; renderDaq(); daqRecompute(); daqSaveDeb(); }));
  }

  function daqGetCsv(): string {
    return toCsv(DAQ_COLS as string[], channels.map((c) => DAQ_COLS.map((k) => c[k] ?? '')));
  }
  function daqApplyCsv(text: string, mode: 'replace' | 'append'): string | void {
    const { headers, rows } = parseCsv(text);
    const miss = missingColumns(headers, ['channel_name']);
    if (miss.length) return 'missing column(s): ' + miss.join(', ');
    const idx = (h: string) => headers.indexOf(h);
    const g = (r: string[], h: string) => { const i = idx(h); return i < 0 ? '' : (r[i] ?? '').trim(); };
    const toNum = (s: string, d = 0) => { const v = s.trim(); return v === '' ? d : Number(v); };
    const toNull = (s: string) => { const v = (s ?? '').trim(); return v === '' ? null : Number(v); };
    const parsed: DaqChannel[] = rows.filter((r) => g(r, 'channel_name') !== '').map((r) => ({
      channel_id: g(r, 'channel_id'), channel_name: g(r, 'channel_name'), sensor_type: g(r, 'sensor_type'),
      qty: toNum(g(r, 'qty'), 1), location: g(r, 'location'), rate_hz: toNum(g(r, 'rate_hz'), 0),
      bytes_per_sample: toNum(g(r, 'bytes_per_sample'), 1), unit: g(r, 'unit'),
      range_min: toNull(g(r, 'range_min')), range_max: toNull(g(r, 'range_max')),
      subsystem: g(r, 'subsystem'), validates: g(r, 'validates'), notes: g(r, 'notes'),
    }));
    if (!parsed.length) return 'no rows with a channel_name';
    channels = mode === 'append' ? channels.concat(parsed) : parsed;
    renderDaq(); daqRecompute(); daqSaveDeb();
  }

  document.getElementById('daq-add')!.addEventListener('click', () => { channels.push(emptyChannel()); renderDaq(); daqSaveDeb(); });
  document.getElementById('daq-reset')!.addEventListener('click', () => { if (!confirm('Replace all channels with the default plan?')) return; channels = DAQ_PLAN_SEED.map((c) => ({ ...c })); renderDaq(); daqRecompute(); daqSaveDeb(); });
  capEl().addEventListener('input', daqRecompute);

  document.getElementById('daq-contribute')!.addEventListener('click', async () => {
    const st = document.getElementById('daq-contribute-status')!;
    st.textContent = 'Saving…'; st.style.color = 'var(--ink-3)';
    const total = channels.reduce((s, c) => s + channelBusLoad(c), 0);
    const cap = Number(capEl().value) || 0;
    const util = cap > 0 ? (total / cap) * 100 : null;
    const err = await saveToolOutputs('daq', [{ key: 'bus_utilisation', label: 'CAN bus utilisation', value: util == null ? null : +util.toFixed(2), unit: '%' }]);
    st.textContent = err ? 'Failed: ' + err : 'Contributed ✓';
    st.style.color = err ? 'var(--heritage)' : 'var(--state-linked)';
  });

  mountListControls({
    container: document.getElementById('daq-ctrls')!,
    tool: 'daq', filename: 'daq_channel_plan.csv',
    getCsv: daqGetCsv, applyCsv: daqApplyCsv,
    getPresetPayload: () => ({ channels }),
    applyPreset: (p: any) => { if (Array.isArray(p?.channels)) { channels = p.channels; if (!channels.length) channels = [emptyChannel()]; renderDaq(); daqRecompute(); daqSaveDeb(); } },
  });

  (async () => {
    applyChartDefaults();
    const saved = await loadToolJson<any>('daq', {});
    channels = Array.isArray(saved?.channels) ? saved.channels : DAQ_PLAN_SEED.map((c) => ({ ...c }));
    if (!channels.length) channels = DAQ_PLAN_SEED.map((c) => ({ ...c }));
    renderDaq(); daqRecompute();
    watchTheme(() => { applyChartDefaults(); daqRecompute(); });
  })();
</script>
