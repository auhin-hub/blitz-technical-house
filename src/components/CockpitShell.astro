---
/**
 * Two-pane cockpit (MASTER_BUILD_PLAN §2): a slim tool rail + a single-viewport
 * tool area. The discipline's tool sections are passed as the default slot (each
 * a <section> whose id matches a rail entry); only the selected one is shown.
 * On mobile the rail becomes a horizontal chip strip.
 *
 * Props: tools = [{ id, title, rare? }] in rail order (first is shown by default).
 * `rare` tools (config.ts Tool.rare) go in a collapsed "More tools" disclosure at
 * the bottom of the rail; they stay reachable by search / #hash (which opens it).
 */
interface ToolRef { id: string; title: string; rare?: boolean; }
const { tools, railLabel = 'Tools' } = Astro.props as { tools: ToolRef[]; railLabel?: string };
const main = tools.filter((t) => !t.rare);
const more = tools.filter((t) => t.rare);
---
<div class="cockpit-shell" data-cockpit>
  <nav class="cockpit-rail" aria-label={`${railLabel} — select a calculator`}>
    <span class="rail-label">{railLabel}</span>
    {main.map((t, i) => (
      <button class="cockpit-toolbtn" type="button" data-tool={t.id} aria-current={i === 0 ? 'true' : 'false'}>
        {t.title}
      </button>
    ))}
    {more.length > 0 && (
      <details class="rail-more">
        <summary>More tools <span class="rail-more-n">{more.length}</span></summary>
        {more.map((t) => (
          <button class="cockpit-toolbtn" type="button" data-tool={t.id} aria-current="false">{t.title}</button>
        ))}
      </details>
    )}
  </nav>
  <div class="cockpit-view">
    <slot />
  </div>
</div>

<script>
  // Scope to each shell so multiple cockpits could coexist on a page.
  document.querySelectorAll<HTMLElement>('[data-cockpit]').forEach((shell) => {
    const btns = Array.from(shell.querySelectorAll<HTMLButtonElement>('.cockpit-toolbtn'));
    const ids = btns.map((b) => b.dataset.tool!).filter(Boolean);

    function show(id: string) {
      for (const x of ids) {
        const el = document.getElementById(x);
        if (el) el.hidden = x !== id;
      }
      btns.forEach((b) => b.setAttribute('aria-current', b.dataset.tool === id ? 'true' : 'false'));
      // A rare tool lives in the collapsed "More tools" — open it when one is selected.
      const more = shell.querySelector<HTMLDetailsElement>('.rail-more');
      if (more && btns.some((b) => b.dataset.tool === id && more.contains(b))) more.open = true;
      // Charts created while hidden have 0 size — nudge Chart.js (responsive) to refit.
      window.dispatchEvent(new Event('resize'));
    }

    btns.forEach((b) => b.addEventListener('click', () => show(b.dataset.tool!)));

    // Initial state: the tool named in the URL hash (search, team cards and the
    // registry link to `page#tool`), else the first one.
    const fromHash = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      return ids.includes(id) ? id : null;
    };
    if (ids.length) {
      const start = fromHash();
      if (start) {
        show(start);
        shell.scrollIntoView({ block: 'start' });
      } else {
        ids.forEach((x, i) => { const el = document.getElementById(x); if (el) el.hidden = i !== 0; });
      }
    }
    // Same-page links (e.g. search while already on the page) only change the hash.
    window.addEventListener('hashchange', () => {
      const id = fromHash();
      if (id) { show(id); shell.scrollIntoView({ block: 'start' }); }
    });
  });
</script>
