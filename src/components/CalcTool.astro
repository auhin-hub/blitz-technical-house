---
/**
 * Declarative calculator section. Renders the standard layout — From Master
 * (linked/green), Inputs (blue), Outputs (black), summary stat tiles, an
 * optional chart, and a Contribute-to-Master action — with the data-attributes
 * the engine (lib/calc/engine.ts) wires up. One or more per discipline page.
 */
export interface Col { prefix: string; label: string; }
export interface LinkedDef { mkey: string; label: string; sym?: string; unit: string; }
export interface InputDef { key: string; label: string; unit: string; vals: number[]; note?: string; }
export interface OutputDef { key: string; label: string; unit: string; }
export interface StatDef { key: string; label: string; unit?: string; }

interface Props {
  id: string;
  title: string;
  spec?: string;
  blurb?: string;
  cols?: Col[];
  linked?: LinkedDef[];
  seed?: Record<string, number>;
  inputs: InputDef[];
  outputs?: OutputDef[];
  stats?: StatDef[];
  chartId?: string;
  chartTitle?: string;
  chartHeight?: number;
  contribute?: boolean;
  contributeNote?: string;
}

const {
  id, title, spec, blurb,
  cols = [{ prefix: '', label: 'Value' }],
  linked = [], seed = {}, inputs, outputs = [], stats = [],
  chartId, chartTitle, chartHeight = 300,
  contribute = false, contributeNote,
} = Astro.props as Props;

const td = 'padding:0.45rem 0.6rem;';
const th = 'padding:0.5rem 0.6rem;';
const numInput = 'width:92px;text-align:right;font-family:var(--font-mono);';
const key = (prefix: string, k: string) => (prefix ? `${prefix}_${k}` : k);
---
<section id={id} class="card" style="margin-top:1.5rem;">
  <div style="display:flex;justify-content:space-between;align-items:baseline;gap:1rem;flex-wrap:wrap;">
    <h2 style="font-size:var(--fs-700);">{title}</h2>
    {spec && <span class="badge">{spec}</span>}
  </div>
  {blurb && <p style="color:var(--ink-2);margin-top:0.35rem;font-size:var(--fs-300);">{blurb}</p>}

  {linked.length > 0 && (
    <>
      <h3 style="font-size:var(--fs-500);margin-top:1.1rem;">From Master</h3>
      <div style="overflow-x:auto;">
        <table style="border-collapse:collapse;font-size:var(--fs-300);margin-top:0.4rem;">
          <tbody>
            {linked.map((l) => (
              <tr>
                <td style={td}>{l.label} {l.sym && <span class="mono" style="color:var(--ink-3);">({l.sym})</span>}</td>
                <td style={td + 'text-align:right;'}>
                  <span class="field field-linked mono" data-master={l.mkey} data-seed={seed[l.mkey]}>{seed[l.mkey]}</span>
                </td>
                <td style={td} class="mono">{l.unit}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  <h3 style="font-size:var(--fs-500);margin-top:1.25rem;">Inputs</h3>
  <div style="overflow-x:auto;">
    <table style="border-collapse:collapse;font-size:var(--fs-300);min-width:460px;margin-top:0.4rem;">
      <thead><tr style="border-bottom:1px solid var(--rule-strong);text-align:left;">
        <th style={th} class="annot">Parameter</th>
        {cols.map((c) => <th style={th + 'text-align:right;'} class="annot">{c.label}</th>)}
        <th style={th} class="annot">Unit</th>
      </tr></thead>
      <tbody>
        {inputs.map((i) => (
          <tr style="border-bottom:1px solid var(--rule);">
            <td style={td}>{i.label}{i.note && <span class="mono" style="color:var(--ink-3);"> · {i.note}</span>}</td>
            {cols.map((c, ci) => (
              <td style={td + 'text-align:right;'}>
                <input type="number" step="any" class="field field-input" style={numInput}
                  data-in={key(c.prefix, i.key)} value={i.vals[ci]} aria-label={`${i.label} ${c.label}`} />
              </td>
            ))}
            <td style={td} class="mono">{i.unit}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {outputs.length > 0 && (
    <>
      <h3 style="font-size:var(--fs-500);margin-top:1.25rem;">Outputs</h3>
      <div style="overflow-x:auto;">
        <table style="border-collapse:collapse;font-size:var(--fs-300);min-width:460px;margin-top:0.4rem;">
          <thead><tr style="border-bottom:1px solid var(--rule-strong);text-align:left;">
            <th style={th} class="annot">Result</th>
            {cols.map((c) => <th style={th + 'text-align:right;'} class="annot">{c.label}</th>)}
            <th style={th} class="annot">Unit</th>
          </tr></thead>
          <tbody>
            {outputs.map((o) => (
              <tr style="border-bottom:1px solid var(--rule);">
                <td style={td}>{o.label}</td>
                {cols.map((c) => (
                  <td style={td + 'text-align:right;'}>
                    <span class="field field-computed mono" data-out={key(c.prefix, o.key)}>—</span>
                  </td>
                ))}
                <td style={td} class="mono">{o.unit}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  {stats.length > 0 && (
    <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,210px),1fr));margin-top:1.25rem;">
      {stats.map((s) => (
        <div class="card" style="background:var(--surface-2);">
          <span class="annot">{s.label}</span>
          <p class="mono" style="font-size:var(--fs-700);margin-top:0.3rem;">
            <span data-out={s.key}>—</span>{s.unit && <span style="font-size:var(--fs-400);color:var(--ink-3);"> {s.unit}</span>}
          </p>
        </div>
      ))}
    </div>
  )}

  {chartId && (
    <>
      {chartTitle && <h3 style="font-size:var(--fs-500);margin-top:1.5rem;">{chartTitle}</h3>}
      <div style={`margin-top:0.5rem;height:${chartHeight}px;position:relative;`}><canvas id={chartId}></canvas></div>
    </>
  )}

  {contribute && (
    <>
      <h3 style="font-size:var(--fs-500);margin-top:1.5rem;">Contribute to Master</h3>
      {contributeNote && <p style="color:var(--ink-2);font-size:var(--fs-300);margin-top:0.3rem;">{contributeNote}</p>}
      <button class="btn btn-heritage" type="button" data-contribute style="margin-top:0.75rem;">Contribute results to Master</button>
      <span class="mono" data-contribute-status style="margin-left:0.6rem;font-size:var(--fs-200);color:var(--ink-3);"></span>
    </>
  )}

  <p class="mono" data-save-status style="margin-top:0.8rem;font-size:var(--fs-200);color:var(--ink-3);"></p>
</section>
