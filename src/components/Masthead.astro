---
import { url, SITE, NAV, DISCIPLINES, PROGRAMME_SUBPAGES } from '../lib/config';
import type { NavGroup, NavLink } from '../lib/config';
import ThemeToggle from './ThemeToggle.astro';
import logo from '../assets/blitz-logo.png';

// Mark the active top-nav item. `pathname` comes from Astro.url.
const { pathname = '' } = Astro.props as { pathname?: string };
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const rel = pathname.replace(base, '').replace(/^\/+|\/+$/g, ''); // '', 'tyre', ...

const isGroup = (n: NavLink | NavGroup): n is NavGroup => 'links' in n;

/** A group is "current" when the page is one of its links — or, for Teams,
 *  any tool page a team owns (so /brakes lights up Teams). */
function groupCurrent(g: NavGroup): boolean {
  if (g.links.some((l) => l.href === rel)) return true;
  if (g.label === 'Teams') return DISCIPLINES.some((d) => d.tools.some((t) => t.href?.split('#')[0] === rel));
  // Snapshots / old Validation URL are Programme pages reached from Gates / Report.
  if (g.label === 'Programme') return PROGRAMME_SUBPAGES.includes(rel);
  return false;
}
---
<header class="masthead">
  <div class="container masthead-inner">
    <a class="brand" href={url('')} aria-label={`${SITE.name} — home`}>
      <img src={logo.src} width={logo.width} height={logo.height} alt="" />
      <span class="wordmark">
        {SITE.name}
        <small>{SITE.tagline}</small>
      </span>
    </a>

    <!-- Hamburger (mobile only). Toggles the collapsible nav below. -->
    <button class="nav-toggle" id="nav-toggle" type="button"
            aria-controls="primary-nav" aria-expanded="false" aria-label="Menu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" />
      </svg>
    </button>

    <ThemeToggle />

    <div class="nav-collapse" id="primary-nav">
      <!-- Five entries: Home · Teams ▾ · Vehicle Spec · Programme ▾ · Resources ▾.
           Groups are native <details>, so they open from the keyboard with no JS;
           the script below only closes siblings / on outside click / on Esc. -->
      <nav class="nav" aria-label="Primary">
        {NAV.map((item) => isGroup(item) ? (
          <details class="nav-group" data-nav-group>
            <summary aria-current={groupCurrent(item) ? 'page' : undefined}>{item.label}</summary>
            <div class="nav-menu">
              {item.links.map((l) => (
                <a href={url(l.href)} aria-current={rel === l.href ? 'page' : undefined}>
                  <span>{l.label}</span>
                  {l.hint && <small>{l.hint}</small>}
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a href={url(item.href)} aria-current={rel === item.href ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>

      <!-- Search. The palette itself lives in Base so it is on every page; this
           is the touch-friendly way in (Ctrl/⌘-K and "/" also open it). -->
      <button class="btn btn-ghost nav-search" type="button" data-cmdk-open
        aria-label="Search pages, tools and parameters" title="Search (Ctrl/⌘ K)"
        style="font-size:var(--fs-200);display:inline-flex;gap:0.4rem;align-items:center;">
        <span aria-hidden="true">⌕</span> Search
      </button>

      <!-- Auth status: filled client-side by the auth island. -->
      <span class="nav nav-auth" data-auth-status hidden>
        <span class="mono" data-auth-email style="font-size:var(--fs-200);color:var(--ink-3)"></span>
        <button class="btn btn-ghost" type="button" data-sign-out>Sign out</button>
      </span>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('primary-nav');
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
    });
    // Close the menu after following a link (mobile).
    nav.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => { nav.classList.remove('open'); toggle.setAttribute('aria-expanded', 'false'); }));
  }

  // Dropdown groups: one open at a time; outside click or Esc closes.
  const groups = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-nav-group]'));
  groups.forEach((g) => g.addEventListener('toggle', () => {
    if (g.open) groups.forEach((o) => { if (o !== g) o.open = false; });
  }));
  document.addEventListener('click', (ev) => {
    groups.forEach((g) => { if (g.open && !g.contains(ev.target as Node)) g.open = false; });
  });
  document.addEventListener('keydown', (ev) => {
    if (ev.key !== 'Escape') return;
    const open = groups.find((g) => g.open);
    if (open) { open.open = false; open.querySelector('summary')?.focus(); }
  });
</script>
