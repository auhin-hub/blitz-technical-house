---
/**
 * Cooling Dyno Analyzer as two native cockpit tools on the Powertrain page:
 *   #cooling-data — dyno curve + pump curve tables, CSV paste, sample data, curve charts
 *   #cooling      — radiator / operating / gearing / fan / heat-load inputs, results, charts,
 *                   scenario + gear tables, Contribute to Master
 * Physics: src/lib/calc/cooling.ts (ported exactly from reference/Cooling Cacl.html).
 * Browser wiring: src/lib/calc/cooling-ui.ts. Markup only here.
 */
import { PARAM_SEED } from '../lib/master';
import { DEFAULT_INPUTS, type CoolingInputs } from '../lib/calc/cooling';

const seed = Object.fromEntries(PARAM_SEED.map((p) => [p.key, p.value]));

type Row = { key: keyof CoolingInputs; label: string; unit: string; note?: string; step?: string };
interface Group { title: string; open?: boolean; intro?: string; rows: Row[]; }

const GROUPS: Group[] = [
  { title: 'Radiator geometry', open: true, rows: [
    { key: 'coreW', label: 'Core width', unit: 'mm' },
    { key: 'coreH', label: 'Core height', unit: 'mm' },
    { key: 'coreD', label: 'Core depth', unit: 'mm' },
    { key: 'tubePitch', label: 'Tube pitch', unit: 'mm' },
    { key: 'tubeHeight', label: 'Tube height', unit: 'mm' },
    { key: 'nTubes', label: 'Number of tubes', unit: '-' },
    { key: 'finGaps', label: 'Fin gaps', unit: '-' },
    { key: 'finPitch', label: 'Fin pitch', unit: 'mm' },
    { key: 'wavePitch', label: 'Fin wave (louver) pitch', unit: 'mm', step: '0.05', note: 'Ismael et al. (2016): the fine corrugation pitch inside each fin, distinct from the fin pitch above, has a strong, independently measured effect on heat rejection.' },
  ] },
  { title: 'Operating conditions', open: true, rows: [
    { key: 'maxSafeT', label: 'Max safe coolant temperature', unit: '°C', note: 'The solver upper bound and the scenario pass/fail threshold. KTM 390 limit = 110 °C.' },
    { key: 'tAmb', label: 'Ambient temperature', unit: '°C' },
    { key: 'beta', label: 'Ram blockage β', unit: '-', step: '0.01' },
  ] },
  { title: 'Drivetrain — speed from rpm', open: true,
    intro: 'Vehicle speed is calculated from rpm, gear ratios, final drive and tyre size, and sets the ram air. The analysis runs across all gears at every rpm point. The tyre Ø and rear sprocket are used only while the linked site values above are not set.',
    rows: [
    { key: 'sprF', label: 'Front sprocket', unit: 'teeth' },
    { key: 'sprR', label: 'Rear sprocket (fallback — see links)', unit: 'teeth' },
    { key: 'tyreDia', label: 'Tyre diameter (fallback — see links)', unit: 'mm' },
    { key: 'primRed', label: 'Primary reduction', unit: '-', step: '0.001', note: 'Own input: Drivetrain & traction does not contribute its primary reduction to the shared results.' },
    { key: 'g1', label: 'Gear ratio — 1st', unit: '-', step: '0.001' },
    { key: 'g2', label: 'Gear ratio — 2nd', unit: '-', step: '0.001' },
    { key: 'g3', label: 'Gear ratio — 3rd', unit: '-', step: '0.001' },
    { key: 'g4', label: 'Gear ratio — 4th', unit: '-', step: '0.001' },
    { key: 'g5', label: 'Gear ratio — 5th', unit: '-', step: '0.001' },
    { key: 'g6', label: 'Gear ratio — 6th', unit: '-', step: '0.001', note: 'Leave a gear at 0 to drop it (KTM 390 RC stock shown).' },
  ] },
  { title: 'Fan model', open: true,
    intro: 'On/off thermostat: the fan is OFF below the trigger temperature and ON at full airflow above it (stock KTM behaviour). Fan state is solved automatically — if the no-fan steady-state temperature exceeds the trigger, the fan switches on and the system re-solves.',
    rows: [
    { key: 'fanCfm', label: 'Fan airflow (full speed)', unit: 'CFM' },
    { key: 'fanTrig', label: 'Fan trigger temperature', unit: '°C' },
  ] },
  { title: 'Heat-load assumptions', rows: [
    { key: 'eta', label: 'Thermal efficiency', unit: '%', note: 'Q = P_brake × (1/η − 1) × f_coolant' },
    { key: 'fc', label: 'Heat to coolant', unit: '%' },
  ] },
];

const STATS = [
  { key: 'tout', label: 'Steady-state T_out (peak rpm, top gear)', unit: '°C' },
  { key: 'margin', label: 'Margin below 110 °C', unit: '°C' },
  { key: 'qRejected', label: 'Q rejected', unit: 'kW' },
  { key: 'qPeak', label: 'Peak engine Q load', unit: 'kW' },
  { key: 'UA', label: 'Overall conductance UA', unit: 'W/K' },
  { key: 'epsPct', label: 'Effectiveness', unit: '%' },
];
const MINI = [
  { key: 'ntu', label: 'NTU', unit: '-' },
  { key: 'ha', label: 'h_air', unit: 'W/m²K' },
  { key: 'Re', label: 'Reynolds number', unit: '-' },
  { key: 'regime', label: 'Flow regime', unit: '' },
  { key: 'pumpLPM', label: 'Pump flow @ peak rpm', unit: 'L/min' },
  { key: 'fanState', label: 'Fan state', unit: '' },
];
---

<!-- ===================== Cooling — dyno & pump data ===================== -->
<section id="cooling-data" class="ct">
  <header class="ct-head"><h2>Cooling — dyno &amp; pump data</h2><span class="badge">BRIEF §E2</span></header>
  <p class="ct-sub">
    Measured engine dyno curve (rpm, brake power, torque) and the coolant pump's flow-vs-rpm curve, shared by
    the whole team. They feed <a href="#cooling">Cooling — radiator analysis</a>. Last save wins if two people
    edit at once.
  </p>

  <div class="ct-body">
    <div class="ct-col">
      <h3 class="ct-h3">Dyno curve</h3>
      <div class="cool-tabs" role="tablist" aria-label="Dyno data entry">
        <button type="button" role="tab" class="cool-tab" data-cool-tab="manual" aria-selected="true">Manual</button>
        <button type="button" role="tab" class="cool-tab" data-cool-tab="paste" aria-selected="false">Paste CSV</button>
        <button type="button" role="tab" class="cool-tab" data-cool-tab="sample" aria-selected="false">Sample</button>
      </div>

      <div data-cool-panel="manual">
        <p class="ct-sub">Enter rpm, brake power (kW) and torque (N·m, optional). At least 2 points are needed.</p>
        <div class="cool-add">
          <label>rpm<input type="number" class="field field-input" id="cd-rpm" placeholder="9000" min="500" max="15000" /></label>
          <label>Power kW<input type="number" class="field field-input" id="cd-pow" placeholder="32.0" step="0.1" /></label>
          <label>Torque N·m<input type="number" class="field field-input" id="cd-trq" placeholder="optional" step="0.1" /></label>
          <button type="button" class="btn btn-ghost" id="cd-add">+ Add</button>
        </div>
        <div class="ct-wrap cool-scroll">
          <table class="ct-table">
            <thead><tr><th>#</th><th class="ct-num">rpm</th><th class="ct-num">Power (kW)</th><th class="ct-num">Torque (N·m)</th><th><span class="sr-only">Delete</span></th></tr></thead>
            <tbody id="cd-body"></tbody>
          </table>
        </div>
        <p style="margin-top:0.6rem;display:flex;gap:0.5rem;flex-wrap:wrap;">
          <button type="button" class="btn btn-ghost" id="cd-sort" style="font-size:var(--fs-200);">Sort by rpm</button>
          <button type="button" class="btn btn-ghost" id="cd-clear" style="font-size:var(--fs-200);">Clear all</button>
        </p>
      </div>

      <div data-cool-panel="paste" hidden>
        <p class="ct-sub">One row per line: <em>rpm, power_kW, torque_Nm</em>. The torque column is optional.</p>
        <textarea id="cd-csv" class="field field-input" rows="7" style="width:100%;font-family:var(--font-mono);" aria-label="Dyno CSV"
          placeholder={'5000, 16.5, 31.5\n7000, 24.9, 33.9\n9000, 31.2, 33.1\n11000, 29.5, 25.6'}></textarea>
        <p style="margin-top:0.5rem;"><button type="button" class="btn btn-halftone" id="cd-parse">Parse &amp; load</button>
          <span class="mono" id="cd-csv-msg" style="margin-left:0.5rem;font-size:var(--fs-200);" role="status"></span></p>
      </div>

      <div data-cool-panel="sample" hidden>
        <p class="ct-sub">A typical KTM 390 RC dyno curve: 13 points from 2 000 to 11 500 rpm (the original tool's sample, peak 32 kW at 9 500 rpm). Loading it replaces the table — edit as needed.</p>
        <p><button type="button" class="btn btn-halftone" id="cd-sample">Load KTM 390 RC curve</button></p>
      </div>
    </div>

    <div class="ct-col">
      <h3 class="ct-h3">Power &amp; torque curve</h3>
      <div class="ct-chart" style="height:230px;"><canvas id="ch-dyno" role="img" aria-label="Dyno power and torque against rpm"></canvas></div>

      <h3 class="ct-h3">Pump curve — flow vs rpm</h3>
      <p class="ct-sub">Coolant flow at each engine rpm (linear interpolation between rows). The default is the standard KTM 390 estimate; edit or add rows for another engine or pump.</p>
      <div class="cool-add">
        <label>rpm<input type="number" class="field field-input" id="cp-rpm" placeholder="7000" min="500" max="15000" /></label>
        <label>Flow L/min<input type="number" class="field field-input" id="cp-lpm" placeholder="28.0" step="0.5" min="1" /></label>
        <button type="button" class="btn btn-ghost" id="cp-add">+ Add</button>
      </div>
      <div class="ct-wrap cool-scroll" style="max-height:200px;">
        <table class="ct-table">
          <thead><tr><th>#</th><th class="ct-num">rpm</th><th class="ct-num">Flow (L/min)</th><th><span class="sr-only">Delete</span></th></tr></thead>
          <tbody id="cp-body"></tbody>
        </table>
      </div>
      <p style="margin-top:0.6rem;display:flex;gap:0.5rem;flex-wrap:wrap;">
        <button type="button" class="btn btn-ghost" id="cp-sort" style="font-size:var(--fs-200);">Sort by rpm</button>
        <button type="button" class="btn btn-ghost" id="cp-reset" style="font-size:var(--fs-200);">Reset to KTM 390</button>
        <button type="button" class="btn btn-ghost" id="cp-clear" style="font-size:var(--fs-200);">Clear</button>
      </p>
      <div class="ct-chart" style="height:200px;"><canvas id="ch-pump" role="img" aria-label="Pump flow against rpm"></canvas></div>
    </div>
  </div>
  <p class="ct-foot"><span data-cool-data-status role="status"></span></p>
</section>

<!-- ===================== Cooling — radiator analysis ===================== -->
<section id="cooling" class="ct">
  <header class="ct-head"><h2>Cooling — radiator analysis</h2><span class="badge">BRIEF §E2</span></header>
  <p class="ct-sub">
    Engine heat load from the dyno data → radiator performance by the NTU–effectiveness method, solved to the
    steady-state coolant temperature where heat rejected = heat produced, for every gear and rpm. Physics ported
    unchanged from the original Dyno Thermal Analyzer; it recalculates live as you edit.
  </p>
  <p class="cool-msg" data-cool-msg role="status"></p>

  <div class="ct-body">
    <!-- LEFT: links + inputs -->
    <div class="ct-col">
      <h3 class="ct-h3">From the rest of the site</h3>
      <div class="ct-wrap">
        <table class="ct-table"><tbody>
          <tr>
            <td>Loaded rolling radius <span class="ct-unit">(Vehicle Spec)</span></td>
            <td class="ct-num"><span class="field field-linked mono" data-master="rolling_radius" data-seed={seed.rolling_radius ?? ''}>{seed.rolling_radius ?? '—'}</span></td>
            <td class="ct-unit">mm</td>
          </tr>
          <tr>
            <td>Final drive ratio <span class="ct-unit">(Drivetrain &amp; traction)</span></td>
            <td class="ct-num"><span class="field field-linked mono" data-output="final_drive" data-output-hint="press Contribute in Drivetrain & traction">—</span></td>
            <td class="ct-unit">-</td>
          </tr>
          <tr>
            <td>Engine peak power <span class="ct-unit">(Drivetrain &amp; traction — cross-check only)</span></td>
            <td class="ct-num"><span class="field field-linked mono" data-output="engine_peak_power" data-output-hint="press Contribute in Drivetrain & traction">—</span></td>
            <td class="ct-unit">kW</td>
          </tr>
        </tbody></table>
      </div>
      <p class="ct-sub">
        Tyre Ø used = 2 × the Vehicle Spec rolling radius when it is set, else the tyre diameter below. Final
        drive used = the Drivetrain &amp; traction result when contributed, else rear ÷ front sprocket. The dyno peak
        is measured data and is only compared with the engine peak power, never overwritten by it.
      </p>
      <div class="ct-wrap">
        <table class="ct-table"><tbody>
          <tr><td>Tyre Ø used</td><td class="ct-num"><span class="field field-computed mono" data-out="tyreUsed">—</span></td><td class="ct-unit">mm</td><td class="ct-unit" data-out="tyreSrc"></td></tr>
          <tr><td>Final drive used</td><td class="ct-num"><span class="field field-computed mono" data-out="fdUsed">—</span></td><td class="ct-unit">-</td><td class="ct-unit" data-out="fdSrc"></td></tr>
          <tr><td>Dyno peak vs engine peak power</td><td class="ct-num" colspan="3"><span class="mono" data-out="peakNote">—</span></td></tr>
        </tbody></table>
      </div>

      {GROUPS.map((g) => (
        <details class="cool-group" open={g.open}>
          <summary>{g.title}</summary>
          {g.intro && <p class="ct-sub">{g.intro}</p>}
          <div class="ct-wrap">
            <table class="ct-table"><tbody>
              {g.rows.map((r) => (
                <tr>
                  <td>{r.label}{r.note && <span class="ct-unit"> · {r.note}</span>}</td>
                  <td class="ct-num"><input type="number" step={r.step ?? 'any'} class="field field-input ct-input" data-in={r.key} value={DEFAULT_INPUTS[r.key]} aria-label={r.label} /></td>
                  <td class="ct-unit">{r.unit}</td>
                </tr>
              ))}
              {g.title === 'Radiator geometry' && (
                <tr>
                  <td>Apply literature correction to h_air <span class="ct-unit"> · h_air × (wave pitch ÷ 2.5)<sup>−0.63</sup>, fit R² = 0.89 to Tables 1–5 of Ismael, Yun &amp; Ulugbek (2016), J. Electronics Cooling &amp; Thermal Control 6, 88–96</span></td>
                  <td class="ct-num"><select class="field field-input" data-in="litCorr" aria-label="Apply literature correction"><option value="0" selected>Off</option><option value="1">On</option></select></td>
                  <td class="ct-unit"></td>
                </tr>
              )}
            </tbody></table>
          </div>
        </details>
      ))}
    </div>

    <!-- RIGHT: results -->
    <div class="ct-col">
      <div class="ct-stats">
        {STATS.map((s) => (
          <div class="ct-stat">
            <span class="annot">{s.label}</span>
            <div class="val"><span data-out={s.key}>—</span><span class="ct-unit" style="font-size:var(--fs-400)"> {s.unit}</span></div>
          </div>
        ))}
        <div class="ct-stat">
          <span class="annot">Verdict (peak rpm, top gear)</span>
          <div class="val" style="font-size:var(--fs-500);"><span data-out="verdict">—</span></div>
          <span class="ct-ref" data-out="verdictNote"></span>
        </div>
      </div>

      <div class="ct-wrap" style="margin-top:0.6rem;">
        <table class="ct-table">
          <thead><tr><th>At peak rpm, top gear</th><th class="ct-num">Value</th><th>Unit</th></tr></thead>
          <tbody>
            {MINI.map((m) => (
              <tr><td>{m.label}</td><td class="ct-num"><span class="field field-computed mono" data-out={m.key}>—</span></td><td class="ct-unit">{m.unit}</td></tr>
            ))}
            <tr><td>Radiator core frontal area (as modelled)</td><td class="ct-num"><span class="field field-computed mono" data-out="coreArea">—</span></td><td class="ct-unit">m²</td></tr>
          </tbody>
        </table>
      </div>
      <p class="ct-sub" data-out="litNote"></p>

      <h3 class="ct-h3">Steady-state T_out vs rpm (top gear)</h3>
      <div class="ct-chart" style="height:250px;"><canvas id="ch-heat" role="img" aria-label="Steady-state coolant outlet temperature against rpm in top gear"></canvas></div>
      <h3 class="ct-h3">Steady-state T_out vs vehicle speed (peak engine load)</h3>
      <div class="ct-chart" style="height:250px;"><canvas id="ch-tout" role="img" aria-label="Steady-state coolant outlet temperature against vehicle speed at peak load"></canvas></div>
      <h3 class="ct-h3">Radiator heat rejected vs vehicle speed</h3>
      <div class="ct-chart" style="height:250px;"><canvas id="ch-qrad" role="img" aria-label="Radiator heat rejected against vehicle speed compared with engine heat loads"></canvas></div>
      <h3 class="ct-h3">Steady-state T_out vs rpm — all gears</h3>
      <div class="ct-chart" style="height:280px;"><canvas id="ch-gears" role="img" aria-label="Steady-state coolant outlet temperature against rpm for every gear"></canvas></div>

      <h3 class="ct-h3">Contribute to Master</h3>
      <p class="ct-sub">
        Writes the radiator heat rejection (kW) and modelled core frontal area (m²), plus the peak-rpm / top-gear
        coolant outlet temperature and margin, to the shared results (they appear in the Design report and the
        Readiness picker).
      </p>
      <p style="margin-top:0.5rem;">
        <button class="btn btn-heritage" type="button" data-contribute>Contribute results to Master</button>
        <span class="mono" data-contribute-status style="margin-left:0.6rem;font-size:var(--fs-200);color:var(--ink-3);"></span>
      </p>
    </div>
  </div>

  <h3 class="ct-h3">Speed at peak rpm — by gear</h3>
  <div class="ct-wrap">
    <table class="ct-table">
      <thead><tr><th>Gear</th><th class="ct-num">Ratio</th><th class="ct-num">Speed at peak rpm</th><th class="ct-num">T_out at peak rpm</th><th class="ct-num">Pump flow</th><th>Fan</th><th>Result</th></tr></thead>
      <tbody data-cool-gears></tbody>
    </table>
  </div>

  <h3 class="ct-h3">EDR scenario validation</h3>
  <div class="ct-wrap">
    <table class="ct-table">
      <thead><tr><th>Scenario</th><th class="ct-num">Engine Q (kW)</th><th class="ct-num">Q_rad (kW)</th><th class="ct-num">Pump flow</th><th>Fan</th><th class="ct-num">T_out (°C)</th><th class="ct-num">Margin (°C)</th><th>Verdict</th></tr></thead>
      <tbody data-cool-scens></tbody>
    </table>
  </div>
  <p class="ct-sub" data-cool-foot>
    T_out values are solved steady-state temperatures where Q_rad equals Q_engine at each operating point (bisection,
    tolerance 0.5 W): the equilibrium the system would reach if held at constant speed and rpm. At 0 km/h with the
    fan off there is no air flow and the model is undefined (a gap in the speed chart) — as in the original.
  </p>

  <p class="ct-foot"><span data-save-status></span></p>
</section>

<style is:global>
  .cool-tabs { display: flex; gap: 0.25rem; border-bottom: 1px solid var(--rule); margin: 0.4rem 0 0.7rem; }
  .cool-tab { font-family: var(--font-mono); font-size: var(--fs-200); padding: 0.4em 0.8em; background: transparent; border: 1px solid transparent; border-bottom: 2px solid transparent; color: var(--ink-2); cursor: pointer; border-radius: var(--radius) var(--radius) 0 0; }
  .cool-tab[aria-selected='true'] { color: var(--ink); border-bottom-color: var(--amber); background: var(--surface-2); }
  .cool-tab:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }
  .cool-add { display: grid; grid-template-columns: repeat(auto-fit, minmax(90px, 1fr)) auto; gap: 0.5rem; align-items: end; margin-bottom: 0.6rem; }
  .cool-add label { display: flex; flex-direction: column; gap: 0.2rem; font-size: var(--fs-200); color: var(--ink-2); }
  .cool-add input { width: 100%; font-family: var(--font-mono); }
  .cool-scroll { max-height: 260px; overflow-y: auto; }
  .cool-scroll input { width: 84px; text-align: right; font-family: var(--font-mono); }
  .cool-del { background: none; border: 0; color: var(--heritage); cursor: pointer; font-size: 1.2rem; line-height: 1; padding: 0.1rem 0.4rem; border-radius: var(--radius-sm); }
  .cool-del:focus-visible { outline: 2px solid var(--amber); }
  .cool-group { margin-top: 0.9rem; border-top: 1px solid var(--rule); padding-top: 0.5rem; }
  .cool-group > summary { cursor: pointer; font-weight: 600; font-size: var(--fs-300); }
  .cool-msg { color: var(--amber-text); font-size: var(--fs-300); margin: 0.3rem 0 0; }
  .cool-msg:empty { display: none; }
  .cool-pass { color: var(--state-linked); font-weight: 700; }
  .cool-warn { color: var(--amber-text); font-weight: 700; }
  .cool-fail { color: var(--heritage); font-weight: 700; }
  [data-cool-gears] td:first-child, [data-cool-scens] td:first-child { white-space: nowrap; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
