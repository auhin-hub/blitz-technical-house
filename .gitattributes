# Normalise line endings: store text as LF in the repo, check out native locally.
* text=auto

# Always LF (tooling / CI reads these):
*.astro   text eol=lf
*.mjs     text eol=lf
*.js      text eol=lf
*.ts      text eol=lf
*.css     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.sql     text eol=lf

# Binary assets — never touch:
*.png     binary
*.jpg     binary
*.ico     binary
*.xlsx    binary
*.rar     binary
*.zip     binary
